<%- include('partials/head', { title: 'Abstract guidelines' }) %>

<section class="band-navy page-head">
  <div class="wrap">
    <h1>Abstract guidelines</h1>
    <p>How to submit a paper or a poster to <%= conf.acronym || 'NQOCN 2026' %>, how they are reviewed, and how they are presented.</p>
    <% if (abstract.deadline) { %><p class="chip" style="background: rgba(255,255,255,0.12); color: #fff"><%= abstract.open ? `Submissions open until ${abstract.deadlineText}` : `Submission closed on ${abstract.deadlineText}` %></p><% } %>
  </div>
</section>

<section>
  <div class="wrap section split">
    <div class="stack" style="gap: 32px">
      <% content.abstracts.sections.forEach((sec) => { %>
        <div class="stack" style="gap: 12px">
          <div class="group-head"><div class="petals short" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div><h2><%= sec.title %></h2></div>
          <ul style="margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; color: var(--text); max-width: 68ch">
            <% sec.items.forEach((it) => { %><li><%= it %></li><% }) %>
          </ul>
        </div>
      <% }) %>
      <% if (abstract.open) { %><a class="btn btn-navy" href="/" style="align-self: flex-start">Submit in the portal</a><% } else { %>
        <p class="lead">Already submitted? Add every co-author, in order, from the Abstract card in the <a href="/">portal</a>.</p>
      <% } %>
    </div>
    <aside class="stack" style="gap: 16px">
      <div class="card card-gold">
        <p class="kicker">Sample structured abstract</p>
        <h2 style="font-size: 20px">Quality improvement in Kangaroo Mother Care: learning from a teaching hospital</h2>
        <p class="lead" style="font-size: 16px">A model of the format: title, category, authors, institution, then Background, Aim, Methods, Results and Conclusions in 316 words.</p>
        <a class="btn btn-outline" href="/website/sample-abstract" style="align-self: flex-start">Read the sample abstract</a>
      </div>
      <div class="facts">
        <% content.abstracts.rules.forEach(([b, s]) => { %><div class="fact"><b><%= b %></b><span><%= s %></span></div><% }) %>
      </div>
    </aside>
  </div>
</section>

<%- include('partials/foot') %>
