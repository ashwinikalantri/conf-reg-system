<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= locals.title ? `${locals.title} · ` : '' %><%= conf.acronym || 'NQOCN 2026' %></title>
<meta name="description" content="<%= conf.name %>, <%= conf.dates %>, <%= content.venue.name %>. <%= content.theme %>.">
<meta property="og:title" content="<%= conf.name %>">
<meta property="og:description" content="<%= conf.dates %> · <%= content.venue.name %> · <%= content.theme %>">
<meta property="og:type" content="website">
<meta property="og:image" content="<%= assets %>/img/nqocn-mgims-logo.png">
<link rel="icon" href="/favicon.ico?v=mgims" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=mgims">
<link rel="apple-touch-icon" href="/favicon-180.png?v=mgims">
<% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= assets %>/site.css?v=<%= cssVersion %>">
<% if (typeof extraHead !== 'undefined') { %><%- extraHead %><% } %>
</head>
<body>
<a class="skip" href="#main">Skip to the content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="<%= home %>" aria-label="<%= conf.acronym || 'NQOCN 2026' %> home"><img src="<%= assets %>/img/nqocn-mgims-logo.png" alt="NQOCN, Nationwide Quality of Care Network, with MGIMS Sevagram" width="1021" height="203"></a>
    <nav class="nav" aria-label="Main">
      <% menu.forEach((m, mi) => { if (m.items) { const here = m.items.some(([k]) => k === page); %>
        <details class="dd">
          <summary<% if (here) { %> class="here"<% } %>><%= m.label %><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
          <div class="dd-panel">
            <% m.items.forEach(([key, label, note]) => { %><a href="<%= base %>/<%= key %>"<% if (page === key) { %> aria-current="page"<% } %>><b><%= label %></b><span><%= note %></span></a><% }) %>
          </div>
        </details>
      <% } else { %>
        <a class="top" href="<%= base %>/<%= m.key %>"<% if (page === m.key) { %> aria-current="page"<% } %>><%= m.label %></a>
      <% } }) %>
    </nav>
    <div class="header-actions">
      <a class="signin" href="<%= portal %>">Sign in</a>
      <% if (!conf.over && conf.registrationOpen) { %><a class="btn btn-navy register" href="<%= portal %>#register">Register</a><% } %>
      <!-- Signed in to the portal: their button instead (filled in by the
           script below, from /api/auth/whoami). It opens the same account
           menu the delegate portal and the admin panel have: "Go to" the
           other places -- the admin panel for those who may open it -- and
           Log out. -->
      <details class="me-menu" id="site-me">
        <summary class="me" aria-label="Your account: the delegate portal, log out"><span class="me-initials" id="site-me-initials" aria-hidden="true"></span><span class="me-name" id="site-me-name"></span><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
        <div class="me-panel">
          <p class="menu-group first">Go to</p>
          <a href="<%= portal %>"><b>Delegate portal</b><span>Your registration, badge and abstract</span></a>
          <a id="site-me-admin" href="/admin" hidden><b>Admin panel</b><span>For organisers and volunteers</span></a>
          <hr>
          <button type="button" id="site-me-logout"><b>Log out</b></button>
        </div>
      </details>
      <details class="menu">
        <summary aria-label="Menu"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></summary>
        <nav class="menu-panel" aria-label="Main">
          <a href="<%= home %>"<% if (page === '') { %> aria-current="page"<% } %>>Home</a>
          <% menu.forEach((m) => { if (m.items) { %>
            <p class="menu-group"><%= m.label %></p>
            <% m.items.forEach(([key, label]) => { %><a href="<%= base %>/<%= key %>"<% if (page === key) { %> aria-current="page"<% } %>><%= label %></a><% }) %>
          <% } }) %>
          <hr>
          <% menu.filter((m) => !m.items).forEach((m) => { %><a href="<%= base %>/<%= m.key %>"<% if (page === m.key) { %> aria-current="page"<% } %>><%= m.label %></a><% }) %>
          <!-- Signed out only: signed in, their button beside this one has it. -->
          <p class="menu-group menu-go">Go to</p>
          <a class="menu-go" href="<%= portal %>">Delegate portal<span>Sign in</span></a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
// Signed in to the portal? Then their button, not Sign in and Register. The
// pages are cached for everyone, so this asks the browser's own session; the
// last answer, kept on this device, paints first so the header does not jump.
(function () {
  var root = document.documentElement;
  var KEYS = ['nqocn-signed-in', 'nqocn-signed-in-admin'];
  function show(name, admin) {
    var words = String(name || '').replace(/^\s*(dr|prof|mr|mrs|ms|miss|shri|smt)\.?\s+/i, '').trim().split(/\s+/).filter(Boolean);
    var initials = words.length ? (words[0][0] + (words.length > 1 ? words[words.length - 1][0] : '')).toUpperCase() : '';
    document.getElementById('site-me-initials').textContent = initials;
    document.getElementById('site-me-name').textContent = (name || '').trim() || 'Your account';
    document.getElementById('site-me-admin').hidden = !admin;
    root.classList.add('signed-in');
  }
  function hide() {
    root.classList.remove('signed-in');
    document.getElementById('site-me').open = false;
  }
  function forget(keys) { try { keys.forEach(function (k) { localStorage.removeItem(k); }); } catch (e) {} }
  var kept = null;
  var keptAdmin = false;
  try { kept = localStorage.getItem(KEYS[0]); keptAdmin = !!localStorage.getItem(KEYS[1]); } catch (e) {}
  if (kept) show(kept, keptAdmin);
  if (!window.fetch) return;
  fetch('/api/auth/whoami', { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (who) {
    if (who && who.signedIn) {
      show(who.name, who.admin);
      try {
        localStorage.setItem(KEYS[0], who.name || ' ');
        if (who.admin) localStorage.setItem(KEYS[1], '1'); else localStorage.removeItem(KEYS[1]);
      } catch (e) {}
    } else {
      hide();
      forget(KEYS);
    }
  }).catch(function () {});
  // Log out, from here: the session ends, and with it what this device kept
  // for the header and for the portal's first paint (nqocn_current_user).
  document.getElementById('site-me-logout').addEventListener('click', function () {
    var done = function () { forget(KEYS.concat('nqocn_current_user')); hide(); };
    fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' }).then(done, done);
  });
})();
(function () {
  var dds = Array.prototype.slice.call(document.querySelectorAll('details.dd, details.menu, details.me-menu'));
  dds.forEach(function (d) { d.addEventListener('toggle', function () { if (d.open) dds.forEach(function (o) { if (o !== d) o.open = false; }); }); });
  document.addEventListener('click', function (e) { dds.forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') dds.forEach(function (d) { if (d.open) { d.open = false; var s = d.querySelector('summary'); if (s) s.focus(); } }); });
})();
</script>
<main id="main">
