<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= locals.title ? `${locals.title} · ` : '' %><%= conf.acronym || 'NQOCN 2026' %></title>
<meta name="description" content="<%= conf.name %>, <%= conf.dates %>, <%= content.venue.name %>. <%= content.theme %>.">
<meta property="og:title" content="<%= conf.name %>">
<meta property="og:description" content="<%= conf.dates %> · <%= content.venue.name %> · <%= content.theme %>">
<meta property="og:type" content="website">
<meta property="og:image" content="<%= assets %>/img/nqocn-mgims-logo.png">
<link rel="icon" href="<%= assets %>/img/nqocn-mgims-logo.png">
<% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= assets %>/site.css?v=<%= cssVersion %>">
<% if (typeof extraHead !== 'undefined') { %><%- extraHead %><% } %>
</head>
<body>
<a class="skip" href="#main">Skip to the content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="<%= home %>" aria-label="<%= conf.acronym || 'NQOCN 2026' %> home"><img src="<%= assets %>/img/nqocn-mgims-logo.png" alt="NQOCN, Nationwide Quality of Care Network, with MGIMS Sevagram" width="1021" height="203"></a>
    <nav class="nav" aria-label="Main">
      <% menu.forEach((m, mi) => { if (m.items) { const here = m.items.some(([k]) => k === page); %>
        <details class="dd">
          <summary<% if (here) { %> class="here"<% } %>><%= m.label %><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
          <div class="dd-panel">
            <% m.items.forEach(([key, label, note]) => { %><a href="<%= base %>/<%= key %>"<% if (page === key) { %> aria-current="page"<% } %>><b><%= label %></b><span><%= note %></span></a><% }) %>
          </div>
        </details>
      <% } else { %>
        <a class="top" href="<%= base %>/<%= m.key %>"<% if (page === m.key) { %> aria-current="page"<% } %>><%= m.label %></a>
      <% } }) %>
    </nav>
    <div class="header-actions">
      <a class="signin" href="<%= portal %>">Sign in</a>
      <a class="btn btn-navy register" href="<%= portal %>">Register</a>
      <!-- Signed in to the portal: their button instead, to the portal
           (filled in by the script below, from /api/auth/whoami). -->
      <a class="me" id="site-me" href="<%= portal %>" aria-label="Your delegate portal"><span class="me-initials" id="site-me-initials" aria-hidden="true"></span><span class="me-name" id="site-me-name"></span></a>
      <details class="menu">
        <summary aria-label="Menu"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></summary>
        <nav class="menu-panel" aria-label="Main">
          <a href="<%= home %>"<% if (page === '') { %> aria-current="page"<% } %>>Home</a>
          <% menu.forEach((m) => { if (m.items) { %>
            <p class="menu-group"><%= m.label %></p>
            <% m.items.forEach(([key, label]) => { %><a href="<%= base %>/<%= key %>"<% if (page === key) { %> aria-current="page"<% } %>><%= label %></a><% }) %>
          <% } }) %>
          <hr>
          <% menu.filter((m) => !m.items).forEach((m) => { %><a href="<%= base %>/<%= m.key %>"<% if (page === m.key) { %> aria-current="page"<% } %>><%= m.label %></a><% }) %>
          <p class="menu-group">Go to</p>
          <a class="menu-go" href="<%= portal %>">Delegate portal<span id="site-menu-me">Sign in</span></a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
// Signed in to the portal? Then their button, not Sign in and Register. The
// pages are cached for everyone, so this asks the browser's own session; the
// last answer, kept on this device, paints first so the header does not jump.
(function () {
  var root = document.documentElement;
  function show(name) {
    var words = String(name || '').replace(/^\s*(dr|prof|mr|mrs|ms|miss|shri|smt)\.?\s+/i, '').trim().split(/\s+/).filter(Boolean);
    var initials = words.length ? (words[0][0] + (words.length > 1 ? words[words.length - 1][0] : '')).toUpperCase() : '';
    document.getElementById('site-me-initials').textContent = initials;
    document.getElementById('site-me-name').textContent = name || 'Delegate portal';
    document.getElementById('site-menu-me').textContent = name || 'Signed in';
    root.classList.add('signed-in');
  }
  function hide() {
    root.classList.remove('signed-in');
    document.getElementById('site-menu-me').textContent = 'Sign in';
  }
  var kept = null;
  try { kept = localStorage.getItem('nqocn-signed-in'); } catch (e) {}
  if (kept) show(kept);
  if (!window.fetch) return;
  fetch('/api/auth/whoami', { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (who) {
    if (who && who.signedIn) {
      show(who.name);
      try { localStorage.setItem('nqocn-signed-in', who.name || ' '); } catch (e) {}
    } else {
      hide();
      try { localStorage.removeItem('nqocn-signed-in'); } catch (e) {}
    }
  }).catch(function () {});
})();
(function () {
  var dds = Array.prototype.slice.call(document.querySelectorAll('details.dd, details.menu'));
  dds.forEach(function (d) { d.addEventListener('toggle', function () { if (d.open) dds.forEach(function (o) { if (o !== d) o.open = false; }); }); });
  document.addEventListener('click', function (e) { dds.forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') dds.forEach(function (d) { if (d.open) { d.open = false; var s = d.querySelector('summary'); if (s) s.focus(); } }); });
})();
</script>
<main id="main">
