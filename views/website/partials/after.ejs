<%# After the conference (owner, 22 Nov 2026; mockup approved): the name and thanks, the
    delegate's own certificates (For you), the conference in figures, the
    Oration, the best papers once the organisers show them, and what each
    day held. From website.js afterConference(). %>
<section class="band-navy hero">
  <div class="wrap">
    <div class="hero-main">
      <p class="kicker"><%= conf.acronym || 'NQOCN 2026' %> · <%= conf.location || 'Sevagram, Wardha' %></p>
      <%# The conference's name stays at the top (owner, 23 Nov 2026), the thanks beneath it. %>
      <h1><%= conf.name %></h1>
      <p class="theme"><%= content.theme %></p>
      <p class="thanks">Thank you for making <%= conf.acronym || 'NQOCN 2026' %> a success.</p>
      <p class="hosts">Two days with nurses, doctors, students and frontline workers, hosted by the <%= content.host %> and co-hosted by the <%= content.coHost %>.</p>
      <div class="hero-actions">
        <a class="btn btn-gold" href="<%= portal %>">Download your certificate</a>
        <a class="btn btn-ghost" href="<%= base %>/programme">See the programme</a>
      </div>
    </div>
    <div class="date-card" aria-label="When and where">
      <% const dm = /^(\d+)(?:–(\d+))? (\w+) (\d{4})$/.exec(conf.dates || ''); %>
      <% if (dm) { %>
        <p class="big"><%= dm[2] ? `${dm[1]}–${dm[2]}` : dm[1] %></p>
        <p class="month"><%= ({ Jan: 'January', Feb: 'February', Mar: 'March', Apr: 'April', May: 'May', Jun: 'June', Jul: 'July', Aug: 'August', Sep: 'September', Oct: 'October', Nov: 'November', Dec: 'December' })[dm[3]] || dm[3] %> <%= dm[4] %></p>
      <% } else { %>
        <p class="month"><%= conf.dates %></p>
      <% } %>
      <div class="petals" style="width: 100%" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <p class="where">MGIMS, <%= content.venue.address.replace(/\s*\d{6}$/, '') %></p>
    </div>
  </div>
</section>
<%- include('foryou') %>

<% if (after.stats.length) { %>
<section aria-labelledby="numbers-h">
  <div class="wrap section stack" style="gap: 28px">
    <div class="stack" style="gap: 12px">
      <div class="petals" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <h2 id="numbers-h" class="h2"><%= conf.acronym || 'NQOCN 2026' %> in numbers</h2>
    </div>
    <div class="stats">
      <% after.stats.forEach((s) => { %><div class="stat"><p class="n"><%= s.n %></p><p class="l"><%= s.label %></p></div><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (oration) { %>
<section>
  <div class="wrap" style="padding-bottom: 56px">
    <article class="card card-gold oration-card">
      <p class="kicker">NQOCN Oration · <%= oration.when.replace(/,.*$/, '') %></p>
      <h2 class="oration-title"><%= oration.title.replace(/^NQOCN Oration:\s*/i, '') %></h2>
      <% if (oration.speakers) { %><p style="font-size: 21px; font-weight: 600"><%= oration.speakers %></p><% } %>
    </article>
  </div>
</section>
<% } %>

<% if (after.winners.length) { %>
<section class="band-tint" aria-labelledby="best-h">
  <div class="wrap section stack" style="gap: 28px">
    <div class="stack" style="gap: 8px">
      <h2 id="best-h" class="h2">Best papers</h2>
      <p class="lead">Chosen by the judges from the oral, e-poster and award presentations.</p>
    </div>
    <div class="grid grid-3">
      <% after.winners.forEach((k) => { %>
      <article class="card" style="gap: 16px">
        <h3><%= k.label %></h3>
        <ol class="places">
          <% k.places.forEach((p) => { %>
          <li><span class="rank rank-<%= p.rank %>" aria-label="Place <%= p.rank %>"><%= p.rank %></span>
            <div><p class="who"><%= p.name %></p><p class="what"><%= [p.institution, `“${p.title}”`].filter(Boolean).join(' · ') %></p></div></li>
          <% }) %>
        </ol>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section aria-labelledby="happened-h">
  <div class="wrap section stack" style="gap: 28px">
    <h2 id="happened-h" class="h2">What happened</h2>
    <div class="grid grid-2">
      <% after.days.forEach((day) => { %>
      <article class="card" style="padding: 28px; gap: 12px">
        <p class="kicker"><%= day.kicker %></p>
        <h3 style="font-size: 25px"><%= day.title %></h3>
        <% if (day.text) { %><p class="lead"><%= day.text %></p><% } %>
        <% if (day.list) { %><ul class="happened"><% day.list.forEach((x) => { %><li><%= x %></li><% }) %></ul><% } %>
        <a class="arrow-link" href="<%= base %>/<%= day.link %>" style="margin-top: auto; padding-top: 6px"><%= day.linkText %> →</a>
      </article>
      <% }) %>
    </div>
  </div>
</section>
