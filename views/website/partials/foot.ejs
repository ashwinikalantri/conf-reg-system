</main>
<footer class="site-footer">
  <div class="wrap cols">
    <div class="stack" style="gap: 8px">
      <b style="font-family: var(--display); font-size: 20px"><%= conf.acronym || 'NQOCN 2026' %></b>
      <%# The address's first part is often already in the venue's name ("…, Sevagram" then "Sevagram, Wardha…"): said once. %>
      <% const addrParts = content.venue.address.split(/,\s*/); const addr = content.venue.name.toLowerCase().endsWith(addrParts[0].toLowerCase()) ? addrParts.slice(1).join(', ') : content.venue.address; %>
      <p><%= conf.dates %><br><%= content.venue.name %>, <%= addr %></p>
    </div>
    <nav class="links" aria-label="Footer">
      <a href="<%= base %>/programme">Programme</a>
      <a href="<%= base %>/workshops">Workshops</a>
      <a href="<%= base %>/registration">Registration and fees</a>
      <a href="<%= base %>/abstracts">Abstract guidelines</a>
      <a href="<%= base %>/visit">Getting here and where to stay</a>
    </nav>
    <div class="stack" style="gap: 8px">
      <b>Contact</b>
      <% if (content.contactEmail) { %><p>Email: <a href="mailto:<%= content.contactEmail %>"><%= content.contactEmail %></a></p><% } %>
      <p>At the venue: the Registration counter</p>
      <p><a href="<%= portal %>">Delegate portal<span class="signed-out">: sign in or register</span></a></p>
    </div>
  </div>
  <div class="wrap legal">© <%= content.copyright %>. All rights reserved.</div>
</footer>
</body>
</html>
