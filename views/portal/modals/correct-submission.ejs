  <!-- MODAL: CORRECT SUBMISSION (targeted fix for wrong details / wrong screenshot) -->
  <div id="modal-correct" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50 overflow-y-auto">
    <div class="bg-white max-w-md w-full rounded-2xl p-6 shadow-2xl relative my-8 max-h-[90vh] overflow-y-auto">
      <button onclick="closeModal('modal-correct')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 id="correct-title" class="text-xl font-bold text-slate-800 mb-1">Correct Your Submission</h3>
      <p id="correct-desc" class="text-xs text-slate-500 mb-4"></p>

      <form id="correct-form" onsubmit="submitCorrection(event)" class="space-y-3">
        <div id="correct-utr-wrap">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Transaction UTR / Reference Number</label>
          <input type="text" id="correct-utr" placeholder="12-digit UTR No." class="w-full p-2.5 border rounded-lg text-sm font-mono outline-none">
        </div>
        <div id="correct-screenshot-wrap">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Payment Screenshot</label>
          <input type="file" id="correct-screenshot" accept="image/*" class="w-full text-sm">
        </div>
        <button type="submit" id="correct-submit-btn" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-md">Submit Correction</button>
      </form>
    </div>
  </div>
