  <!-- MODAL: ADD GROUP MEMBER -->
  <div id="modal-group-add" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-sm w-full rounded-2xl p-6 shadow-2xl relative">
      <button onclick="closeModal('modal-group-add')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Add a Group Member</h3>
      <p class="text-xs text-slate-500 mb-3">Enter the registered mobile number of the delegate to add. They must be registered on the portal.</p>
      <input type="tel" id="group-add-phone" maxlength="10" inputmode="tel" placeholder="10-digit mobile number" class="w-full p-2.5 border rounded-lg text-sm font-mono outline-none">
      <div class="flex justify-end gap-2 pt-4">
        <button type="button" onclick="closeModal('modal-group-add')" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Cancel</button>
        <button type="button" onclick="submitAddGroupMember()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold shadow-md">Add Member</button>
      </div>
    </div>
  </div>
