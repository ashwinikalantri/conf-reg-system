  <!-- MODAL: SET / CHANGE PASSWORD -->
  <!-- Shared by the delegate dashboard and the admin panel (see
       openSetPasswordModal/submitSetPassword in app.js) -- same endpoint,
       same "you're already logged in, that's proof enough" trust model
       either way, see POST /api/auth/set-password. -->
  <div id="modal-set-password" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-sm w-full rounded-2xl p-6 shadow-card relative">
      <!-- Hidden when this is the mandatory first-time prompt: an account
           with no password can't be required to have one and also be allowed
           to dismiss the only way to set it. openSetPasswordModal() (a
           voluntary change from the dashboard) shows it again. -->
      <button id="set-password-close-btn" onclick="closeModal('modal-set-password')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 id="set-password-title" class="text-lg font-bold text-slate-800 mb-1">Set Password</h3>
      <p id="set-password-blurb" class="text-xs text-slate-500 mb-4">Lets you log in with a password instead of waiting for an OTP each time. OTP still always works as a fallback. Applies immediately.</p>
      <form onsubmit="submitSetPassword(event)" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">New Password <span class="text-slate-400 font-normal">(at least 8 characters)</span></label>
          <input type="password" id="set-password-value" autocomplete="new-password" required minlength="8" class="w-full p-2.5 border rounded-lg text-sm outline-none">
        </div>
        <button type="submit" id="set-password-submit-btn" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm">Save Password</button>
      </form>
    </div>
  </div>
