  <!-- MODAL: TOP-UP PAYMENT (pay an outstanding balance) -->
  <div id="modal-topup" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50 overflow-y-auto">
    <div class="bg-white max-w-md w-full rounded-2xl p-6 shadow-2xl relative my-8 max-h-[90vh] overflow-y-auto">
      <button onclick="closeModal('modal-topup')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 class="text-xl font-bold text-slate-800 mb-1">Pay Outstanding Balance</h3>
      <p class="text-xs text-slate-500 mb-4">Pay the remaining balance and upload the payment proof. Your registration is confirmed once the full fee is verified.</p>

      <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 text-center mb-4">
        <p class="text-[10px] font-bold text-orange-700 uppercase tracking-wider">Balance Due</p>
        <p id="topup-amount-display" class="text-2xl font-extrabold text-orange-700">₹0</p>
      </div>

      <input type="radio" name="topup-payment-mode" value="UPI" checked class="hidden">
      <input type="radio" name="topup-payment-mode" value="NEFT_RTGS" class="hidden">

      <div id="topup-upi-pay-block" class="flex flex-col items-center gap-2 mb-4">
        <img id="topup-qr-image" src="" alt="UPI QR for balance" class="w-40 h-40 border-2 border-orange-200 rounded-xl p-1 bg-white">
        <a id="topup-pay-link" href="#" class="text-xs font-semibold text-indigo-600 hover:underline">Pay via UPI App</a>
        <p>
          <button type="button" onclick="setTopupPaymentMode('NEFT_RTGS')" class="text-xs text-indigo-600 hover:text-indigo-800 underline font-semibold">UPI not working? Pay by Bank Transfer instead</button>
        </p>
      </div>

      <div id="topup-neft-pay-block" class="hidden text-left bg-white border border-orange-200 rounded-xl p-4 space-y-1 text-sm mb-4">
        <p class="text-xs text-slate-500 uppercase font-bold mb-2">Bank Transfer Details</p>
        <p>Account Name: <b id="topup-bank-account-name">—</b></p>
        <p>Account No: <b id="topup-bank-account-number">—</b></p>
        <p>IFSC Code: <b id="topup-bank-ifsc">—</b></p>
        <p>Branch: <b id="topup-bank-branch">—</b></p>
        <p class="text-[10px] text-slate-500 pt-1">After transferring, enter the transaction/UTR number and upload a screenshot of the confirmation below.</p>
        <p class="text-center pt-2">
          <button type="button" onclick="setTopupPaymentMode('UPI')" class="text-xs text-indigo-600 hover:text-indigo-800 underline font-semibold">Pay by UPI instead</button>
        </p>
      </div>

      <form id="topup-form" onsubmit="submitTopup(event)" class="space-y-3">
        <div>
          <label id="topup-utr-label" class="block text-xs font-semibold text-slate-700 mb-1">Transaction UTR / Reference Number</label>
          <input type="text" id="topup-utr" required placeholder="12-digit UTR No." class="w-full p-2.5 border rounded-lg text-sm font-mono outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Payment Screenshot</label>
          <input type="file" id="topup-screenshot" accept="image/*" required class="w-full text-sm">
        </div>
        <button type="submit" id="topup-submit-btn" class="w-full py-3 bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-lg shadow-md">Submit Top-Up</button>
      </form>
    </div>
  </div>
