  <!-- MODAL: VERIFY EMAIL (or add/change one) -->
  <!-- Every account that predates email verification has an address that was
       typed in at signup but never proven, so it starts unverified (see the
       identity backfill in server.js). This is what asks for that proof at
       next login, and it doubles as the way to correct an address you can't
       actually receive mail at -- the code goes to whatever is in the field,
       not to whatever is on file. See POST /api/auth/verify-contact/*. -->
  <div id="modal-verify-email" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-sm w-full rounded-2xl p-6 shadow-2xl relative">
      <button onclick="dismissVerifyEmail()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 id="verify-email-title" class="text-lg font-bold text-slate-800 mb-1">Verify your email</h3>
      <p id="verify-email-blurb" class="text-xs text-slate-500 mb-4">We'll send a 6-digit code to your email address. Once verified you can sign in with it as well as your mobile number.</p>

      <form onsubmit="submitVerifyEmail(event)" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
          <div class="flex gap-2">
            <!-- Locked by requestVerifyEmailOTP once a code is out, so the
                 address being confirmed is unambiguously the one it was sent
                 to. "Use a different address" clears the code and unlocks. -->
            <input type="email" id="verify-email-value" autocomplete="email" required class="flex-1 p-2.5 border rounded-lg text-sm outline-none disabled:bg-slate-100 disabled:text-slate-500">
            <button type="button" id="verify-email-send-btn" onclick="requestVerifyEmailOTP()" class="px-3 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shrink-0">Send Code</button>
          </div>
          <p id="verify-email-change-hint" class="text-[11px] text-slate-400 mt-1">Not the right address? Change it here — the code goes to whatever you enter.</p>
          <button type="button" id="verify-email-change-btn" onclick="unlockVerifyEmailAddress()" class="hidden text-[11px] text-indigo-600 font-semibold hover:underline mt-1">Use a different address</button>
        </div>

        <div id="verify-email-otp-wrap" class="hidden space-y-2 pt-2 border-t border-slate-100">
          <div class="flex justify-between items-center">
            <label class="block text-xs font-semibold text-slate-700">6-Digit Code</label>
            <span id="verify-email-hint" class="text-[11px] text-indigo-600 font-mono font-bold"></span>
          </div>
          <input type="text" id="verify-email-otp" maxlength="6" placeholder="e.g. 123456" class="w-full p-2.5 border rounded-lg text-center font-mono tracking-widest text-lg outline-none">
          <button type="submit" id="verify-email-submit-btn" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm">Verify Email</button>
        </div>
      </form>

      <button type="button" onclick="dismissVerifyEmail()" class="w-full mt-3 text-xs text-slate-500 hover:text-slate-700 font-semibold">Skip for now</button>
    </div>
  </div>
