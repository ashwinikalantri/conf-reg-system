  <!-- MODAL 1: CONFERENCE REGISTRATION & PAYMENT -->
  <div id="modal-conference" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50 overflow-y-auto">
    <div class="bg-white max-w-xl w-full rounded-2xl p-6 shadow-2xl relative my-8 max-h-[90vh] overflow-y-auto">
      <button onclick="closeModal('modal-conference')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 class="text-2xl font-bold text-slate-800 mb-4">Conference Registration</h3>

      <form id="payment-form" onsubmit="verifyAndSubmitPayment(event)" class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-slate-700">1. Select Delegate Category</label>
          <div class="relative mt-1">
            <button type="button" id="category-dropdown-btn" onclick="toggleCategoryDropdown()" class="w-full p-3 border rounded-lg bg-white outline-none flex items-center justify-between text-left">
              <span id="category-dropdown-label" class="text-slate-400">-- Select Category --</span>
              <span class="text-slate-400 text-xs">▾</span>
            </button>
            <div id="category-dropdown-panel" class="hidden absolute z-10 mt-1 w-full bg-white border border-slate-200 rounded-lg shadow-lg max-h-72 overflow-y-auto"></div>
          </div>
          <select id="payment-category" class="hidden"></select>

          <!-- Shown only for student categories -->
          <div id="id-card-block" class="hidden mt-3 bg-amber-50 border border-amber-200 rounded-xl p-3">
            <label class="block text-xs font-semibold text-amber-900">Student ID Card <span class="text-amber-700">(required for student categories)</span></label>
            <input type="file" id="payment-id-card" accept="image/*" class="w-full mt-1 p-2 border rounded-lg bg-white text-sm outline-none file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-amber-100 file:text-amber-800">
            <p class="text-[10px] text-amber-800 mt-1">Upload a clear photo of your student ID. We run a quick automated check that it matches your category; the finance team verifies it manually.</p>
          </div>

        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">
          <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wide">2. Academic Preferences</h4>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Workshop Preference <span class="font-normal text-slate-400">(optional)</span></label>
            <select id="payment-workshop" class="w-full p-2.5 text-sm border rounded-lg bg-white outline-none">
              <option value="">-- Choose 1 Workshop (optional) --</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">QI Practice Exposure Preference <span class="font-normal text-slate-400">(optional)</span></label>
            <select id="payment-qi-exposure" class="w-full p-2.5 text-sm border rounded-lg bg-white outline-none">
              <option value="">-- Choose 1 QI Practice (optional) --</option>
            </select>
          </div>
        </div>

        <div id="qr-container" class="hidden bg-slate-50 border border-indigo-200 rounded-xl p-4 space-y-4">
          <div class="border-b pb-2">
            <div id="fee-discount-line" class="hidden flex justify-between items-center text-xs text-slate-500 mb-1">
              <span>Base fee</span><span id="fee-base-display">₹0</span>
            </div>
            <div id="fee-discount-amount-line" class="hidden flex justify-between items-center text-xs text-emerald-700 font-semibold mb-1">
              <span>
                <span id="fee-discount-label">Discount</span>
                <button type="button" onclick="removeAppliedPromo()" class="ml-1 text-slate-400 hover:text-rose-600 font-bold" title="Remove code">✕</button>
              </span>
              <span id="fee-discount-display">−₹0</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-500 uppercase font-bold">Amount to Pay</span>
              <span id="calculated-fee-display" class="text-xl font-extrabold text-indigo-600">₹0</span>
            </div>
            <!-- Promo / discount code: a discreet link that opens the input.
                 Once a code is applied, the input+Apply row hides -- the
                 Discount line above (with its own ✕) is the applied state. -->
            <div class="mt-2 text-right">
              <button type="button" id="promo-toggle" onclick="togglePromoField()" class="text-[11px] text-slate-400 hover:text-slate-600">Apply promo code</button>
              <div id="promo-field" class="hidden mt-2 text-left">
                <div id="promo-input-row" class="flex gap-2">
                  <input type="text" id="promo-code" placeholder="Enter code" class="flex-1 p-2 border rounded-lg text-sm outline-none uppercase font-mono">
                  <button type="button" id="promo-apply-btn" onclick="applyPromoCode()" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs rounded-lg shrink-0">Apply</button>
                </div>
                <p id="promo-msg" class="hidden text-[11px] mt-1 font-semibold"></p>
              </div>
            </div>
          </div>

          <!-- Hidden as a whole (along with payment-verification-fields below)
               when a 100% discount brings the fee to ₹0 -- there is nothing
               to pay, so no QR/bank-transfer block or UTR/screenshot fields. -->
          <div id="payment-method-blocks">
            <input type="radio" name="payment-mode" value="UPI" checked class="hidden">
            <input type="radio" name="payment-mode" value="NEFT_RTGS" class="hidden">

            <div id="upi-pay-block" class="text-center space-y-3">
              <p class="text-xs text-slate-600">Scan using GPay, PhonePe, Paytm, or BHIM.</p>
              <div class="flex justify-center my-2">
                <img id="upi-qr-image" src="" alt="Dynamic UPI QR Code" class="w-48 h-48 border-2 border-indigo-300 rounded-xl shadow-md p-1 bg-white">
              </div>
              <a id="upi-pay-link" href="#" class="inline-block px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow-sm">Pay via UPI App</a>
              <p class="text-[10px] text-slate-500">Pays <b id="upi-payee-label">NQOCN 2026</b> · reference is your registration number. On a phone, tap to open your UPI app.</p>
              <p>
                <button type="button" onclick="setPaymentMode('NEFT_RTGS')" class="text-xs text-indigo-600 hover:text-indigo-800 underline font-semibold">UPI not working? Pay by Bank Transfer instead</button>
              </p>
            </div>

            <div id="neft-pay-block" class="hidden text-left bg-white border border-indigo-200 rounded-xl p-4 space-y-1 text-sm">
              <p class="text-xs text-slate-500 uppercase font-bold mb-2">Bank Transfer Details</p>
              <p>Account Name: <b>NQoCN Conf 2026</b></p>
              <p>Account No: <b>5975992001</b></p>
              <p>IFSC Code: <b>CBIN0280697</b></p>
              <p>Branch: <b>Sewagram</b></p>
              <p class="text-[10px] text-slate-500 pt-1">After transferring, enter the transaction/UTR number and upload a screenshot of the confirmation below.</p>
              <p class="text-center pt-2">
                <button type="button" onclick="setPaymentMode('UPI')" class="text-xs text-indigo-600 hover:text-indigo-800 underline font-semibold">Pay by UPI instead</button>
              </p>
            </div>
          </div>

          <!-- Shown instead of the QR/bank-transfer block when the fee is ₹0. -->
          <p id="free-registration-note" class="hidden text-center text-sm font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl p-4">
            🎉 Your discount brings this to ₹0 — no payment is needed. Submit to confirm your registration.
          </p>
        </div>

        <div id="payment-verification-fields" class="space-y-4 border-t pt-4">
          <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wide">3. Payment Verification</h4>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label id="entered-utr-label" class="block text-xs font-semibold text-slate-700">Transaction UTR Number</label>
              <input type="text" id="entered-utr" placeholder="12-digit UTR No." required class="w-full mt-1 p-2.5 border rounded-lg font-mono text-sm outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700">Category Fee Amount (₹)</label>
              <input type="number" id="entered-amount" readonly placeholder="Calculated Fee" required class="w-full mt-1 p-2.5 border rounded-lg bg-slate-100 text-slate-700 font-mono text-sm font-bold">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700">Payment Screenshot (Mandatory Check)</label>
            <input type="file" id="payment-screenshot" accept="image/*" required class="w-full mt-1 p-2 border rounded-lg bg-white text-sm outline-none file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
            <p class="text-[10px] text-slate-500 mt-1">Upload a clear image of your transaction. An automated discrepancy check will scan the upload before manual audit.</p>
          </div>
        </div>

        <button type="submit" id="submit-payment-btn" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-md transition-all">
          Submit for Verification
        </button>
      </form>
    </div>
  </div>
