  <!-- AUTHENTICATION / PHONE + OTP CREATION (the delegate portal starts here) -->
  <section id="auth-page" class="w-full max-w-xl bg-white shadow-xl rounded-2xl p-8 border border-slate-200">

    <!-- Login Form (Visible by Default) -->
    <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
      <h2 class="text-xl font-bold text-slate-800 mb-1">Delegate Login</h2>
      <p class="text-xs text-slate-500 mb-4">Enter registered mobile number to receive OTP.</p>

      <div class="bg-indigo-50/60 p-4 rounded-xl border border-indigo-100 space-y-3">
        <label class="block text-xs font-bold text-indigo-800 uppercase tracking-wide">Registered Mobile Number</label>
        <div class="flex gap-2">
          <div class="relative flex-1">
            <span class="absolute left-3 top-3 text-sm text-slate-500 font-bold">+91</span>
            <input type="tel" id="login-phone" inputmode="tel" autocomplete="tel" maxlength="10" placeholder="10-digit Mobile No." required onkeydown="if(event.key==='Enter'){event.preventDefault(); document.getElementById('btn-send-login-otp').click();}" class="w-full p-2.5 pl-12 border rounded-lg bg-white text-sm font-mono outline-none">
          </div>
          <button type="button" id="btn-send-login-otp" onclick="requestOTP('login')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shrink-0">
            Send OTP
          </button>
        </div>

        <div id="login-otp-container" class="hidden space-y-2 pt-2 border-t border-indigo-100">
          <div class="flex justify-between items-center">
            <label class="block text-xs font-semibold text-slate-700">Enter 6-Digit OTP</label>
            <span id="login-otp-hint" class="text-[11px] text-indigo-600 font-mono font-bold"></span>
          </div>
          <input type="text" id="login-otp" maxlength="6" placeholder="e.g. 123456" class="w-full p-2.5 border rounded-lg bg-white text-center font-mono tracking-widest text-lg outline-none">
        </div>
      </div>

      <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-md">Verify OTP & Login</button>
      
      <p class="text-center text-sm text-slate-600 mt-4">
        Don't have an account? <a href="#" onclick="toggleAuth('register'); return false;" class="text-indigo-600 font-bold hover:underline">Sign up here</a>
      </p>
    </form>

    <!-- Registration Form (Hidden by Default) -->
    <form id="register-form" onsubmit="handleRegistration(event)" class="space-y-4 hidden">
      <h2 class="text-xl font-bold text-slate-800 mb-1">Delegate Registration</h2>
      <p class="text-xs text-slate-500 mb-4">Verification via 6-digit Mobile OTP required.</p>
      
      <div class="flex gap-3">
        <div class="w-28 shrink-0">
          <label class="block text-sm font-medium text-slate-700">Salutation</label>
          <select id="reg-salutation" class="w-full mt-1 p-3 border rounded-lg bg-white focus:ring-2 focus:ring-indigo-500 outline-none appearance-none bg-no-repeat bg-[right_0.75rem_center] bg-[length:1rem] bg-[url('data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22%2364748b%22%3E%3Cpath%20fill-rule%3D%22evenodd%22%20d%3D%22M5.23%207.21a.75.75%200%20011.06.02L10%2011.168l3.71-3.938a.75.75%200%20111.08%201.04l-4.25%204.5a.75.75%200%2001-1.08%200l-4.25-4.5a.75.75%200%2001.02-1.06z%22%20clip-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')]">
            <option value="">—</option>
            <option value="Mr">Mr</option>
            <option value="Mrs">Mrs</option>
            <option value="Ms">Ms</option>
            <option value="Dr">Dr</option>
            <option value="Prof">Prof</option>
          </select>
        </div>
        <div class="flex-1">
          <label class="block text-sm font-medium text-slate-700">Full Name</label>
          <input type="text" id="reg-name" required class="w-full mt-1 p-3 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>
      </div>
      <p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-2.5 py-1.5">⚠️ Enter your name (without any title/salutation) exactly as you want it printed on your certificate.</p>

      <div class="bg-indigo-50/60 p-4 rounded-xl border border-indigo-100 space-y-3">
        <label class="block text-xs font-bold text-indigo-800 uppercase tracking-wide">Mobile Number & Verification</label>
        <div class="flex gap-2">
          <div class="relative flex-1">
            <span class="absolute left-3 top-3 text-sm text-slate-500 font-bold">+91</span>
            <input type="tel" id="reg-phone" maxlength="10" placeholder="10-digit Mobile No." required class="w-full p-2.5 pl-12 border rounded-lg bg-white focus:ring-2 focus:ring-indigo-500 outline-none text-sm font-mono">
          </div>
          <button type="button" id="btn-send-reg-otp" onclick="requestOTP('reg')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg shrink-0">
            Send OTP
          </button>
        </div>

        <div id="reg-otp-container" class="hidden space-y-2 pt-2 border-t border-indigo-100">
          <div class="flex justify-between items-center">
            <label class="block text-xs font-semibold text-slate-700">Enter 6-Digit OTP</label>
            <span id="reg-otp-hint" class="text-[11px] text-indigo-600 font-mono font-bold"></span>
          </div>
          <input type="text" id="reg-otp" maxlength="6" placeholder="e.g. 123456" class="w-full p-2.5 border rounded-lg bg-white text-center font-mono tracking-widest text-lg">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700">Age</label>
          <input type="number" id="reg-age" min="1" max="120" placeholder="e.g., 28" required class="w-full mt-1 p-3 border rounded-lg outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700">Gender</label>
          <select id="reg-gender" required class="w-full mt-1 p-3 border rounded-lg bg-white outline-none appearance-none bg-no-repeat bg-[right_0.75rem_center] bg-[length:1rem] bg-[url('data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22%2364748b%22%3E%3Cpath%20fill-rule%3D%22evenodd%22%20d%3D%22M5.23%207.21a.75.75%200%20011.06.02L10%2011.168l3.71-3.938a.75.75%200%20111.08%201.04l-4.25%204.5a.75.75%200%2001-1.08%200l-4.25-4.5a.75.75%200%2001.02-1.06z%22%20clip-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')]">
            <option value="">Select</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700">Designation</label>
          <input type="text" id="reg-designation" list="designation-options" autocomplete="off" placeholder="e.g., Resident, Professor" required class="w-full mt-1 p-3 border rounded-lg outline-none">
          <datalist id="designation-options"></datalist>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700">Institute / Organization</label>
          <input type="text" id="reg-institute" list="institute-options" autocomplete="off" required class="w-full mt-1 p-3 border rounded-lg outline-none">
          <datalist id="institute-options"></datalist>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700">Email <span class="text-xs text-slate-400">(for notifications)</span></label>
        <input type="email" id="reg-email" placeholder="you@example.com" required class="w-full mt-1 p-3 border rounded-lg outline-none">
      </div>

      <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3">
        <label class="block text-sm font-semibold text-slate-800">Address Details</label>
        <div>
          <label class="block text-xs font-medium text-slate-600">PIN Code</label>
          <input type="text" id="reg-pincode" maxlength="6" oninput="fetchAddressDetails(this.value)" placeholder="Enter 6-digit PIN" required class="w-full mt-1 p-2.5 border rounded-lg bg-white outline-none">
          <span id="pincode-status" class="text-xs text-indigo-600 font-medium mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-slate-600">State</label>
            <input type="text" id="reg-state" readonly required class="w-full mt-1 p-2.5 border rounded-lg bg-slate-100 text-slate-600 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600">District</label>
            <input type="text" id="reg-district" readonly required class="w-full mt-1 p-2.5 border rounded-lg bg-slate-100 text-slate-600 focus:outline-none">
          </div>
        </div>
      </div>

      <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-md">Verify OTP & Create Account</button>
      
      <p class="text-center text-sm text-slate-600 mt-4">
        Already have an account? <a href="#" onclick="toggleAuth('login'); return false;" class="text-indigo-600 font-bold hover:underline">Login here</a>
      </p>
    </form>
  </section>
