    <div class="bg-white rounded-2xl p-8 shadow-xl text-center">
      <div class="text-5xl mb-4">🔧</div>
      <h2 class="text-2xl font-bold text-slate-800 mb-2">Under Maintenance</h2>
      <p id="maintenance-page-message" class="text-slate-600 text-sm leading-relaxed mb-6"></p>
      <p class="text-xs text-slate-400">
        Already have a registration? Your details are safe — nothing has been lost.
      </p>
      <button onclick="navigateTo('auth-page')" class="mt-5 text-xs text-indigo-600 hover:text-indigo-800 font-semibold underline">
        Staff login
      </button>
    </div>
  </section>
