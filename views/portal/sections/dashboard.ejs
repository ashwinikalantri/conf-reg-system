  <!-- PAGE 3: DELEGATE DASHBOARD -->
  <section id="dashboard-page" class="hidden w-full max-w-4xl bg-white shadow-card rounded-2xl p-8 border border-slate-200">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center border-b pb-4 mb-6 gap-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-800">Welcome, <span id="user-display-name" class="skeleton text-indigo-600">Delegate</span></h2>
        <p id="user-display-sub" class="text-xs text-slate-500 mt-0.5"></p>
      </div>
      <div class="self-start sm:self-auto flex items-center gap-2">
        <a id="admin-nav-btn" href="/admin" title="Admin Backend Panel" aria-label="Admin Backend Panel" class="hidden px-3 py-2 border border-slate-300 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-4 h-4"><line x1="4" y1="7" x2="20" y2="7"/><circle cx="9" cy="7" r="2" fill="currentColor" stroke="none"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="16" cy="12" r="2" fill="currentColor" stroke="none"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="11" cy="17" r="2" fill="currentColor" stroke="none"/></svg>
        </a>
        <button onclick="openSetPasswordModal(false)" title="Set Password" aria-label="Set Password" class="px-3 py-2 border border-slate-300 rounded-lg text-slate-600 hover:bg-slate-50 hover:text-indigo-600 transition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><circle cx="7" cy="12" r="4"/><line x1="11" y1="12" x2="21" y2="12"/><line x1="17" y1="12" x2="17" y2="16"/><line x1="21" y1="12" x2="21" y2="16"/></svg>
        </button>
        <button onclick="logout()" class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-50">Logout</button>
      </div>
    </div>

    <div id="reverify-banner" class="hidden mb-6 bg-rose-50 border-l-4 border-rose-500 p-4 rounded-r-xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h4 id="reverify-title" class="text-sm font-bold text-rose-800 flex items-center gap-2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M12 3 L22 20 L2 20 Z"/><line x1="12" y1="9" x2="12" y2="14"/><circle cx="12" cy="17" r="0.6" fill="currentColor" stroke="none"/></svg> Action Needed</h4>
          <p id="reverify-msg" class="text-xs text-rose-700 mt-1"></p>
        </div>
        <button id="reverify-btn" onclick="resolveRejection()" class="shrink-0 px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs rounded-lg shadow">Update</button>
      </div>
    </div>

    <!-- Email verification banner. The post-login modal is skippable (and
         only fires once a session), so without this there'd be no way back
         to it -- and no way to verify at all for anyone already logged in.
         Shown whenever the address is unproven, cleared the moment it is.
         Doubles as the prompt to ADD an address for a phone-only signup,
         which otherwise has no way to receive receipts or reminders. -->
    <div id="verify-email-banner" class="hidden mb-6 bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h4 class="text-sm font-bold text-amber-800 flex items-center gap-2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M3 6.5 L12 13 L21 6.5"/></svg> <span id="verify-email-banner-title">Email not verified</span></h4>
          <p id="verify-email-banner-msg" class="text-xs text-amber-700 mt-1"></p>
        </div>
        <button onclick="openVerifyEmailModal()" class="shrink-0 px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs rounded-lg shadow">Verify Now</button>
      </div>
    </div>

    <!-- Partial-payment / outstanding-balance banner: shown when part of the
         fee has been verified but a balance is still due. -->
    <div id="balance-banner" class="hidden mb-6 bg-orange-50 border-l-4 border-orange-500 p-4 rounded-r-xl">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h4 class="text-sm font-bold text-orange-800 flex items-center gap-2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg> Balance Due</h4>
          <p class="text-xs text-orange-700 mt-1">Part of your registration fee has been received. Please pay the remaining balance to complete your registration.</p>
          <div class="grid grid-cols-3 gap-2 mt-3">
            <div class="bg-white/70 border border-orange-200 rounded-lg px-2.5 py-1.5">
              <p class="text-[10px] text-slate-500 uppercase tracking-wide font-semibold">Total fee</p>
              <p id="balance-fee" class="text-sm font-bold text-slate-800 mt-0.5"></p>
            </div>
            <div class="bg-white/70 border border-orange-200 rounded-lg px-2.5 py-1.5">
              <p class="text-[10px] text-slate-500 uppercase tracking-wide font-semibold">Paid</p>
              <p id="balance-paid" class="text-sm font-bold text-emerald-700 mt-0.5"></p>
            </div>
            <div class="bg-white/70 border border-orange-200 rounded-lg px-2.5 py-1.5">
              <p class="text-[10px] text-slate-500 uppercase tracking-wide font-semibold">Balance due</p>
              <p id="balance-due" class="text-sm font-bold text-orange-700 mt-0.5"></p>
            </div>
          </div>
        </div>
        <button id="balance-topup-btn" onclick="openTopupModal()" class="shrink-0 px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white font-semibold text-xs rounded-lg shadow">Pay Balance</button>
      </div>
      <p id="balance-pending-note" class="hidden text-[11px] text-orange-700 mt-2 font-semibold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 inline align-[-1px] mr-1"><circle cx="12" cy="12" r="9"/><path d="M12 7 L12 12 L16 14"/></svg>Your top-up payment is submitted and pending verification.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border border-indigo-100 bg-indigo-50/50 rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-bold text-indigo-600 uppercase tracking-wide">Step 1</span>
            <!-- Neutral until the real status is known. This used to ship
                 "Registration Pending", which meant a confirmed delegate was
                 shown a wrong status until the fetch returned. The server
                 normally replaces it on the first paint (see __BOOTSTRAP_REG__
                 in the / route); this is what an anonymous visitor, or a
                 delegate whose session the server could not resolve, sees
                 while applyRegistrationState works it out. -->
            <span id="payment-status-tag" class="skeleton text-xs bg-slate-100 text-slate-600 font-bold px-2.5 py-1 rounded-full border border-slate-200">
              Checking&hellip;
            </span>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mt-1">Conference Registration & Payment</h3>
          <p id="payment-desc" class="text-sm text-slate-600 mt-2">Select category, workshop & QI exposure choices, scan dynamic QR, and submit UTR with screenshot.</p>

          <!-- Shown only once the payment is verified -->
          <div id="confirmed-block" class="hidden mt-4 bg-white border border-emerald-200 rounded-xl p-4 space-y-3">
            <div>
              <p class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Registration Number</p>
              <p id="reg-number-display" class="text-lg font-extrabold font-mono text-emerald-800 mt-0.5">—</p>
            </div>
            <!-- Desk pass: shown at the registration desk, scanned to bring up
                 this record. -->
            <div id="desk-pass" class="hidden flex items-center gap-3 border-t border-emerald-100 pt-3">
              <img id="desk-pass-qr" alt="Your desk pass QR code" width="96" height="96" class="w-24 h-24 rounded-lg border border-emerald-100 bg-white">
              <p class="text-xs text-emerald-900"><b>Your desk pass.</b> Show this at the registration desk to be found at once. It is also on your receipt and confirmation email.</p>
            </div>
            <!-- One line per chosen program option, across every group --
                 populated by loadDashboard() in app.js from reg.selections. -->
            <div id="conf-selections" class="text-xs space-y-1 border-t border-emerald-100 pt-2"></div>
            <button onclick="window.open('/api/registrations/me/receipt','_blank')" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-lg shadow-sm">
              View / Download Receipt
            </button>
          </div>
        </div>

        <!-- Hidden until the status is known, for the same reason as the chip
             above: a confirmed delegate should never be shown a Register &
             Pay button, however briefly. applyRegistrationState unhides it. -->
        <div id="payment-action-area" class="mt-6 hidden">
          <div id="payment-action-note" class="mb-3 bg-white p-3 rounded-xl border border-amber-200 text-xs text-amber-900 leading-relaxed">
            <b>Note:</b> Registration remains <b>Pending</b> until payment is verified manually by the finance admin.
          </div>
          <button id="register-conf-btn" onclick="openPaymentModal()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-md">
            Register & Pay Now
          </button>
        </div>
      </div>

      <div class="border border-emerald-100 bg-emerald-50/50 rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center">
            <span class="text-xs font-bold text-emerald-600 uppercase tracking-wide">Step 2</span>
            <span id="abstract-status-tag" class="skeleton text-xs bg-slate-100 text-slate-600 font-bold px-2.5 py-1 rounded-full border border-slate-200">Not Submitted</span>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mt-1">Submit Abstract</h3>
          <p id="abstract-desc" class="text-sm text-slate-600 mt-2">Submit papers or posters under Healthcare Quality &amp; Patient Safety. One abstract per delegate; it cannot be changed once submitted.</p>
          <!-- The last date, on its own line so it is not lost in the paragraph
               above. Filled by renderAbstractDeadlineNote() from the server's
               submission window; hidden once it no longer concerns them. -->
          <p id="abstract-deadline-note" class="hidden mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-800 bg-white border border-emerald-200 rounded-full px-2.5 py-1"></p>
          <button type="button" id="abstract-preview-toggle" onclick="toggleAbstractPreview()" class="hidden text-xs text-indigo-600 hover:underline font-semibold mt-2">View my submission</button>
          <div id="abstract-preview-box" class="hidden mt-2 p-3 bg-white border border-slate-200 rounded-lg text-xs text-slate-600 space-y-2"></div>
        </div>
        <button id="abstract-action-btn" onclick="openModal('modal-abstract')" class="mt-6 w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg shadow-md">Submit Abstract</button>
      </div>
    </div>

    <!-- Group registration (shown only when a group discount is available or
         the delegate is already in a group). Rendered by renderGroupSection. -->
    <div id="group-section" class="hidden mt-6 border border-indigo-100 bg-indigo-50/40 rounded-xl p-6"></div>

    <!-- Attendance & certificate: shown once registered. What they have
         signed into (and what is left for the certificate), the name the
         certificate will carry and -- for a doctor or medical PG -- their
         Medical Council number. Filled by loadAttendanceCard(). -->
    <div id="attendance-card" class="hidden mt-6 border border-slate-200 rounded-xl p-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="text-lg font-bold text-slate-800">Attendance &amp; Certificate</h3>
        <span id="attendance-status" class="text-xs font-bold px-2.5 py-1 rounded-full border"></span>
      </div>
      <p class="text-sm text-slate-600 mt-1">For your certificate, sign in on each day of the conference and sign out at the close of the last day &mdash; scan the code on the screen at the venue, or show your desk pass to a volunteer.</p>
      <ul id="attendance-list" class="mt-3 space-y-1.5 text-sm"></ul>
      <!-- Issued certificates, to download. -->
      <div id="cert-downloads" class="hidden mt-4 p-4 rounded-xl border border-emerald-200 bg-emerald-50">
        <p class="text-sm font-bold text-emerald-900">Your certificates</p>
        <div id="cert-download-list" class="mt-2 flex flex-col sm:flex-row sm:flex-wrap gap-2"></div>
      </div>
      <p id="cert-locked-note" class="hidden mt-4 text-xs text-slate-600">Your certificate has been issued with the details below. To correct them, please contact the organisers.</p>
      <form id="cert-details-form" onsubmit="saveCertificateDetails(event)" class="mt-5 pt-4 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="sm:col-span-2">
          <label for="cert-name" class="block text-xs font-semibold text-slate-600 mb-1">Name on your certificate</label>
          <input id="cert-name" maxlength="120" class="w-full h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none">
          <p class="text-[11px] text-slate-500 mt-1">Exactly as it should be printed, with your title. Leave it as it is if it is right.</p>
        </div>
        <div id="cert-council-wrap" class="hidden sm:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="cert-council" class="block text-xs font-semibold text-slate-600 mb-1">Medical Council</label>
            <input id="cert-council" list="cert-council-list" maxlength="80" placeholder="Maharashtra Medical Council" class="w-full h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none">
            <datalist id="cert-council-list">
              <option value="Maharashtra Medical Council"></option>
              <option value="Madhya Pradesh Medical Council"></option>
              <option value="Gujarat Medical Council"></option>
              <option value="Karnataka Medical Council"></option>
              <option value="Telangana State Medical Council"></option>
              <option value="Chhattisgarh Medical Council"></option>
              <option value="Delhi Medical Council"></option>
              <option value="Uttar Pradesh Medical Council"></option>
              <option value="Rajasthan Medical Council"></option>
              <option value="Tamil Nadu Medical Council"></option>
              <option value="Kerala State Medical Council"></option>
              <option value="West Bengal Medical Council"></option>
              <option value="National Medical Commission"></option>
            </datalist>
          </div>
          <div>
            <label for="cert-council-no" class="block text-xs font-semibold text-slate-600 mb-1">Registration number</label>
            <input id="cert-council-no" maxlength="30" autocomplete="off" class="w-full h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none">
          </div>
          <p class="sm:col-span-2 text-[11px] text-slate-500 -mt-1">Needed for the certificate with MMC credit points. Without it you receive the participation certificate.</p>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Save certificate details</button>
        </div>
      </form>
    </div>
  </section>
