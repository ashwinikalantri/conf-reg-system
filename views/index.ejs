<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= conferenceName || 'Registration Portal' %></title>
  <!-- Direction A, "Clinical Trust" -- settled on from three low-fi sketches
       (see the delegate-portal UI plan). Libre Franklin for headings, Source
       Sans 3 for body text, a steel-blue accent ramp remapped onto Tailwind's
       own `indigo` -- every existing bg-indigo-600/text-indigo-700/etc. across
       this page picks up the new color with nothing else touched, and any
       future screen built with the same utilities inherits it automatically.
       Scoped to THIS page: admin.ejs and setup.ejs load their own independent
       copy of the CDN script, so this config never reaches them. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- styles.css is what actually puts Libre Franklin on the headings (it
       scopes the face to this page's containers by id -- see the note at the
       top of that file). It says it is shared between index.ejs and
       admin.ejs, and admin.ejs did link it, but this page never did: the
       font was downloaded on every portal load and then applied to nothing,
       so every heading here rendered in the body face instead. -->
  <link rel="stylesheet" href="styles.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            indigo: {
              50: '#eef3f6', 100: '#dbe6ec', 200: '#b9cedb', 300: '#8fb0c3',
              400: '#628ea8', 500: '#46708c', 600: '#2f5673', 700: '#244560',
              800: '#1c3549', 900: '#142838',
            },
          },
          fontFamily: {
            sans: ['"Source Sans 3"', 'system-ui', '-apple-system', 'sans-serif'],
          },
          boxShadow: {
            card: '0 1px 2px rgba(20,30,40,.05), 0 12px 28px -14px rgba(20,30,40,.18)',
          },
        },
      },
    };
  </script>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col justify-center items-center p-4">

<%- include('portal/partials/hero') %>

<%- include('portal/sections/maintenance') %>
<%- include('portal/sections/auth') %>
<%- include('portal/sections/dashboard') %>

<%- include('portal/modals/add-group-member') %>
<%- include('portal/modals/registration-payment') %>
<%- include('portal/modals/topup') %>
<%- include('portal/modals/correct-submission') %>
<%- include('portal/modals/abstract') %>
<%- include('portal/modals/set-password') %>
<%- include('portal/modals/verify-email') %>
<%- include('portal/modals/confirm') %>

  <!-- The delegate's own registration, so the dashboard's first paint shows
       the real status rather than a placeholder it has to correct. Set only
       for a logged-in session (see the / route); app.js applies it
       synchronously and restoreSession re-applies the fetched copy after.
       "<" is escaped so a value can never close this tag early. -->
  <% if (typeof bootstrapReg !== 'undefined') { %>
  <script>
    window.__BOOTSTRAP_REG__ = <%- JSON.stringify(bootstrapReg).replace(/</g, '\\u003c') %>;
  </script>
  <% } %>
  <script src="app.js?v=<%= assetVersion %>"></script>
  <script>
    document.addEventListener('DOMContentLoaded', restoreSession);
  </script>
</body>
</html>
