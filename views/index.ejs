<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= conferenceName || 'Registration Portal' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 font-sans min-h-screen flex flex-col justify-center items-center p-4">

<%- include('portal/partials/hero') %>

<%- include('portal/sections/maintenance') %>
<%- include('portal/sections/auth') %>
<%- include('portal/sections/dashboard') %>

<%- include('portal/modals/add-group-member') %>
<%- include('portal/modals/registration-payment') %>
<%- include('portal/modals/topup') %>
<%- include('portal/modals/correct-submission') %>
<%- include('portal/modals/abstract') %>
<%- include('portal/modals/set-password') %>
<%- include('portal/modals/verify-email') %>
<%- include('portal/modals/confirm') %>

  <!-- The delegate's own registration, so the dashboard's first paint shows
       the real status rather than a placeholder it has to correct. Set only
       for a logged-in session (see the / route); app.js applies it
       synchronously and restoreSession re-applies the fetched copy after.
       "<" is escaped so a value can never close this tag early. -->
  <% if (typeof bootstrapReg !== 'undefined') { %>
  <script>
    window.__BOOTSTRAP_REG__ = <%- JSON.stringify(bootstrapReg).replace(/</g, '\\u003c') %>;
  </script>
  <% } %>
  <script src="app.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', restoreSession);
  </script>
</body>
</html>
