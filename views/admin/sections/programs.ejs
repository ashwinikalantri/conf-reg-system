    <!-- SETTINGS: PROGRAM GROUPS -->
    <!-- A group is a named bucket of mutually-related options a delegate
         picks from at registration (Workshops, QI Practices, or any further
         group a conference defines) -- see program_groups/program_options in
         server.js. Each group's own settings, its "add option" form, and its
         option rows are rendered by renderBackendPrograms() in app.js. -->
    <section id="section-programs" class="hidden space-y-6">
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <h3 class="text-lg font-bold text-slate-800 mb-3">Add Program Group</h3>
        <form onsubmit="handleAddProgramGroup(event)" class="flex flex-col sm:flex-row flex-wrap gap-3 sm:items-end">
          <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-semibold text-slate-600 mb-1">Group name</label>
            <input id="new-group-name" required placeholder="e.g. Workshops, QI Practices, Pre-Conference Courses" class="w-full p-2.5 border rounded-lg text-sm outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Choose up to</label>
            <input id="new-group-max-select" type="number" min="1" value="1" required class="w-24 p-2.5 border rounded-lg text-sm outline-none">
          </div>
          <label class="flex items-center gap-2 text-xs font-semibold text-slate-600 pb-2.5">
            <input id="new-group-required" type="checkbox" class="rounded">
            Required
          </label>
          <button type="submit" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-md">+ Add Group</button>
        </form>
      </div>
      <div id="program-groups-admin-container"></div>
    </section>
