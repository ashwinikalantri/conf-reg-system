    <!-- TAB 1: REGISTRATION APPROVAL -->
    <section id="section-payments" class="hidden space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
          <p class="text-xs font-bold text-slate-500 uppercase">Total Revenue Cleared</p>
          <p id="metric-total-amount" class="skeleton text-2xl font-black text-slate-800 mt-1">₹0</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-emerald-200 bg-emerald-50/30 shadow-sm">
          <p class="text-xs font-bold text-emerald-600 uppercase">Verified in Bank</p>
          <p id="metric-verified-count" class="skeleton text-2xl font-black text-emerald-700 mt-1">0</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-amber-200 bg-amber-50/30 shadow-sm">
          <p class="text-xs font-bold text-amber-600 uppercase">Pending Bank Clearing</p>
          <p id="metric-pending-count" class="skeleton text-2xl font-black text-amber-700 mt-1">0</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-orange-200 bg-orange-50/30 shadow-sm">
          <p class="text-xs font-bold text-orange-600 uppercase">Balance Due</p>
          <p id="metric-balance-count" class="skeleton text-2xl font-black text-orange-700 mt-1">0</p>
          <p id="metric-balance-amount" class="skeleton text-[11px] text-orange-600 font-semibold mt-0.5">₹0 outstanding</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-rose-200 bg-rose-50/30 shadow-sm">
          <p class="text-xs font-bold text-rose-600 uppercase">Rejected</p>
          <p id="metric-rejected-count" class="skeleton text-2xl font-black text-rose-700 mt-1">0</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-xs text-slate-500">Showing registrations awaiting a decision. Once verified, a delegate drops off this list — see <button type="button" onclick="switchBackendTab('reports')" class="text-indigo-600 underline font-semibold">Reports</button> for the full verified list.</p>
        <div class="flex gap-2 shrink-0">
          <!-- Visibility matches this endpoint's own role gate (Super Admin
               + Finance Admin, which via ROLE_IMPLIES also covers Finance &
               Academic) -- same isFinance the rest of this tab uses. -->
          <button id="register-delegate-btn" onclick="openRegisterDelegateModal()" class="hidden px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">
            + Register Delegate
          </button>
          <button id="rescan-flagged-btn" onclick="rescanFlaggedPayments()" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed text-white text-xs font-semibold rounded-lg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 inline align-[-3px] mr-1.5"><path d="M4 12a8 8 0 0 1 14-5.3"/><path d="M20 12a8 8 0 0 1-14 5.3"/><path d="M17 4v4h-4"/><path d="M7 20v-4h4"/></svg>Rescan Flagged
          </button>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
        <table class="w-full text-left border-collapse sm:min-w-[640px]">
          <thead class="hidden sm:table-header-group">
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase">
              <th class="py-3 px-4">Delegate &amp; Category</th>
              <th class="py-3 px-4">Registered</th>
              <th class="py-3 px-4">Amount</th>
              <th class="py-3 px-4">Checks</th>
              <th class="py-3 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="payment-table-body" class="divide-y divide-slate-100 text-sm">
          </tbody>
        </table>
      </div>

      <details id="rejected-section" class="hidden bg-white rounded-2xl border border-rose-200 shadow-sm overflow-hidden">
        <summary class="cursor-pointer select-none px-4 py-3.5 font-bold text-rose-700 text-sm flex items-center gap-2 hover:bg-rose-50/50">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 inline align-[-3px] mr-1.5"><circle cx="12" cy="12" r="9"/><line x1="6" y1="6" x2="18" y2="18"/></svg>Rejected Registrations</span>
          <span id="badge-rejected-count" class="bg-rose-100 text-rose-800 text-xs px-2 py-0.5 rounded-full font-bold">0</span>
        </summary>
        <div class="overflow-x-auto border-t border-rose-100">
          <table class="w-full text-left border-collapse sm:min-w-[640px]">
            <thead class="hidden sm:table-header-group">
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase">
                <th class="py-3 px-4">Delegate &amp; Category</th>
                <th class="py-3 px-4">Registered</th>
                <th class="py-3 px-4">Amount</th>
                <th class="py-3 px-4">Checks</th>
                <th class="py-3 px-4 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="rejected-table-body" class="divide-y divide-slate-100 text-sm"></tbody>
          </table>
        </div>
      </details>

      <!-- Balance due: delegates whose fee changed (e.g. a category correction)
           so their verified payment no longer covers the full fee. They've been
           emailed to pay the difference; it's their turn, so they sit here
           rather than in the main worklist. -->
      <details id="balance-section" class="hidden bg-white rounded-2xl border border-orange-200 shadow-sm overflow-hidden">
        <summary class="cursor-pointer select-none px-4 py-3.5 font-bold text-orange-700 text-sm flex items-center gap-2 hover:bg-orange-50/50">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 inline align-[-3px] mr-1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>Awaiting Balance Payment</span>
          <span id="badge-balance-count" class="bg-orange-100 text-orange-800 text-xs px-2 py-0.5 rounded-full font-bold">0</span>
        </summary>
        <div class="overflow-x-auto border-t border-orange-100">
          <table class="w-full text-left border-collapse sm:min-w-[640px]">
            <thead class="hidden sm:table-header-group">
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase">
                <th class="py-3 px-4">Delegate &amp; Category</th>
                <th class="py-3 px-4">Registered</th>
                <th class="py-3 px-4">Amount</th>
                <th class="py-3 px-4">Checks</th>
                <th class="py-3 px-4 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="balance-table-body" class="divide-y divide-slate-100 text-sm"></tbody>
          </table>
        </div>
      </details>

      <!-- Verified registrations: hidden by default, shown only to super admins
           (see applyRoleVisibility). Gives a reachable entry point to open the
           review modal for an already-verified delegate and un-approve it. -->
      <details id="verified-section" class="hidden bg-white rounded-2xl border border-emerald-200 shadow-sm overflow-hidden">
        <summary class="cursor-pointer select-none px-4 py-3.5 font-bold text-emerald-700 text-sm flex items-center gap-2 hover:bg-emerald-50/50">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 inline align-[-3px] mr-1.5"><circle cx="12" cy="12" r="9"/><path d="M8 12.5 L11 15.5 L16 9"/></svg>Verified Registrations</span>
          <span id="badge-verified-count" class="bg-emerald-100 text-emerald-800 text-xs px-2 py-0.5 rounded-full font-bold">0</span>
        </summary>
        <div class="overflow-x-auto border-t border-emerald-100">
          <table class="w-full text-left border-collapse sm:min-w-[640px]">
            <thead class="hidden sm:table-header-group">
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase">
                <th class="py-3 px-4">Delegate &amp; Category</th>
                <th class="py-3 px-4">Registered</th>
                <th class="py-3 px-4">Amount</th>
                <th class="py-3 px-4">Checks</th>
                <th class="py-3 px-4 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="verified-table-body" class="divide-y divide-slate-100 text-sm"></tbody>
          </table>
        </div>
      </details>

    </section>
