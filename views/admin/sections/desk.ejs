  <!-- SECTION: FRONT DESK
       Every other tab is a worklist. This one is not, and that is the whole
       point of it: on the conference days there is one person at the counter
       and the only question is what to do about them, so the screen starts
       with a search box and returns a single delegate, whole.

       Nothing here is a new capability. The record is composed from the same
       helpers the admin user-detail panel uses, the receipt is the same
       renderReceipt, and a programme change goes through the same capacity
       rules as the delegate's own form. What is different is the grain of
       the permissions behind it -- see the desk block in permissions.js. -->
  <section id="section-desk" class="hidden">

    <div class="flex items-baseline justify-between flex-wrap gap-2 mb-4">
      <h2 class="text-lg font-bold text-slate-800">Front Desk</h2>
      <!-- The float this person is holding. Their own, not the conference's:
           a desk reconciles what it hands over, and has no business seeing
           total revenue. -->
      <p id="desk-cash-summary" class="text-xs text-slate-500"></p>
    </div>

    <!-- Look-up. Autofocused, because at a counter the first keystroke
         should land here without anyone reaching for the mouse. -->
    <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-card mb-5">
      <form onsubmit="deskLookup(event)" class="flex flex-col sm:flex-row gap-2">
        <!-- relative: the suggestion list is absolutely positioned against
             this wrapper so it overlays the record below rather than pushing
             it down the page as the desk types. -->
        <div class="relative flex-1">
          <input id="desk-search" type="text" autocomplete="off" role="combobox"
                 aria-autocomplete="list" aria-expanded="false" aria-controls="desk-suggestions"
                 oninput="deskSuggest()" onkeydown="deskSuggestKey(event)" onblur="deskSuggestBlur()"
                 placeholder="Mobile, ID, email or name…"
                 class="w-full p-2.5 border border-slate-300 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-200">
          <!-- Populated by deskSuggest(). Hidden rather than emptied so the
               list keeps its place in the DOM for aria-controls. -->
          <ul id="desk-suggestions" role="listbox"
              class="hidden absolute z-20 left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-card overflow-hidden max-h-72 overflow-y-auto"></ul>
        </div>
        <div class="flex gap-2">
          <!-- Scan a desk pass (QR) or any barcode holding an ID, mobile or
               email. A handheld USB scanner needs nothing: it types into the
               search box and presses Enter. -->
          <button type="button" onclick="openDeskScanner()" aria-label="Scan a QR code or barcode"
                  class="px-3 py-2.5 border border-indigo-300 text-indigo-700 hover:bg-indigo-50 text-xs font-bold rounded-xl inline-flex items-center gap-1.5">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/></svg>Scan
          </button>
          <button type="submit" class="px-4 py-2.5 bg-navy hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-sm">Find delegate</button>
          <button type="button" id="desk-register-btn" onclick="openRegisterDelegateModal()"
                  class="hidden px-4 py-2.5 border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl">+ Register walk-in</button>
        </div>
      </form>
      <p id="desk-search-error" class="hidden text-xs text-rose-700 font-semibold mt-2"></p>
    </div>

    <!-- A name can legitimately match several people. Rather than guess which
         one is at the counter, the desk is asked to pick. -->
    <div id="desk-candidates" class="hidden bg-white p-4 sm:p-5 rounded-2xl shadow-card mb-5">
      <p class="text-xs font-bold text-slate-500 uppercase tracking-wide mb-3">More than one match — choose one</p>
      <div id="desk-candidate-list" class="space-y-2"></div>
    </div>

    <!-- The record. Rendered whole by renderDeskRecord(); the empty state is
         a prompt rather than a blank panel, because a desk with nobody at it
         should still look like it is working. -->
    <div id="desk-empty" class="text-center py-16 text-slate-400 text-sm">
      Look a delegate up to see their registration, payment, programme, abstract and arrival.
    </div>
    <div id="desk-record" class="hidden space-y-5"></div>

  
    <!-- The camera scanner, opened from Scan beside the search box. -->
    <div id="modal-desk-scan" class="hidden fixed inset-0 bg-slate-900/80 flex justify-center items-center p-4 z-50">
      <div class="bg-white max-w-md w-full rounded-2xl p-4 shadow-card">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-bold text-slate-800">Scan desk pass or barcode</h3>
          <button type="button" onclick="closeDeskScanner()" class="text-slate-400 hover:text-slate-600 text-xl font-bold" aria-label="Close">✕</button>
        </div>
        <div id="desk-scan-reader" class="w-full rounded-xl overflow-hidden bg-slate-900 min-h-[16rem]"></div>
        <p id="desk-scan-msg" class="text-xs text-slate-600 mt-3">Starting the camera…</p>
        <button type="button" onclick="closeDeskScanner()" class="mt-3 w-full h-10 border border-slate-300 text-slate-700 font-semibold text-sm rounded-xl">Cancel</button>
      </div>
    </div>
</section>
