    <!-- SETTINGS: ROLES -->
    <!-- The built-in roles ship as system rows (see permissions.js /
         seedRolesOnBoot in server.js) and stay editable everywhere except
         Super Admin, which holds every permission by a flag rather than a
         row and cannot be edited or deleted -- it is the way back in when
         another role is misconfigured. -->
    <section id="section-roles" class="hidden space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div>
          <h2 class="text-xl font-bold text-slate-800">Roles</h2>
          <p class="text-xs text-slate-500 mt-1">What each role may see and do. Assign a role to a person from Users &amp; Roles.</p>
        </div>
        <button type="button" onclick="openRoleEditor()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl shadow-md">+ New Role</button>
      </div>

      <div id="roles-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
    </section>

    <!-- MODAL: ROLE EDITOR (create, edit, or duplicate-as-create) -->
    <div id="modal-role-editor" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-2 sm:p-4 z-50">
      <div class="bg-white max-w-2xl w-full max-h-[90vh] rounded-2xl shadow-card relative flex flex-col">
        <button onclick="closeModal('modal-role-editor')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
        <div class="p-6 pb-0">
          <h3 id="role-editor-title" class="text-lg font-bold text-slate-800 mb-1">New Role</h3>
          <p id="role-editor-subtitle" class="text-xs text-slate-500 mb-4">A role's key can't be changed once it's created.</p>
        </div>

        <form id="role-editor-form" onsubmit="submitRoleEditor(event)" class="flex-1 overflow-y-auto px-6 space-y-4">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Key</label>
              <input id="role-editor-key" placeholder="e.g. DESK_STAFF" class="w-full p-2.5 border rounded-lg text-sm font-mono uppercase outline-none disabled:bg-slate-100 disabled:text-slate-400">
              <p class="text-[10px] text-slate-400 mt-1">Uppercase letters, digits and underscores.</p>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Label</label>
              <input id="role-editor-label" required placeholder="e.g. Desk Staff" class="w-full p-2.5 border rounded-lg text-sm outline-none">
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Description <span class="text-slate-400 font-normal">(optional)</span></label>
            <input id="role-editor-description" placeholder="A short note on who this is for" class="w-full p-2.5 border rounded-lg text-sm outline-none">
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-semibold text-slate-700">Permissions</label>
              <span class="text-[11px] text-slate-400"><span id="role-editor-perm-count">0</span> selected</span>
            </div>
            <div id="role-editor-matrix" class="space-y-3 border border-slate-200 rounded-xl p-3 bg-slate-50/50"></div>
          </div>
        </form>

        <div id="role-editor-error" class="hidden mx-6 mt-3 px-3 py-2 bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold rounded-lg"></div>
        <div class="flex justify-end gap-2 p-6 pt-4">
          <button type="button" onclick="closeModal('modal-role-editor')" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Cancel</button>
          <button type="submit" form="role-editor-form" id="role-editor-save-btn" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold shadow-md">Save Role</button>
        </div>
      </div>
    </div>
