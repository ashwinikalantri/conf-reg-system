    <!-- SETTINGS: PROGRAMME. The halls (each with its door QR) and the
         sessions that attendance, the delegate's programme and the
         certificates all read. Routes under /api/admin/programme. -->
    <section id="section-programme" class="hidden space-y-5">
    <!-- PROGRAMME: the halls (each with its door QR) and the sessions. -->
    <div class="space-y-5">
      <div>
        <h2 class="text-lg font-bold text-slate-800">Programme</h2>
        <p class="text-xs text-slate-500">Each hall's QR marks attendance at the session on there. Breaks, meals and registration take none. The halls themselves -- names, QR posters, map locations -- are in Conference setup.</p>
      </div>
      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <h3 class="text-sm font-bold text-slate-800">Sessions</h3>
          <div class="flex flex-wrap gap-2">
            <select id="prog-day" onchange="fillProgrammeHallFilter(); renderProgrammeSessions()" aria-label="Day" class="h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
            <select id="prog-hall" onchange="renderProgrammeSessions()" aria-label="Hall" class="h-9 max-w-[12rem] px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
            <button type="button" onclick="editProgrammeSession(null)" class="h-9 px-3 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Add session</button>
          </div>
        </div>
        <form id="prog-session-form" onsubmit="saveProgrammeSession(event)" class="hidden mb-4 p-3 rounded-xl border border-indigo-200 bg-indigo-50/40 grid grid-cols-2 sm:grid-cols-4 gap-2">
          <input type="hidden" id="ps-id">
          <select id="ps-hall" aria-label="Hall" class="col-span-2 h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <input id="ps-date" type="date" aria-label="Date" class="h-9 px-2 border border-slate-300 rounded-lg text-sm">
          <div class="flex items-center gap-1"><input id="ps-start" type="time" aria-label="Starts" class="min-w-0 flex-1 h-9 px-1 border border-slate-300 rounded-lg text-sm"><span class="text-xs text-slate-400">–</span><input id="ps-end" type="time" aria-label="Ends" class="min-w-0 flex-1 h-9 px-1 border border-slate-300 rounded-lg text-sm"></div>
          <input id="ps-label" maxlength="60" placeholder="Label, e.g. Session 4" class="h-9 px-3 border border-slate-300 rounded-lg text-sm outline-none">
          <input id="ps-title" maxlength="300" placeholder="Title" class="col-span-2 sm:col-span-3 h-9 px-3 border border-slate-300 rounded-lg text-sm outline-none">
          <p id="ps-title-note" class="hidden col-span-2 sm:col-span-4 -mt-1 text-[11px] text-slate-500">Called what the workshop is called. To change the name, rename it in Workshops.</p>
          <!-- Speakers and chairs: picked from the faculty list, in order, with
               plain words where needed ("and Team"); someone not yet faculty
               is added to the faculty list from here. renderSessionPeople(). -->
          <p id="ps-people-note" class="hidden col-span-2 sm:col-span-4 text-xs text-amber-900 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2"></p>
          <div class="col-span-2 sm:col-span-4 grid sm:grid-cols-2 gap-2">
            <div id="ps-people-speakers" class="rounded-lg border border-slate-300 bg-white p-2.5"></div>
            <div id="ps-people-chairs" class="rounded-lg border border-slate-300 bg-white p-2.5"></div>
          </div>
          <select id="ps-option" aria-label="Workshop or practice" onchange="syncSessionTitleField()" class="col-span-2 h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <label class="col-span-2 flex items-center gap-2 text-sm text-slate-700"><input id="ps-counts" type="checkbox"> Takes attendance</label>
          <div class="col-span-2 sm:col-span-4 flex flex-wrap gap-2">
            <button type="submit" class="h-9 px-4 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Save</button>
            <button type="button" onclick="document.getElementById('prog-session-form').classList.add('hidden')" class="h-9 px-4 border border-slate-300 text-slate-700 font-semibold text-sm rounded-lg">Cancel</button>
            <button type="button" id="ps-delete" onclick="deleteProgrammeSession()" class="hidden h-9 px-4 border border-rose-300 text-rose-700 font-semibold text-sm rounded-lg sm:ml-auto">Delete</button>
          </div>
        </form>
        <div id="prog-sessions" class="divide-y divide-slate-100 text-sm"></div>
      </div>
    </div>
    </section>
