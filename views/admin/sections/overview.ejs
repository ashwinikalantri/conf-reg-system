  <!-- SECTION: OVERVIEW (redesigned 31 Oct 2026, from the "Admin Overview"
       canvas). What needs you first -- one list, most urgent first, each row
       opening the section that can settle it -- then how the conference is
       shaping up: registrations, workshops, money, abstracts, faculty, and
       where delegates come from. On a conference day a gold-edged panel for
       the day leads.

       Every figure comes from the endpoint the section that owns it uses
       (renderBackendOverview), and a part is shown only to someone whose
       role can open what it summarises: a finance admin does not learn the
       abstract count from a tab they cannot open. -->
  <section id="section-overview" class="hidden">

    <div class="flex items-baseline justify-between flex-wrap gap-x-4 gap-y-1 mb-4">
      <div class="flex items-baseline gap-x-3.5 gap-y-1 flex-wrap">
        <h2 class="text-2xl font-bold text-slate-900">Overview</h2>
        <p id="ov-when" class="text-[15px] text-slate-600"></p>
      </div>
      <p class="text-sm text-slate-500"><span id="overview-updated"></span> · <button type="button" onclick="renderBackendOverview()" class="font-semibold text-navy hover:underline">Refresh</button></p>
    </div>

    <!-- A conference day: the day's figures, and each hall with a session
         open for attendance -- a door where nobody is being scanned is
         flagged. renderOverviewNow(); attendance.view. -->
    <div id="overview-now" class="hidden mb-4 rounded-2xl border-2 border-gold-500 bg-white p-4 sm:p-5 shadow-sm">
      <!-- A meal being served now (meals.view): served of expected, and at
           each counter where there are several. -->
      <p id="ov-meal-now" class="hidden mb-4 pb-4 border-b border-slate-100 text-[15px] text-slate-700"></p>
      <div id="ov-day-stats" class="hidden grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div><p class="text-sm font-semibold text-slate-600">Here today</p><p id="ov-day-present" class="text-2xl font-bold text-slate-900 tabular-nums">0</p><p id="ov-day-present-sub" class="text-sm text-slate-600">marked at a session</p></div>
        <div><p class="text-sm font-semibold text-slate-600">Badges collected</p><p id="ov-day-badges" class="text-2xl font-bold text-slate-900 tabular-nums">0</p><p class="text-sm text-slate-600">at the registration counter</p></div>
        <div><p class="text-sm font-semibold text-slate-600">In the halls now</p><p id="ov-day-now" class="text-2xl font-bold text-slate-900 tabular-nums">0</p><p class="text-sm text-slate-600">marked at the sessions on</p></div>
        <div><p class="text-sm font-semibold text-slate-600">Done for a certificate</p><p id="ov-day-done" class="text-2xl font-bold text-emerald-700 tabular-nums">0</p><p class="text-sm text-slate-600">a session before lunch and after</p></div>
      </div>
      <div id="overview-now-wrap" class="hidden">
        <div id="overview-now-head" class="flex items-baseline justify-between gap-3 flex-wrap mb-3">
          <h3 class="text-lg font-bold text-slate-900">Now in the halls <span id="overview-now-when" class="font-semibold text-slate-500"></span></h3>
          <button type="button" onclick="selectSettingsTab('attendance')" class="text-sm font-semibold text-navy hover:underline">Attendance →</button>
        </div>
        <div id="overview-now-halls" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_22rem] gap-4 items-start">
      <div class="space-y-4 min-w-0">

        <!-- Waiting on you. A row shows only when it has something in it and
             the role can open where it leads; with nothing waiting, one line
             says so for the sections this role can see. -->
        <div id="overview-attention" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm px-5 pt-4 pb-2">
          <div class="flex items-baseline justify-between gap-3 mb-1">
            <h3 class="text-lg font-bold text-slate-900">Waiting on you</h3>
            <span class="text-sm text-slate-500">most urgent first</span>
          </div>
          <div id="overview-queues">
            <button type="button" id="ov-q-balance" onclick="setPaymentFilter('balance'); switchBackendTab('payments')" class="ov-row hidden">
              <span id="ov-balance" class="skeleton ov-n text-rose-700">0</span>
              <span class="min-w-0"><span class="block font-semibold text-slate-900">Balance due</span><span id="ov-balance-sub" class="block text-sm text-slate-600">&nbsp;</span></span>
              <span class="ov-go">Registration</span>
            </button>
            <button type="button" id="ov-q-payments" onclick="switchBackendTab('payments')" class="ov-row hidden">
              <span id="ov-pending" class="skeleton ov-n text-amber-700">0</span>
              <span class="min-w-0"><span class="block font-semibold text-slate-900">Registrations to approve</span><span class="block text-sm text-slate-600">payment submitted, waiting for a decision</span></span>
              <span class="ov-go">Registration</span>
            </button>
            <button type="button" id="ov-q-statement" onclick="switchBackendTab('statement')" class="ov-row hidden">
              <span id="ov-unmatched" class="skeleton ov-n text-amber-700">0</span>
              <span class="min-w-0"><span class="block font-semibold text-slate-900">Bank credits not matched</span><span class="block text-sm text-slate-600">on the bank statement, no registration linked</span></span>
              <span class="ov-go">Bank statement</span>
            </button>
            <button type="button" id="ov-q-abstracts" onclick="switchBackendTab('abstracts')" class="ov-row hidden">
              <span id="ov-abstracts" class="skeleton ov-n text-amber-700">0</span>
              <span class="min-w-0"><span class="block font-semibold text-slate-900">Abstracts to review</span><span id="ov-abstracts-sub" class="block text-sm text-slate-600">&nbsp;</span></span>
              <span class="ov-go">Review Desk</span>
            </button>
          </div>
          <!-- Faculty: the rooms, pickups and accounts still to settle
               (guests.view). Each opens the Faculty tab, filtered. -->
          <div id="overview-queues-faculty" class="empty:hidden">
            <button type="button" id="ov-q-rooms" onclick="openFacultyFlag('noAccommodation')" class="ov-row hidden">
              <span id="ov-rooms" class="skeleton ov-n text-rose-700">0</span>
              <span class="min-w-0"><span class="block font-semibold text-slate-900">Faculty needing a room</span><span class="block text-sm text-slate-600">staying with us, no room assigned</span></span>
              <span class="ov-go">Faculty</span>
            </button>
            <button type="button" id="ov-q-pickups" onclick="openFacultyFlag('')" class="ov-row hidden">
              <span id="ov-pickups" class="skeleton ov-n text-amber-700">0</span>
              <span class="min-w-0"><span class="block font-semibold text-slate-900">Faculty pickup not decided</span><span class="block text-sm text-slate-600">no pickup arranged or declined yet</span></span>
              <span class="ov-go">Faculty</span>
            </button>
            <button type="button" id="ov-q-signup" onclick="openFacultyFlag('notSignedUp')" class="ov-row hidden">
              <span id="ov-signup" class="skeleton ov-n text-navy">0</span>
              <span class="min-w-0"><span class="block font-semibold text-slate-900">Faculty not signed up</span><span id="ov-signup-sub" class="block text-sm text-slate-600">no portal account linked</span></span>
              <span class="ov-go">Faculty</span>
            </button>
          </div>
          <p id="overview-clear-line" class="hidden border-t border-slate-100 py-3 text-sm text-slate-600"></p>
          <p id="overview-all-clear" class="hidden border-t border-slate-100 py-3 text-[15px] text-slate-600"></p>
        </div>

        <!-- Registrations (payments.view): the headcounts, sign-ups not yet
             registered (comms.reminders_view, with the reminder it calls
             for), each week's new registrations, and the categories. -->
        <div id="overview-regs" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-5">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-lg font-bold text-slate-900">Registrations</h3>
            <button type="button" onclick="switchBackendTab('reports')" class="text-sm font-semibold text-navy hover:underline">Reports →</button>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            <div><p class="text-sm font-semibold text-slate-600">Registered</p><p id="ov-delegates" class="skeleton text-2xl font-bold text-slate-900 tabular-nums">0</p><p id="ov-delegates-sub" class="text-sm text-slate-600">&nbsp;</p></div>
            <div><p class="text-sm font-semibold text-slate-600">Confirmed</p><p id="ov-confirmed" class="skeleton text-2xl font-bold text-emerald-700 tabular-nums">0</p><p id="ov-confirmed-sub" class="text-sm text-slate-600">&nbsp;</p></div>
            <div id="ov-signups-box" class="hidden"><p class="text-sm font-semibold text-slate-600">Signed up, not registered</p><p id="ov-signups" class="text-2xl font-bold text-gold-700 tabular-nums">0</p><button type="button" onclick="selectSettingsTab('reminders')" class="text-sm font-semibold text-navy hover:underline text-left">Send them a reminder →</button></div>
          </div>
          <div id="ov-weeks-box" class="hidden">
            <p class="text-sm font-semibold text-slate-600 mb-2">New registrations each week</p>
            <div id="ov-weeks" class="flex items-end gap-1 sm:gap-1.5 h-28 border-b border-slate-300"></div>
            <div id="ov-weeks-labels" class="flex gap-1 sm:gap-1.5 pt-1 text-xs text-slate-500"></div>
          </div>
          <div id="ov-cats-box" class="hidden">
            <p class="text-sm font-semibold text-slate-600 mb-2">By category</p>
            <div id="ov-cats-bar" class="flex h-3.5 rounded-md overflow-hidden bg-slate-100"></div>
            <div id="ov-cats-legend" class="flex flex-wrap gap-x-4 gap-y-1.5 mt-2.5 text-sm text-slate-700"></div>
          </div>
        </div>

        <!-- Workshops and QI practices: the seats taken in each, full and
             over marked. The seats are public (the registration form and
             the website show what is left); the exact count over capacity
             comes from the Workshops screen's own endpoint, for whoever may
             open it. -->
        <div id="overview-workshops" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
          <div class="flex items-baseline justify-between gap-3 flex-wrap mb-2">
            <h3 class="text-lg font-bold text-slate-900">Workshops and QI practices</h3>
            <p class="text-sm text-slate-600"><span id="ov-ws-summary"></span><button type="button" id="ov-ws-open" onclick="selectSettingsTab('programs')" class="hidden ml-2 font-semibold text-navy hover:underline">Workshops →</button></p>
          </div>
          <div id="ov-ws-list" class="space-y-4"></div>
        </div>
      </div>

      <div class="space-y-4 min-w-0">
        <!-- Money: conference-wide totals, payments.view_totals (a separate
             disclosure from working the approval queue). -->
        <div id="overview-money" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-3">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-lg font-bold text-slate-900">Money</h3>
            <button type="button" id="ov-money-statement" onclick="switchBackendTab('statement')" class="hidden text-sm font-semibold text-navy hover:underline">Bank statement →</button>
          </div>
          <div id="ov-card-collected"><p class="text-sm font-semibold text-slate-600">Collected</p><p id="ov-collected" class="skeleton text-2xl font-bold text-slate-900 tabular-nums">₹0</p><p id="ov-collected-sub" class="text-sm text-slate-600">&nbsp;</p></div>
          <div class="h-2.5 rounded-full bg-slate-100 overflow-hidden"><div id="ov-money-bar" class="h-full bg-navy" style="width:0%"></div></div>
          <div id="ov-card-outstanding"><p class="text-sm font-semibold text-slate-600">Outstanding</p><p id="ov-outstanding" class="skeleton text-xl font-bold text-rose-700 tabular-nums">₹0</p><p id="ov-outstanding-sub" class="text-sm text-slate-600">&nbsp;</p></div>
        </div>

        <!-- Abstracts (abstracts.view): submitted, where they stand, and
             oral against poster. -->
        <div id="overview-abstracts" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-3">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-lg font-bold text-slate-900">Abstracts</h3>
            <button type="button" onclick="switchBackendTab('abstracts')" class="text-sm font-semibold text-navy hover:underline">Review Desk →</button>
          </div>
          <div><p class="text-sm font-semibold text-slate-600">Submitted</p><p id="ov-abs-total" class="text-2xl font-bold text-slate-900 tabular-nums">0</p></div>
          <div id="ov-abs-bar" class="flex h-2.5 rounded-full bg-slate-100 overflow-hidden"></div>
          <div id="ov-abs-legend" class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-700"></div>
          <div id="ov-abs-formats" class="divide-y divide-slate-100 text-sm"></div>
        </div>

        <!-- Faculty (guests.view): the list, and how far along their
             accounts, travel and rooms are. -->
        <div id="overview-faculty" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-3">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-lg font-bold text-slate-900">Faculty</h3>
            <button type="button" onclick="switchBackendTab('faculty')" class="text-sm font-semibold text-navy hover:underline">Faculty →</button>
          </div>
          <div><p class="text-sm font-semibold text-slate-600">On the list</p><p id="ov-fac-total" class="text-2xl font-bold text-slate-900 tabular-nums">0</p><p id="ov-fac-sub" class="text-sm text-slate-600"></p></div>
          <div id="ov-fac-bars" class="space-y-3"></div>
        </div>
        <!-- Where delegates come from: the district map, in the narrow column
             so it stays a glance (it scales to its card). -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
          <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
            <h3 class="text-lg font-bold text-slate-900">Where delegates come from</h3>
            <div class="flex items-center gap-2">
              <div class="flex bg-slate-100 rounded-lg p-0.5 text-xs font-semibold">
                <button type="button" id="delegate-map-btn-registered" onclick="setDelegateMapMetric('registered')" class="px-3 py-1.5 rounded-md bg-white text-emerald-700 shadow-sm">Registered</button>
                <button type="button" id="delegate-map-btn-signedup" onclick="setDelegateMapMetric('signedup')" class="px-3 py-1.5 rounded-md text-slate-500">Signed Up</button>
              </div>
              <span class="flex items-center gap-1.5 text-xs text-slate-500"><span class="w-3 h-3 rounded-full inline-block border-2" style="border-color:#ea580c"></span>Host</span>
            </div>
          </div>
          <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
            <p id="delegate-map-summary" class="text-xs text-slate-500">Loading distribution…</p>
            <div id="delegate-map-legend" class="flex items-center gap-1.5"></div>
          </div>
          <div id="delegate-map" class="w-full max-w-md mx-auto relative"></div>
          <!-- International delegates can't be plotted on an Indian district
               choropleth, so they're tallied here instead of being dropped.
               Hidden when there are none. See renderDelegateMap. -->
          <div id="delegate-map-international" class="hidden mt-3 pt-3 border-t border-slate-100"></div>
        </div>
      </div>
    </div>

  </section>
