  <!-- SECTION: OVERVIEW
       The landing screen. Every number here is a headline for a section
       further along the tab bar, so each card links to the section that owns
       it rather than being a dead end -- an overview whose figures cannot be
       opened is just a poster.

       Cards are hidden for a viewer whose role cannot open the section they
       summarise (see renderBackendOverview): a finance admin should not learn
       the abstract count from a tab they are not allowed into. -->
  <section id="section-overview" class="hidden">

    <div class="flex items-baseline justify-between flex-wrap gap-2 mb-4">
      <h2 class="text-lg font-bold text-slate-800">Overview</h2>
      <p id="overview-updated" class="text-xs text-slate-400"></p>
    </div>

    <!-- Money first: it is the question the desk is asked most.

         The two rupee figures are conference-wide money and hide separately
         from the two headcounts: they need payments.view_totals, which is a
         different disclosure from working the approval queue. They are
         individually hidden rather than split into their own grid so the row
         still flows as 2 or 4 cards instead of wrapping. -->
    <div id="overview-money" class="hidden grid grid-cols-2 lg:grid-cols-4 gap-3 mb-3">
      <div id="ov-card-collected" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4">
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Collected</p>
        <p id="ov-collected" class="skeleton text-2xl font-black text-slate-800 mt-1 tabular-nums">₹0</p>
        <p id="ov-collected-sub" class="text-[11px] text-slate-500 mt-0.5">&nbsp;</p>
      </div>
      <div id="ov-card-outstanding" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4">
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Outstanding</p>
        <p id="ov-outstanding" class="skeleton text-2xl font-black text-orange-700 mt-1 tabular-nums">₹0</p>
        <p id="ov-outstanding-sub" class="text-[11px] text-slate-500 mt-0.5">&nbsp;</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4">
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Delegates</p>
        <p id="ov-delegates" class="skeleton text-2xl font-black text-slate-800 mt-1 tabular-nums">0</p>
        <p id="ov-delegates-sub" class="text-[11px] text-slate-500 mt-0.5">&nbsp;</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4">
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Confirmed</p>
        <p id="ov-confirmed" class="skeleton text-2xl font-black text-emerald-700 mt-1 tabular-nums">0</p>
        <p id="ov-confirmed-sub" class="text-[11px] text-slate-500 mt-0.5">&nbsp;</p>
      </div>
    </div>

    <!-- What is waiting on somebody. These are the ones worth acting on, so
         each is a button into the section that can settle it. -->
    <!-- Hidden whole for a viewer with none of the sections it summarises:
         the heading and the all-clear line below both make claims across
         payments, the statement and abstracts, so shown to someone who can
         see none of them they would be asserting something unknowable. -->
    <div id="overview-attention" class="hidden mb-6">
      <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wide mb-2">Needs attention</h3>
      <div id="overview-queues" class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <button type="button" id="ov-q-payments" onclick="switchBackendTab('payments')" class="hidden text-left bg-white rounded-2xl border border-slate-200 shadow-sm p-4 hover:border-indigo-300 hover:shadow-card transition">
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Awaiting approval</p>
          <p id="ov-pending" class="skeleton text-2xl font-black text-amber-700 mt-1 tabular-nums">0</p>
          <p class="text-[11px] text-indigo-600 font-semibold mt-0.5">Open Registration Approval →</p>
        </button>
        <button type="button" id="ov-q-balance" onclick="switchBackendTab('payments')" class="hidden text-left bg-white rounded-2xl border border-slate-200 shadow-sm p-4 hover:border-indigo-300 hover:shadow-card transition">
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Balance due</p>
          <p id="ov-balance" class="skeleton text-2xl font-black text-orange-700 mt-1 tabular-nums">0</p>
          <p id="ov-balance-sub" class="text-[11px] text-slate-500 mt-0.5">&nbsp;</p>
        </button>
        <button type="button" id="ov-q-statement" onclick="switchBackendTab('statement')" class="hidden text-left bg-white rounded-2xl border border-slate-200 shadow-sm p-4 hover:border-indigo-300 hover:shadow-card transition">
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Unmatched credits</p>
          <p id="ov-unmatched" class="skeleton text-2xl font-black text-slate-800 mt-1 tabular-nums">0</p>
          <p class="text-[11px] text-indigo-600 font-semibold mt-0.5">Open Bank Statement →</p>
        </button>
        <button type="button" id="ov-q-abstracts" onclick="switchBackendTab('abstracts')" class="hidden text-left bg-white rounded-2xl border border-slate-200 shadow-sm p-4 hover:border-indigo-300 hover:shadow-card transition">
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Abstracts to review</p>
          <p id="ov-abstracts" class="skeleton text-2xl font-black text-indigo-700 mt-1 tabular-nums">0</p>
          <p id="ov-abstracts-sub" class="text-[11px] text-slate-500 mt-0.5">&nbsp;</p>
        </button>
      </div>
      <p id="overview-all-clear" class="hidden text-sm text-slate-500 bg-white rounded-2xl border border-slate-200 shadow-sm p-5"></p>
    </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
          <h3 class="font-bold text-slate-800">Delegate Locations</h3>
          <div class="flex items-center gap-2">
            <div class="flex bg-slate-100 rounded-lg p-0.5 text-xs font-semibold">
              <button type="button" id="delegate-map-btn-registered" onclick="setDelegateMapMetric('registered')" class="px-3 py-1.5 rounded-md bg-white text-emerald-700 shadow-sm">Registered</button>
              <button type="button" id="delegate-map-btn-signedup" onclick="setDelegateMapMetric('signedup')" class="px-3 py-1.5 rounded-md text-slate-500">Signed Up</button>
            </div>
            <span class="flex items-center gap-1.5 text-xs text-slate-500"><span class="w-3 h-3 rounded-full inline-block border-2" style="border-color:#ea580c"></span>Host</span>
          </div>
        </div>
        <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
          <p id="delegate-map-summary" class="text-xs text-slate-500">Loading distribution…</p>
          <div id="delegate-map-legend" class="flex items-center gap-1.5"></div>
        </div>
        <div id="delegate-map" class="w-full relative"></div>
        <!-- International delegates can't be plotted on an Indian district
             choropleth, so they're tallied here instead of being dropped.
             Hidden when there are none. See renderDelegateMap. -->
        <div id="delegate-map-international" class="hidden mt-3 pt-3 border-t border-slate-100"></div>
      </div>

  </section>
