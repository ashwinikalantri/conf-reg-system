    <!-- SETTINGS: GENERAL (SMS / Email / UPI) -->
    <section id="section-general" class="hidden space-y-6">
      <!-- Conference Details -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <h3 class="text-lg font-bold text-slate-800 mb-1">🏛️ Conference Details</h3>
        <p class="text-xs text-slate-500 mb-3">Shown across confirmation emails, reports, and printable pages.</p>
        <form onsubmit="saveGeneralSettings(event, 'conference')" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="sm:col-span-2"><label class="block text-[10px] font-semibold text-slate-600 mb-1">Full Name</label><input id="gs-conf-name" required class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Acronym <span class="font-normal text-slate-400">(optional)</span></label><input id="gs-conf-acronym" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Location <span class="font-normal text-slate-400">(optional)</span></label><input id="gs-conf-location" placeholder="e.g. City, State" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Start Date <span class="font-normal text-slate-400">(optional)</span></label><input id="gs-conf-startdate" type="date" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">End Date <span class="font-normal text-slate-400">(optional)</span></label><input id="gs-conf-enddate" type="date" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div class="sm:col-span-2 border-t pt-3">
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">Registration Number Prefix</label>
            <input id="gs-conf-regprefix" required pattern="[A-Za-z0-9]{1,20}" placeholder="e.g. CONF2026" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono">
            <p class="text-[10px] text-slate-400 mt-1">Letters/numbers only. Prefixed to every new registration number going forward (e.g. CONF20261188) — changing it does <b>not</b> renumber existing registrations.</p>
          </div>
          <div class="sm:col-span-2"><button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save Conference Details</button></div>
        </form>
      </div>

      <!-- SMS -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <div>
            <h3 class="text-lg font-bold text-slate-800">📱 SMS</h3>
            <p class="text-xs text-slate-500">DLT gateway configuration. Turning this off also stops login OTPs.</p>
          </div>
          <label class="flex items-center gap-2 cursor-pointer shrink-0">
            <input type="checkbox" id="notify-sms-toggle" onchange="setGeneralToggle('sms', this.checked)" class="w-5 h-5">
            <span class="text-sm font-semibold text-slate-700">Enabled <span id="notify-sms-state" class="text-xs font-normal text-slate-400"></span></span>
          </label>
        </div>
        <p id="sms-key-note" class="hidden text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-2.5 mb-3">⚠️ No SMS_API_KEY set in the server environment — SMS cannot send regardless of this configuration.</p>
        <form onsubmit="saveGeneralSettings(event, 'sms')" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Sender ID</label><input id="gs-sms-sender" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Gateway URL</label><input id="gs-sms-url" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">DLT Entity ID</label><input id="gs-sms-entityid" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">DLT Template ID</label><input id="gs-sms-templateid" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">DLT Header ID</label><input id="gs-sms-headerid" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Message Type</label><input id="gs-sms-type" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div class="sm:col-span-2 border-t pt-3">
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">API Key <span id="gs-sms-apikey-hint" class="font-normal text-slate-400"></span></label>
            <input id="gs-sms-apikey" type="password" autocomplete="new-password" placeholder="Leave blank to keep the current key" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono">
            <p class="text-[10px] text-slate-400 mt-1">Stored in the server's .env file, never in the database. Only entered when changing it.</p>
          </div>
          <div class="sm:col-span-2"><button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save SMS Settings</button></div>
        </form>
      </div>

      <!-- Email -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <div>
            <h3 class="text-lg font-bold text-slate-800">✉️ Email</h3>
            <p class="text-xs text-slate-500">Amazon SES sender configuration.</p>
          </div>
          <label class="flex items-center gap-2 cursor-pointer shrink-0">
            <input type="checkbox" id="notify-email-toggle" onchange="setGeneralToggle('email', this.checked)" class="w-5 h-5">
            <span class="text-sm font-semibold text-slate-700">Enabled <span id="notify-email-state" class="text-xs font-normal text-slate-400"></span></span>
          </label>
        </div>
        <p id="email-key-note" class="hidden text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-2.5 mb-3">⚠️ AWS credentials are not set in the server environment — Email cannot send regardless of this configuration.</p>
        <form onsubmit="saveGeneralSettings(event, 'email')" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">From address</label><input id="gs-email-from" type="email" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">From name</label><input id="gs-email-fromname" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">AWS Region</label><input id="gs-email-region" placeholder="ap-south-1" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          <div class="border-t pt-3">
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">AWS Access Key ID <span id="gs-email-accesskey-hint" class="font-normal text-slate-400"></span></label>
            <input id="gs-email-accesskey" type="password" autocomplete="new-password" placeholder="Leave blank to keep current" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono">
          </div>
          <div class="border-t pt-3">
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">AWS Secret Access Key <span id="gs-email-secretkey-hint" class="font-normal text-slate-400"></span></label>
            <input id="gs-email-secretkey" type="password" autocomplete="new-password" placeholder="Leave blank to keep current" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono">
          </div>
          <p class="text-[10px] text-slate-400 sm:col-span-2">Credentials are stored in the server's .env file, never in the database. Only entered when changing them.</p>
          <div class="sm:col-span-2"><button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save Email Settings</button></div>
        </form>
      </div>

      <!-- Payment: UPI + Bank Transfer, the two payment methods a delegate
           can choose between at checkout (see payment-mode radio on the
           registration/top-up forms). Each has its own save button, same
           pattern as SMS/Email above. -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <h3 class="text-lg font-bold text-slate-800 mb-1">💳 Payment</h3>
        <p class="text-xs text-slate-500 mb-4">The two payment methods offered to delegates at checkout — UPI (QR code / pay link) and NEFT/RTGS bank transfer. Both sets of details are also used to verify payment screenshots.</p>

        <div class="border border-slate-200 rounded-xl p-4 mb-4">
          <h4 class="text-sm font-bold text-slate-700 mb-1">UPI</h4>
          <form onsubmit="saveGeneralSettings(event, 'upi')" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">UPI ID (VPA)</label><input id="gs-upi-id" placeholder="name@bank" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono"></div>
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Payee Name</label><input id="gs-upi-payeename" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
            <div class="sm:col-span-2"><button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save UPI Settings</button></div>
          </form>
        </div>

        <div class="border border-slate-200 rounded-xl p-4">
          <h4 class="text-sm font-bold text-slate-700 mb-1">🏦 Bank Transfer (NEFT/RTGS)</h4>
          <form onsubmit="saveGeneralSettings(event, 'bank')" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Account Name</label><input id="gs-bank-accountname" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Account Number</label><input id="gs-bank-accountnumber" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono"></div>
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">IFSC Code</label><input id="gs-bank-ifsc" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono uppercase"></div>
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Branch</label><input id="gs-bank-branch" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
            <div class="sm:col-span-2"><button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save Bank Transfer Settings</button></div>
          </form>
        </div>
      </div>

      <!-- Maintenance mode -->
      <div class="bg-white rounded-2xl p-5 border-2 border-amber-200 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <div>
            <h3 class="text-lg font-bold text-slate-800">🔧 Maintenance Mode</h3>
            <p class="text-xs text-slate-500">Closes the portal to delegates and all other admin roles. Super admins keep full access.</p>
          </div>
          <label class="flex items-center gap-2 cursor-pointer shrink-0">
            <input type="checkbox" id="maintenance-toggle" onchange="setMaintenanceMode(this.checked)" class="w-5 h-5">
            <span class="text-sm font-semibold text-slate-700">Enabled <span id="maintenance-state" class="text-xs font-normal text-slate-400"></span></span>
          </label>
        </div>
        <p id="maintenance-active-note" class="hidden text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-2.5 mb-3">⚠️ <b>Maintenance mode is ON.</b> Delegates cannot register, pay, or submit abstracts, and finance/reviewer admins cannot use the panel. Remember to turn this off when you're done.</p>
        <form onsubmit="saveGeneralSettings(event, 'maintenance')" class="space-y-2">
          <div>
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">Message shown to delegates</label>
            <textarea id="gs-maintenance-message" rows="2" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white outline-none"></textarea>
            <p class="text-[10px] text-slate-400 mt-1">Leave blank to restore the default wording.</p>
          </div>
          <div class="pt-1"><button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save Message</button></div>
        </form>
      </div>

      <!-- Notifications -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-1">
          <h3 class="text-lg font-bold text-slate-800">🔔 Notifications</h3>
          <label class="flex items-center gap-2 cursor-pointer shrink-0">
            <input type="checkbox" id="notify-digest-toggle" onchange="setGeneralToggle('digest', this.checked)" class="w-5 h-5">
            <span class="text-sm font-semibold text-slate-700">Daily Digest <span id="notify-digest-state" class="text-xs font-normal text-slate-400"></span></span>
          </label>
        </div>
        <p class="text-xs text-slate-500 mb-3">Who receives automated summaries, and when — separate from the SMS/Email channel setup above. Turning the toggle off stops the daily digest entirely without affecting delegate-facing emails (verification, rejection, abstract).</p>
        <form onsubmit="saveGeneralSettings(event, 'notifications')" class="space-y-2">
          <div>
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">Daily Digest Send Time <span class="font-normal text-slate-400">(IST, 24-hour)</span></label>
            <input id="gs-digest-sendtime" type="time" class="w-40 h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
            <p class="text-[10px] text-slate-400 mt-1">The digest script (cron) checks every 15 minutes and sends once it's past this time each day.</p>
          </div>
          <div>
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">Daily Digest Recipients</label>
            <p class="text-[10px] text-slate-400 mb-2">Gets the daily pending-approvals summary email (scripts/daily-digest.js). Search and pick by name or phone — matched by phone number under the hood, so it keeps working if someone's email changes.</p>
            <div class="relative">
              <input id="gs-digest-search" type="text" placeholder="Search by name or phone…" autocomplete="off" oninput="searchDigestRecipient(this.value)" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
              <div id="gs-digest-search-results" class="hidden absolute z-10 mt-1 w-full bg-white border border-slate-200 rounded-lg shadow-lg max-h-56 overflow-y-auto"></div>
            </div>
            <div id="gs-digest-chips" class="flex flex-wrap gap-2 mt-2"></div>
          </div>
          <div class="pt-1"><button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save Notification Settings</button></div>
        </form>
      </div>

      <!-- Other Environment Variables -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <h3 class="text-lg font-bold text-slate-800 mb-1">🗄️ Other Environment Variables</h3>
        <p class="text-xs text-slate-500 mb-3">Server-level settings, stored in the database instead of the server's .env file. Portal URL and OTP Echo apply immediately; Port, Cookie Name, and Cookie Secure are saved now but only take effect the next time the server process restarts.</p>
        <form onsubmit="saveGeneralSettings(event, 'otherEnv')" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="sm:col-span-2">
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">Portal URL</label>
            <input id="gs-env-portalurl" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
            <p class="text-[10px] text-slate-400 mt-1">Shown in discount-code emails and similar messages. Applies immediately.</p>
          </div>
          <div class="border-t pt-3">
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">Port</label>
            <input id="gs-env-port" type="number" min="1" max="65535" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono">
            <p class="text-[10px] text-amber-700 mt-1">⚠️ Takes effect only after the server process is restarted.</p>
          </div>
          <div class="border-t pt-3">
            <label class="block text-[10px] font-semibold text-slate-600 mb-1">Cookie Name</label>
            <input id="gs-env-cookiename" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none font-mono">
            <p class="text-[10px] text-amber-700 mt-1">⚠️ Takes effect only after restart, and signs everyone out (delegates and admins alike) the moment it does.</p>
          </div>
          <div class="sm:col-span-2 border-t pt-3">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="gs-env-cookiesecure" class="w-5 h-5">
              <span class="text-sm font-semibold text-slate-700">Cookie Secure (HTTPS-only)</span>
            </label>
            <p class="text-[10px] text-amber-700 mt-1">⚠️ Takes effect only after restart, and signs everyone out when it does. Only turn this ON if the site is actually served over HTTPS — turning it on over plain HTTP will silently break every login.</p>
          </div>
          <div class="sm:col-span-2 border-t pt-3">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="gs-env-otpecho" class="w-5 h-5">
              <span class="text-sm font-semibold text-slate-700">OTP Echo</span>
            </label>
            <p class="text-[10px] text-rose-700 mt-1">⚠️ Development convenience only — when ON, OTP codes are returned directly in the login API response instead of only via SMS. Applies immediately. Never leave this on in production.</p>
          </div>
          <div class="sm:col-span-2"><button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save</button></div>
        </form>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <p class="text-[10px] font-semibold text-slate-500 uppercase mb-1">Node Environment</p>
          <p id="gs-env-nodeenv" class="text-sm font-mono text-slate-700">—</p>
          <p class="text-[10px] text-slate-400 mt-1">Read-only — set via the NODE_ENV environment variable when the process is launched (pm2 / the shell), not editable from here.</p>
        </div>
      </div>
    </section>
