    <!-- TAB: REPORTS -->
    <section id="section-reports" class="hidden space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div id="report-delegates" class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
          <h3 class="font-bold text-slate-800">Registered Delegates</h3>
          <p class="text-xs text-slate-500 mt-1 mb-4">Demography &amp; institute details for verified delegates — no workshop/QI or fee data.</p>
          <div class="flex flex-wrap gap-2">
            <button onclick="viewReport('delegates')" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg">👁 View</button>
            <button onclick="downloadReport('delegates','csv')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg">⬇ Excel</button>
            <button onclick="downloadReport('delegates')" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">🖨 PDF</button>
          </div>
        </div>
        <div id="report-payments" class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
          <h3 class="font-bold text-slate-800">Payments</h3>
          <p class="text-xs text-slate-500 mt-1 mb-4">Every registration's payment details and status — pending, verified, and rejected.</p>
          <div class="flex flex-wrap gap-2">
            <button onclick="viewReport('payments')" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg">👁 View</button>
            <button onclick="downloadReport('payments','csv')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg">⬇ Excel</button>
            <button onclick="downloadReport('payments')" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">🖨 PDF</button>
          </div>
        </div>
        <div id="report-workshops" class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
          <h3 class="font-bold text-slate-800">Registrations by Workshop / QI Practice</h3>
          <p class="text-xs text-slate-500 mt-1 mb-4">Pick one workshop or QI practice to view or download its roster.</p>
          <select id="report-workshop-select" class="w-full p-2 border rounded-lg text-sm bg-white outline-none mb-3">
            <option value="">Loading options…</option>
          </select>
          <div class="flex flex-wrap gap-2">
            <button id="report-workshop-view-btn" disabled onclick="viewReport('workshops', reportWorkshopQuery())" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-semibold rounded-lg">👁 View</button>
            <button id="report-workshop-csv-btn" disabled onclick="downloadReport('workshops','csv', reportWorkshopQuery())" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-semibold rounded-lg">⬇ Excel</button>
            <button id="report-workshop-pdf-btn" disabled onclick="downloadReport('workshops', null, reportWorkshopQuery())" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-semibold rounded-lg">🖨 PDF</button>
          </div>
        </div>
        <div id="report-abstracts" class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
          <h3 class="font-bold text-slate-800">Accepted Abstracts</h3>
          <p class="text-xs text-slate-500 mt-1 mb-4">All abstracts marked accepted.</p>
          <div class="flex flex-wrap gap-2">
            <button onclick="viewReport('abstracts')" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg">👁 View</button>
            <button onclick="downloadReport('abstracts','csv')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg">⬇ Excel</button>
            <button onclick="downloadReport('abstracts')" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg">🖨 PDF</button>
          </div>
        </div>
      </div>
      <div id="report-view-container" class="hidden bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-6"></div>
    </section>
