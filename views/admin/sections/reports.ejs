    <!-- TAB: REPORTS (redesigned 31 Oct 2026, from the "Admin Reports"
         canvas). The reports, grouped, on the left -- each shown only to a
         role that holds its permission (applyRoleVisibility, reportCards);
         the one chosen opens on the right at once, Excel and PDF at its top.
         On a phone the list is the page, and a report opens in its place
         with a way back. openReport()/viewReport() in app.js. -->
    <section id="section-reports" class="hidden">
      <div class="flex items-baseline gap-x-3.5 gap-y-1 flex-wrap mb-4">
        <h2 class="text-2xl font-bold text-slate-900">Reports</h2>
        <p class="text-[15px] text-slate-600">Pick a report, look it over here, then download it.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[17.5rem_minmax(0,1fr)] gap-4 items-start">
        <nav id="report-list" aria-label="Reports" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-2">
          <p class="rep-group">At a glance</p>
          <button type="button" id="report-summary" data-report="summary" onclick="openReport('summary')" class="rep-item"><b>Summary</b><span>Headline figures, no names</span></button>
          <p class="rep-group">People</p>
          <button type="button" id="report-delegates" data-report="delegates" onclick="openReport('delegates')" class="rep-item"><b>Registered delegates</b><span>Confirmed, with category, institute and payment date</span></button>
          <button type="button" id="report-delegate-programs" data-report="delegate-programs" onclick="openReport('delegate-programs')" class="rep-item"><b>Delegates and their programmes</b><span>A column for each programme group; pending too</span></button>
          <button type="button" id="report-users" data-report="users" onclick="openReport('users')" class="rep-item"><b>All accounts</b><span>Everyone signed up, with their role</span></button>
          <p class="rep-group">Money</p>
          <button type="button" id="report-payments" data-report="payments" onclick="openReport('payments')" class="rep-item"><b>Payments</b><span>Every registration's payment and status</span></button>
          <p class="rep-group">Programme</p>
          <button type="button" id="report-workshops" data-report="workshops" onclick="openReport('workshops')" class="rep-item"><b>Workshop and QI rosters</b><span>Who is in each, one at a time</span></button>
          <button type="button" id="report-meals" data-report="meals" onclick="openReport('meals')" class="rep-item"><b>Meals served</b><span>Expected and served, by meal and counter</span></button>
          <p class="rep-group">Abstracts</p>
          <button type="button" id="report-abstracts" data-report="abstracts" onclick="openReport('abstracts')" class="rep-item"><b>Accepted abstracts</b><span>Title, authors and format</span></button>
        </nav>

        <div id="report-pane" class="min-w-0 hidden lg:block">
          <button type="button" onclick="closeReport()" class="lg:hidden mb-3 inline-flex items-center gap-1 h-11 px-1 text-[15px] font-semibold text-navy"><span aria-hidden="true">‹</span> All reports</button>
          <!-- A roster's workshop or practice, chosen before it opens. -->
          <div id="report-workshop-pick" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-4 mb-3">
            <label for="report-workshop-select" class="block text-sm font-semibold text-slate-600 mb-1">Workshop or practice</label>
            <select id="report-workshop-select" class="w-full h-11 px-3 border border-slate-300 rounded-xl text-[15px] bg-white outline-none">
              <option value="">Loading…</option>
            </select>
          </div>
          <div id="report-view-container" class="bg-white rounded-2xl border border-slate-200 shadow-sm">
            <p class="p-6 text-sm text-slate-500">Choose a report.</p>
          </div>
        </div>
      </div>
    </section>
