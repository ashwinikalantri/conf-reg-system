    <!-- TAB: REMINDERS. One composer for every audience: choose who, write
         what (templates, placeholders, a live preview of the email as it will
         arrive), check the recipients, test, send. Sent lists every send.
         The audiences are in reminders.js; who is in each, and the sending,
         in server.js (/api/admin/reminders/...); the page in app.js
         (renderReminders and what follows it). -->
    <section id="section-reminders" class="hidden space-y-5">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-slate-800">Reminders</h2>
          <p class="text-xs text-slate-500">Email an audience. Each person gets one email from an audience per 24 hours.</p>
        </div>
        <div role="tablist" class="flex gap-1.5">
          <button type="button" data-rem-view="compose" onclick="switchReminderView('compose')" class="rem-subtab px-3 py-1.5 text-sm font-semibold rounded-lg">Compose</button>
          <button type="button" data-rem-view="sent" onclick="switchReminderView('sent')" class="rem-subtab px-3 py-1.5 text-sm font-semibold rounded-lg">Sent</button>
        </div>
      </div>

      <div id="rem-view-compose" class="space-y-5">
        <!-- 1. Who -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <h3 class="text-sm font-bold text-slate-800 mb-3"><span class="text-slate-400 mr-1">1</span> Who</h3>
          <div id="rem-audiences" class="space-y-3"></div>
          <p id="rem-audience-desc" class="text-xs text-slate-500 mt-3"></p>
          <!-- An audience's own filters; shown only for that audience. -->
          <form id="rem-filter-domain" onsubmit="event.preventDefault(); applyReminderFilters()" class="hidden mt-3 flex flex-wrap items-end gap-2">
            <div class="flex-1 min-w-[12rem] max-w-xs">
              <label for="rem-domain" class="block text-xs font-semibold text-slate-600 mb-1">Email domain</label>
              <input id="rem-domain" placeholder="mgims.ac.in" autocomplete="off" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
            </div>
            <button type="submit" class="h-9 px-4 bg-slate-700 hover:bg-slate-800 text-white font-semibold text-sm rounded-lg">Find</button>
          </form>
          <div id="rem-filter-registered" class="hidden mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 max-w-xl">
            <div>
              <label for="rem-category" class="block text-xs font-semibold text-slate-600 mb-1">Category</label>
              <select id="rem-category" onchange="applyReminderFilters()" class="w-full h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
            </div>
            <div>
              <label for="rem-status" class="block text-xs font-semibold text-slate-600 mb-1">Payment status</label>
              <select id="rem-status" onchange="applyReminderFilters()" class="w-full h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
            </div>
          </div>
        </div>

        <!-- 2. What: the email on the left, as it will arrive on the right. -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <h3 class="text-sm font-bold text-slate-800 mb-3"><span class="text-slate-400 mr-1">2</span> What</h3>
          <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
            <div class="space-y-3 min-w-0">
              <div>
                <label for="rem-template" class="block text-xs font-semibold text-slate-600 mb-1">Start from a template</label>
                <select id="rem-template" onchange="applyReminderTemplate(this.value)" class="w-full h-10 px-2 border border-slate-300 rounded-lg text-sm bg-white outline-none"></select>
              </div>
              <div>
                <label for="rem-subject" class="block text-xs font-semibold text-slate-600 mb-1">Subject</label>
                <input id="rem-subject" oninput="onReminderEdited()" class="w-full h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none">
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-1.5 mb-1">
                  <label for="rem-body" class="text-xs font-semibold text-slate-600 mr-1">Body (HTML)</label>
                  <span id="rem-placeholders" class="flex flex-wrap gap-1.5"></span>
                </div>
                <textarea id="rem-body" rows="16" oninput="onReminderEdited()" spellcheck="false" class="w-full p-2.5 border border-slate-300 rounded-lg text-xs font-mono outline-none"></textarea>
              </div>
              <div id="rem-problems" class="hidden text-xs rounded-lg px-3 py-2 bg-rose-50 border border-rose-200 text-rose-800"></div>
            </div>
            <div class="min-w-0 flex flex-col">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class="text-xs font-semibold text-slate-600">Preview</span>
                <select id="rem-preview-as" onchange="scheduleReminderPreview(0)" aria-label="Preview as" class="ml-auto max-w-[16rem] h-8 px-2 border border-slate-300 rounded-lg text-xs bg-white"></select>
              </div>
              <div class="border border-slate-200 rounded-xl overflow-hidden flex-1 flex flex-col bg-slate-50">
                <div class="px-3 py-2 border-b border-slate-200 bg-white text-xs">
                  <span class="text-slate-400">Subject:</span> <span id="rem-preview-subject" class="font-semibold text-slate-700"></span>
                  <span id="rem-preview-to" class="block text-slate-400 truncate"></span>
                </div>
                <!-- sandbox="": the preview's HTML can neither run script nor
                     reach this page. -->
                <iframe id="rem-preview" sandbox="" title="Email preview" class="w-full flex-1 min-h-[28rem] bg-white"></iframe>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Send to -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <h3 class="text-sm font-bold text-slate-800"><span class="text-slate-400 mr-1">3</span> Send to</h3>
            <span id="rem-recipient-summary" class="text-xs text-slate-500"></span>
          </div>
          <div id="rem-recipients-wrap">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <input id="rem-recipient-search" type="search" oninput="renderReminderRecipients()" placeholder="Search name, email, detail…" class="flex-1 min-w-[12rem] h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
              <label class="flex items-center gap-2 text-xs font-semibold text-slate-600 select-none">
                <input type="checkbox" id="rem-select-all" onchange="toggleAllReminderRecipients(this.checked)"> Select all shown
              </label>
            </div>
            <div id="rem-recipients" class="border border-slate-200 rounded-xl divide-y divide-slate-100 max-h-[26rem] overflow-y-auto text-sm"></div>
          </div>
          <div id="rem-paste-wrap" class="hidden">
            <label for="rem-paste" class="block text-xs font-semibold text-slate-600 mb-1">Email addresses <span class="font-normal text-slate-400">— one per line, or separated by commas</span></label>
            <textarea id="rem-paste" rows="8" oninput="updateReminderSendState()" placeholder="someone@example.com&#10;another@example.com" class="w-full p-2.5 border border-slate-300 rounded-lg text-xs font-mono outline-none"></textarea>
          </div>
          <div class="flex flex-wrap items-center gap-2 mt-3">
            <button id="rem-test-btn" onclick="sendReminderTest()" class="px-4 py-2.5 bg-slate-700 hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold text-sm rounded-xl shadow-md">Send Test to Myself</button>
            <button id="rem-send-btn" onclick="sendReminders()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold text-sm rounded-xl shadow-md">Send to <span id="rem-send-count">0</span></button>
            <span id="rem-send-result" class="text-xs font-semibold"></span>
          </div>
        </div>
      </div>

      <!-- Sent: every send, newest first; one opens to the email and the
           people behind it. -->
      <div id="rem-view-sent" class="hidden space-y-4">
        <div id="rem-history" class="bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100"></div>
      </div>
    </section>

    <!-- One send from the Sent history. -->
    <div id="modal-rem-send" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-stretch sm:items-center p-0 sm:p-4 z-50">
      <div class="bg-white max-w-4xl w-full sm:rounded-2xl shadow-card relative flex flex-col h-full sm:h-auto sm:max-h-[92vh]">
        <div class="p-4 sm:p-5 border-b border-slate-100 shrink-0">
          <button type="button" onclick="closeModal('modal-rem-send')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold" aria-label="Close">✕</button>
          <h3 id="rem-send-title" class="text-lg font-bold text-slate-800 pr-8"></h3>
          <p id="rem-send-meta" class="text-xs text-slate-500 mt-0.5"></p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 p-4 sm:p-5 overflow-y-auto flex-1 min-h-0">
          <div class="min-w-0">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wide mb-2">Recipients</p>
            <div id="rem-send-recipients" class="border border-slate-200 rounded-xl divide-y divide-slate-100 max-h-[60vh] overflow-y-auto text-sm"></div>
          </div>
          <div class="min-w-0">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wide mb-2">The email, as written</p>
            <iframe id="rem-send-preview" sandbox="" title="The email sent" class="w-full min-h-[24rem] h-[60vh] border border-slate-200 rounded-xl bg-white"></iframe>
          </div>
        </div>
      </div>
    </div>
