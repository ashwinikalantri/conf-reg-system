    <!-- TAB: REMINDERS -->
    <section id="section-reminders" class="hidden space-y-6">
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
          <h3 class="font-bold text-slate-800">Signed Up but Not Registered</h3>
          <span class="text-xs text-slate-500"><span id="reminders-count" class="font-bold text-slate-700">0</span> people have an account but never submitted a payment registration</span>
        </div>
        <p class="text-xs text-slate-500 mb-3">Use <code class="bg-slate-100 px-1 py-0.5 rounded">{{name}}</code> in the body to insert each recipient's salutation + name.</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Subject</label>
              <input id="reminder-subject" class="w-full p-2.5 border rounded-lg text-sm outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Body (HTML)</label>
              <textarea id="reminder-body" rows="10" class="w-full p-2.5 border rounded-lg text-xs font-mono outline-none"></textarea>
            </div>
            <div class="flex flex-wrap gap-2">
              <button id="reminder-test-btn" onclick="sendReminderTest()" class="px-4 py-2.5 bg-slate-700 hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold text-sm rounded-xl shadow-md">
                🧪 Send Test to Myself
              </button>
              <button id="reminder-send-btn" onclick="sendRegistrationReminders()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold text-sm rounded-xl shadow-md">
                ✉️ Send Reminder to <span id="reminder-send-count">0</span> People
              </button>
            </div>
            <span id="reminder-send-result" class="text-xs font-semibold block"></span>
          </div>
          <div class="border border-slate-200 rounded-xl overflow-hidden">
            <div class="bg-slate-50 border-b border-slate-200 px-3 py-2 text-xs font-bold text-slate-500 uppercase flex items-center gap-2">
              <input type="checkbox" id="reminders-select-all" onchange="toggleAllReminderRecipients(this.checked)">
              <label for="reminders-select-all" class="cursor-pointer">Recipients</label>
              <span class="ml-auto font-normal normal-case text-slate-400"><span id="reminder-selected-count">0</span> selected</span>
            </div>
            <div id="reminders-list" class="divide-y divide-slate-100 max-h-96 overflow-y-auto text-sm"></div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm mt-6">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
          <h3 class="font-bold text-slate-800">Balance Payment Awaited</h3>
          <span class="text-xs text-slate-500"><span id="bdreminders-count" class="font-bold text-slate-700">0</span> registrations have a balance still due</span>
        </div>
        <p class="text-xs text-slate-500 mb-3">Use <code class="bg-slate-100 px-1 py-0.5 rounded">{{name}}</code> and <code class="bg-slate-100 px-1 py-0.5 rounded">{{amount}}</code> in the body to insert each recipient's salutation + name and their outstanding balance.</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Subject</label>
              <input id="bdreminder-subject" class="w-full p-2.5 border rounded-lg text-sm outline-none" value="Balance payment pending for your registration">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Body (HTML)</label>
              <textarea id="bdreminder-body" rows="10" class="w-full p-2.5 border rounded-lg text-xs font-mono outline-none"></textarea>
            </div>
            <div class="flex flex-wrap gap-2">
              <button id="bdreminder-test-btn" onclick="sendBalanceDueReminderTest()" class="px-4 py-2.5 bg-slate-700 hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold text-sm rounded-xl shadow-md">
                🧪 Send Test to Myself
              </button>
              <button id="bdreminder-send-btn" onclick="sendBalanceDueReminders()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold text-sm rounded-xl shadow-md">
                ✉️ Send Reminder to <span id="bdreminder-send-count">0</span> People
              </button>
            </div>
            <span id="bdreminder-send-result" class="text-xs font-semibold block"></span>
          </div>
          <div class="border border-slate-200 rounded-xl overflow-hidden">
            <div class="bg-slate-50 border-b border-slate-200 px-3 py-2 text-xs font-bold text-slate-500 uppercase flex items-center gap-2">
              <input type="checkbox" id="bdreminders-select-all" onchange="toggleAllBalanceDueRecipients(this.checked)">
              <label for="bdreminders-select-all" class="cursor-pointer">Recipients</label>
              <span class="ml-auto font-normal normal-case text-slate-400"><span id="bdreminder-selected-count">0</span> selected</span>
            </div>
            <div id="bdreminders-list" class="divide-y divide-slate-100 max-h-96 overflow-y-auto text-sm"></div>
          </div>
        </div>
      </div>

      <!-- Custom recipients: for reaching people who haven't signed up at
           all -- e.g. an external mailing list for an "early bird ends
           today" push -- since the two cards above only ever address
           existing accounts/registrations. See POST
           /api/admin/reminders/custom-send. -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm mt-6">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
          <h3 class="font-bold text-slate-800">Custom Recipients</h3>
          <span class="text-xs text-slate-500">Paste any email addresses — they don't need an account here</span>
        </div>
        <p class="text-xs text-slate-500 mb-3">One address per line or comma-separated. No <code class="bg-slate-100 px-1 py-0.5 rounded">{{name}}</code> personalization — these addresses aren't tied to a record.</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="space-y-3">
            <!-- The recurring announcements, so the common ones don't have to
                 be re-typed or pasted in from elsewhere. Each fills both
                 fields and reads its dates from the fee master, so an email
                 can't announce a deadline the app disagrees with. See
                 CUSTOM_REMINDER_TEMPLATES in app.js. -->
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Start from a template</label>
              <select id="customreminder-template" onchange="applyCustomReminderTemplate(this.value)" class="w-full p-2.5 border rounded-lg text-sm bg-white outline-none">
                <option value="">— Choose a template —</option>
                <option value="early-bird-ending">Early bird — ending soon</option>
                <option value="early-bird-extended">Early bird — deadline extended</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Subject</label>
              <input id="customreminder-subject" class="w-full p-2.5 border rounded-lg text-sm outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Body (HTML)</label>
              <textarea id="customreminder-body" rows="10" class="w-full p-2.5 border rounded-lg text-xs font-mono outline-none"></textarea>
            </div>
            <div class="flex flex-wrap gap-2">
              <button id="customreminder-test-btn" onclick="sendCustomReminderTest()" class="px-4 py-2.5 bg-slate-700 hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold text-sm rounded-xl shadow-md">
                🧪 Send Test to Myself
              </button>
              <button id="customreminder-send-btn" onclick="sendCustomReminders()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold text-sm rounded-xl shadow-md">
                ✉️ Send Reminder to <span id="customreminder-send-count">0</span> Addresses
              </button>
            </div>
            <span id="customreminder-send-result" class="text-xs font-semibold block"></span>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Recipient Addresses</label>
            <textarea id="customreminder-emails" rows="10" placeholder="someone@example.com&#10;another@example.com" oninput="updateCustomReminderCount()" class="w-full p-2.5 border rounded-lg text-xs font-mono outline-none"></textarea>
          </div>
        </div>
      </div>
    </section>
