         renderWaivers(). -->
    <section id="section-waivers" class="hidden max-w-4xl space-y-5">
      <div>
        <h2 class="text-lg font-bold text-slate-800">Fee waivers</h2>
        <p class="text-xs text-slate-500">Asked for at the Front Desk, with the amount and the reason. Approving lowers what they owe; a registration left owing nothing is confirmed at once.</p>
