      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="px-4 sm:px-5 pt-4 pb-2 text-sm font-bold text-slate-800 uppercase tracking-wide">Declined</h3>
        <div id="waivers-declined" class="divide-y divide-slate-100"></div>
