    <!-- SETTINGS: USERS -->
    <section id="section-users" class="hidden space-y-6">
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <h3 class="text-lg font-bold text-slate-800">Users</h3>
          <p class="text-xs text-slate-500">Everyone with an account — delegates and staff. Open a row for full details, registration, payments, and role.</p>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          <button onclick="downloadReport('users','csv')" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-md">
            ⬇ Export CSV
          </button>
          <button onclick="openCreateUserModal()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-md">
            + Create New Staff Account
          </button>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex flex-wrap items-center gap-3">
        <input id="user-filter-search" type="text" placeholder="🔍 Search name, phone, reg no…" oninput="renderBackendUsers()" class="flex-1 min-w-[200px] p-2.5 border rounded-lg text-sm outline-none">
        <select id="user-filter-role" onchange="renderBackendUsers()" class="p-2.5 border rounded-lg text-sm bg-white outline-none">
          <option value="">All roles</option>
          <option value="DELEGATE">Delegate</option>
          <option value="FINANCE_ADMIN">Finance Admin</option>
          <option value="ACADEMIC_REVIEWER">Academic Reviewer</option>
          <option value="FINANCE_ACADEMIC">Finance &amp; Academic Reviewer</option>
          <option value="OPERATIONS">Operations</option>
          <option value="SUPER_ADMIN">Super Admin</option>
        </select>
        <select id="user-filter-designation" onchange="renderBackendUsers()" class="p-2.5 border rounded-lg text-sm bg-white outline-none max-w-[180px]">
          <option value="">All designations</option>
        </select>
        <select id="user-filter-institute" onchange="renderBackendUsers()" class="p-2.5 border rounded-lg text-sm bg-white outline-none max-w-[200px]">
          <option value="">All institutes</option>
        </select>
        <select id="user-filter-status" onchange="renderBackendUsers()" class="p-2.5 border rounded-lg text-sm bg-white outline-none">
          <option value="">All registration statuses</option>
          <option value="BANK_VERIFIED">Verified</option>
          <option value="PENDING">Pending</option>
          <option value="REJECTED">Rejected</option>
          <option value="NONE">Not registered</option>
        </select>
        <span class="text-xs font-semibold text-slate-500 ml-auto whitespace-nowrap">Showing <span id="user-filter-count" class="text-slate-800">0</span> of <span id="user-total-count" class="text-slate-800">0</span></span>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[720px]">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase">
              <th class="py-3.5 px-4">Reg No.</th>
              <th class="py-3.5 px-4">Name</th>
              <th class="py-3.5 px-4">Designation</th>
              <th class="py-3.5 px-4">Institute</th>
              <th class="py-3.5 px-4">Registration Status</th>
              <th class="py-3.5 px-4 text-right">Details</th>
            </tr>
          </thead>
          <tbody id="user-table-body" class="divide-y divide-slate-100 text-sm">
          </tbody>
        </table>
      </div>
    </section>
