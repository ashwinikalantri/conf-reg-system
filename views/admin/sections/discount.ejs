    <!-- SETTINGS: DISCOUNT CODE -->
    <section id="section-discount" class="hidden space-y-4">
      <h2 class="text-xl font-bold text-slate-800">Discount Codes</h2>

      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <h3 class="text-lg font-bold text-slate-800 mb-3">Add Discount Code</h3>
        <form onsubmit="handleAddDiscountCode(event)" class="space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Code <span class="font-normal text-slate-400">(auto-generated)</span></label>
              <div class="flex gap-1.5">
                <input id="new-disc-code" required readonly class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-slate-50 outline-none uppercase font-mono font-bold tracking-wider">
                <button type="button" onclick="generateDiscCode()" title="Generate a new code" class="h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white hover:bg-slate-50 text-slate-600 shrink-0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M4 12a8 8 0 0 1 14-5.3"/><path d="M20 12a8 8 0 0 1-14 5.3"/><path d="M17 4v4h-4"/><path d="M7 20v-4h4"/></svg></button>
              </div>
            </div>
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Type</label>
              <select id="new-disc-type" onchange="updateDiscScopeHints()" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
                <option value="PERCENT">Percent %</option>
                <option value="FLAT">Flat ₹</option>
              </select>
            </div>
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Value</label><input id="new-disc-value" type="number" min="1" required placeholder="20" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Scope</label>
              <select id="new-disc-scope" onchange="updateDiscScopeHints()" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
                <option value="GLOBAL">All delegates</option>
                <option value="CATEGORY">Category</option>
                <option value="INDIVIDUAL">Individual</option>
              </select>
            </div>
            <div id="new-disc-scope-cat-wrap" class="hidden"><label class="block text-[10px] font-semibold text-slate-600 mb-1">Category</label>
              <select id="new-disc-scope-cat" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></select>
            </div>
            <div id="new-disc-scope-phone-wrap" class="hidden relative">
              <label class="block text-[10px] font-semibold text-slate-600 mb-1">Delegate</label>
              <input id="new-disc-delegate-search" autocomplete="off" oninput="searchDiscDelegate(this.value)" placeholder="Search name / mobile / email" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
              <input type="hidden" id="new-disc-scope-phone">
              <div id="new-disc-delegate-results" class="hidden absolute z-20 left-0 right-0 mt-1 bg-white border border-slate-200 rounded-lg shadow-lg max-h-56 overflow-y-auto divide-y divide-slate-100"></div>
              <p id="new-disc-delegate-selected" class="hidden text-[11px] text-emerald-700 font-semibold mt-1 absolute top-full left-0"></p>
            </div>
            <div id="new-disc-max-wrap"><label class="block text-[10px] font-semibold text-slate-600 mb-1">Max uses</label><input id="new-disc-max" type="number" min="0" placeholder="∞" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
            <div><label class="block text-[10px] font-semibold text-slate-600 mb-1">Expires</label><input id="new-disc-expires" type="date" class="w-full h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none"></div>
          </div>
          <button type="submit" class="h-9 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">+ Add Code</button>
        </form>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[820px]">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase">
              <th class="py-3 px-4">Code</th>
              <th class="py-3 px-4">Discount</th>
              <th class="py-3 px-4">Scope</th>
              <th class="py-3 px-4">Used</th>
              <th class="py-3 px-4">Expires</th>
              <th class="py-3 px-4 text-right">Share</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="discount-table-body" class="divide-y divide-slate-100 text-sm"></tbody>
        </table>
      </div>
    </section>
