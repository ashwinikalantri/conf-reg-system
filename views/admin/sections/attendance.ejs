    <!-- TAB: ATTENDANCE. Session by session: every hall has a QR at its
         door; a delegate scans it and is marked present at the session on
         there now, or a volunteer picks the hall and scans their badge. Certificates and their
         settings follow. The halls and sessions are the Programme section. Routes under /api/attendance and
         /api/admin/programme in server.js; the rules in attendance.js. -->
    <section id="section-attendance" class="hidden space-y-5">
      <div role="tablist" class="flex gap-1.5 overflow-x-auto border-b border-slate-200 pb-2 -mx-1 px-1">
        <button type="button" data-att-view="attendance" onclick="switchAttendanceView('attendance')" class="att-subtab shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Attendance</button>
        <button type="button" data-att-view="certificates" onclick="switchAttendanceView('certificates')" class="att-subtab hidden shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Certificates</button>
        <button type="button" data-att-view="settings" onclick="switchAttendanceView('settings')" class="att-subtab hidden shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Certificate settings</button>
      </div>

      <div id="att-view-attendance" class="att-view space-y-5">
        <div>
          <h2 class="text-lg font-bold text-slate-800">Attendance</h2>
          <p class="text-xs text-slate-500">Delegates scan the QR at a hall's door, or a volunteer scans their badge: they are marked present at the session on in that hall now.</p>
        </div>

        <!-- At a door: the hall, what is on, then scan or type. -->
        <div id="att-take" class="hidden bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <label for="att-hall" class="block text-xs font-semibold text-slate-600 mb-1">Hall</label>
          <select id="att-hall" onchange="onAttendanceHallChange()" class="w-full h-11 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <div id="att-now" class="mt-2 text-sm"></div>
          <form onsubmit="event.preventDefault(); attendanceSignIn(document.getElementById('att-id').value)" class="mt-3 flex flex-col sm:flex-row gap-2">
            <input id="att-id" autocomplete="off" placeholder="ID, mobile or email" class="flex-1 min-w-0 h-11 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
            <div class="flex gap-2">
              <button type="submit" class="flex-1 sm:flex-none h-11 px-4 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Mark present</button>
              <button type="button" onclick="openAttendanceScanner()" class="flex-1 sm:flex-none h-11 px-4 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Scan</button>
            </div>
          </form>
          <!-- The last result, large enough to read at arm's length. -->
          <div id="att-result" class="hidden mt-3 rounded-xl px-4 py-3 border"></div>
          <!-- A workshop: someone not enrolled is let in only with a reason. -->
          <form id="att-notenrolled" onsubmit="event.preventDefault(); attendanceLetIn()" class="hidden mt-2 flex flex-col sm:flex-row gap-2">
            <input id="att-notenrolled-reason" maxlength="200" placeholder="Reason to let them in (e.g. swapped with a colleague)" class="flex-1 min-w-0 h-10 px-3 border border-amber-300 rounded-lg text-sm bg-white outline-none">
            <button type="submit" class="h-10 px-4 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-sm rounded-lg">Let in</button>
          </form>
        </div>

        <!-- Counts per session. -->
        <div id="att-summary-card" class="hidden bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <h3 class="text-sm font-bold text-slate-800">Present, session by session</h3>
            <span id="att-completed" class="text-xs font-semibold text-emerald-700"></span>
          </div>
          <select id="att-day" onchange="renderAttendanceSummary()" aria-label="Day" class="mb-3 h-10 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <div id="att-summary" class="divide-y divide-slate-100"></div>
        </div>

        <!-- Who was present at one session. -->
        <div id="att-roster-card" class="hidden bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <h3 class="text-sm font-bold text-slate-800 mb-3">Who was present</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-3">
            <select id="att-roster-session" onchange="loadAttendanceRoster()" aria-label="Session" class="sm:col-span-3 h-10 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
            <select id="att-roster-filter" onchange="renderAttendanceRoster()" aria-label="Show" class="h-10 px-2 border border-slate-300 rounded-lg text-sm bg-white">
              <option value="">Everyone</option>
              <option value="in">Present</option>
              <option value="out">Enrolled, not present</option>
            </select>
            <input id="att-roster-search" type="search" oninput="renderAttendanceRoster()" placeholder="Search name or ID" class="sm:col-span-2 h-10 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
          </div>
          <form id="att-manual" onsubmit="event.preventDefault(); markAttendanceByHand()" class="hidden mb-3 flex flex-col sm:flex-row gap-2">
            <input id="att-manual-id" autocomplete="off" placeholder="Mark someone present by hand: ID, mobile or email" class="flex-1 min-w-0 h-10 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
            <button type="submit" class="h-10 px-4 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Mark present</button>
          </form>
          <p id="att-roster-count" class="text-xs text-slate-500 mb-2"></p>
          <div id="att-roster" class="border border-slate-200 rounded-xl divide-y divide-slate-100 max-h-[32rem] overflow-y-auto text-sm"></div>
        </div>
      </div>

      <!-- CERTIFICATES: who qualifies for which, issuing, and those issued. -->
      <div id="att-view-certificates" class="att-view hidden space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-800">Certificates</h2>
            <p class="text-xs text-slate-500">The conference: present at a session before lunch and one after, and paid. With MMC points for doctors and medical postgraduates who have given a council number. A workshop: present at it.</p>
          </div>
          <div id="cert-issue-btns" class="hidden flex flex-wrap gap-2 w-full sm:w-auto">
            <button type="button" onclick="issueCertificates('conference')" id="cert-issue-conf" class="flex-1 sm:flex-none px-4 py-2 bg-navy hover:bg-indigo-700 disabled:opacity-50 text-white font-semibold text-sm rounded-xl shadow-md">Issue conference certificates</button>
            <button type="button" onclick="issueCertificates('workshops')" id="cert-issue-ws" class="flex-1 sm:flex-none px-4 py-2 bg-navy hover:bg-indigo-700 disabled:opacity-50 text-white font-semibold text-sm rounded-xl shadow-md">Issue workshop certificates</button>
          </div>
        </div>
        <div id="cert-stats" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-3">
            <select id="cert-filter" onchange="renderCertificateList()" aria-label="Show" class="h-10 px-2 border border-slate-300 rounded-lg text-sm bg-white">
              <option value="">Everyone registered</option>
              <option value="due">Due, not yet issued</option>
              <option value="MMC">Qualifies: MMC points</option>
              <option value="CONF">Qualifies: participation</option>
              <option value="not">Does not qualify yet</option>
              <option value="nocouncil">Doctor or PG without a council number</option>
              <option value="issued">Issued</option>
            </select>
            <input id="cert-search" type="search" oninput="renderCertificateList()" placeholder="Search name or ID" class="sm:col-span-2 h-10 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
          </div>
          <p id="cert-count" class="text-xs text-slate-500 mb-2"></p>
          <div id="cert-list" class="border border-slate-200 rounded-xl divide-y divide-slate-100 text-sm"></div>
        </div>
      </div>

      <!-- CERTIFICATE SETTINGS: the MMC details, who earns points, the hours,
           the signatories, each certificate's wording, the design. -->
      <div id="att-view-settings" class="att-view hidden space-y-5">
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm space-y-3">
          <h3 class="text-sm font-bold text-slate-800">MMC credit points</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div><label for="cs-mmc-no" class="block text-xs font-semibold text-slate-600 mb-1">Accreditation number</label>
              <input id="cs-mmc-no" maxlength="80" class="w-full h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none"></div>
            <div><label for="cs-mmc-points" class="block text-xs font-semibold text-slate-600 mb-1">Credit points</label>
              <input id="cs-mmc-points" maxlength="20" class="w-full h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none"></div>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-600 mb-1">Categories that earn MMC points (with a council number given)</p>
            <div id="cs-categories" class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm"></div>
          </div>
          <h3 class="text-sm font-bold text-slate-800 pt-2">Attendance</h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div><label for="cs-lunch" class="block text-xs font-semibold text-slate-600 mb-1">Lunch starts</label><input id="cs-lunch" type="time" class="w-full h-10 px-2 border border-slate-300 rounded-lg text-sm"></div>
            <div><label for="cs-early" class="block text-xs font-semibold text-slate-600 mb-1">Marking opens (min before)</label><input id="cs-early" type="number" min="0" max="60" class="w-full h-10 px-2 border border-slate-300 rounded-lg text-sm"></div>
            <div class="col-span-2"><label for="cs-show-from" class="block text-xs font-semibold text-slate-600 mb-1">Delegates see their attendance from</label><input id="cs-show-from" type="date" class="w-full h-10 px-2 border border-slate-300 rounded-lg text-sm">
              <p id="cs-show-from-note" class="text-[11px] text-slate-500 mt-1"></p></div>
          </div>
          <p class="text-[11px] text-slate-500">The conference certificate needs a session before lunch and one after, on each conference day that has sessions on both sides.</p>
          <button type="button" onclick="saveCertificateSettings()" class="px-4 py-2 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Save</button>
        </div>

        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <h3 class="text-sm font-bold text-slate-800">Signatories</h3>
          <p class="text-xs text-slate-500 mb-3">A signature is a PNG (transparent background is best) or JPEG, about 600 × 200 pixels.</p>
          <div id="cs-signatories" class="space-y-3"></div>
          <form onsubmit="addSignatory(event)" class="mt-4 pt-4 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-2">
            <input id="cs-new-sig-name" placeholder="Name, e.g. Dr A. B. Sharma" maxlength="120" class="h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none">
            <input id="cs-new-sig-designation" placeholder="Designation" maxlength="160" class="h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none">
            <button type="submit" class="h-10 px-4 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Add signatory</button>
          </form>
        </div>

        <div id="cs-templates" class="space-y-5"></div>

        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
          <h3 class="text-sm font-bold text-slate-800">Design</h3>
          <p id="cs-background-state" class="text-xs text-slate-500 mt-1"></p>
          <div class="flex flex-wrap items-center gap-2 mt-3">
            <label class="px-4 py-2 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg cursor-pointer">Upload the designer's background
              <input type="file" accept="image/png,image/jpeg" class="hidden" onchange="uploadCertificateBackground(this)"></label>
            <button type="button" id="cs-background-remove" onclick="removeCertificateBackground()" class="hidden px-4 py-2 border border-slate-300 text-slate-700 font-semibold text-sm rounded-lg">Use the generated design</button>
          </div>
        </div>
      </div>
    </section>

    <!-- The camera, for signing people in one after another. -->
    <div id="modal-att-scan" class="hidden fixed inset-0 bg-slate-900/80 flex justify-center items-stretch sm:items-center p-0 sm:p-4 z-50">
      <div class="bg-white max-w-md w-full sm:rounded-2xl shadow-card flex flex-col h-full sm:h-auto">
        <div class="p-4 border-b border-slate-100 flex items-center gap-2">
          <p id="att-scan-event" class="font-bold text-slate-800 text-sm flex-1"></p>
          <button type="button" onclick="closeAttendanceScanner()" class="px-3 py-1.5 border border-slate-300 rounded-lg text-sm font-semibold text-slate-700">Done</button>
        </div>
        <div id="att-scan-reader" class="w-full bg-black flex-1 sm:flex-none sm:min-h-[18rem]"></div>
        <div id="att-scan-result" class="p-4 text-center text-sm font-semibold text-slate-600">Point the camera at a desk pass.</div>
      </div>
    </div>
