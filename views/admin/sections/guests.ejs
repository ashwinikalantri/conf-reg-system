    <!-- GUEST COORDINATION: faculty guests' travel, pickup, drop and stay.
         Opens for guests.view (the two coordinator roles and Super Admin).
         Everything here is drawn by renderGuests() from GET /api/guests;
         flags, schedules and tallies are worked out server-side in guests.js. -->
    <section id="section-faculty" class="hidden space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-slate-800">Faculty Coordination</h2>
          <p class="text-xs text-slate-500">Faculty travel, pickups, drops and stay. Figures leave out Cancelled faculty unless they say otherwise.</p>
        </div>
        <div class="flex gap-2 w-full sm:w-auto">
          <button type="button" id="guests-add-btn" onclick="openAddFaculty()" class="hidden flex-1 sm:flex-none px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl shadow-md">Add Faculty</button>
          <a href="/api/guests/export.csv" class="flex-1 sm:flex-none text-center px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-sm rounded-xl">Export CSV</a>
        </div>
      </div>

      <!-- One row that swipes sideways on a phone; wraps from tablet up. -->
      <div id="guests-subnav" role="tablist" class="flex gap-1.5 overflow-x-auto sm:flex-wrap sm:overflow-visible border-b border-slate-200 pb-2 -mx-1 px-1">
        <button type="button" data-guest-view="list" onclick="switchGuestView('list')" class="guest-subtab shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Faculty</button>
        <button type="button" data-guest-view="dashboard" onclick="switchGuestView('dashboard')" class="guest-subtab shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Dashboard</button>
        <button type="button" data-guest-view="pickups" onclick="switchGuestView('pickups')" class="guest-subtab shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Pickups</button>
        <button type="button" data-guest-view="drops" onclick="switchGuestView('drops')" class="guest-subtab shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Drops</button>
        <button type="button" data-guest-view="vehicles" onclick="switchGuestView('vehicles')" class="guest-subtab shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Vehicles</button>
        <button type="button" data-guest-view="rooms" onclick="switchGuestView('rooms')" class="guest-subtab shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Rooms</button>
        <button type="button" data-guest-view="settings" onclick="switchGuestView('settings')" id="guests-settings-tab" class="guest-subtab hidden shrink-0 whitespace-nowrap px-3 py-1.5 text-sm font-semibold rounded-lg">Lists &amp; Settings</button>
      </div>

      <div id="guests-view-list" class="guest-view">
        <!-- Filters: search full width and the selects two to a row on a
             phone; one line from tablet up. -->
        <div class="grid grid-cols-2 gap-2 mb-3 md:flex md:flex-wrap md:items-end">
          <input id="guests-search" type="search" oninput="renderGuestList()" placeholder="Search name, phone, flight/train, vehicle, room…" class="col-span-2 md:flex-1 md:min-w-[12rem] h-10 md:h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
          <select id="guests-filter-status" onchange="renderGuestList()" class="min-w-0 h-10 md:h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <select id="guests-filter-flag" onchange="renderGuestList()" class="min-w-0 h-10 md:h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white">
            <option value="">Any flag</option>
            <option value="mine">Assigned to me</option>
            <option value="attention">Needs attention (orange or red)</option>
            <option value="pickupAlert">Arriving soon, no pickup vehicle</option>
            <option value="noAccommodation">No accommodation</option>
            <option value="sharedRoom">Sharing a room</option>
            <option value="vehicleClash">Vehicle clash</option>
            <option value="notRegistered">Not registered</option>
            <option value="notSignedUp">Not signed up (no account linked)</option>
            <option value="ownStay">Arranging their own stay</option>
          </select>
          <select id="guests-filter-acc" onchange="renderGuestList()" class="min-w-0 h-10 md:h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <!-- Where they are from, as their account says (fillGuestFilters). -->
          <select id="guests-filter-institution" onchange="renderGuestList()" aria-label="Institute" class="min-w-0 md:max-w-[16rem] h-10 md:h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <select id="guests-filter-district" onchange="renderGuestList()" aria-label="District" class="min-w-0 md:max-w-[14rem] h-10 md:h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <!-- On a phone there are no column headers to sort by. -->
          <select id="guests-sort-mobile" onchange="setGuestSort(this.value)" aria-label="Sort" class="md:hidden min-w-0 h-10 px-2 border border-slate-300 rounded-lg text-sm bg-white">
            <option value="sr_no">Sort: Sr No</option>
            <option value="name">Sort: Name</option>
            <option value="arrival_at">Sort: Arrival</option>
            <option value="departure_at">Sort: Departure</option>
            <option value="accommodation">Sort: Stay</option>
            <option value="overall_status">Sort: Status</option>
          </select>
        </div>
        <!-- The colour key: always shown from tablet up, folded on a phone. -->
        <div id="guests-legend" class="hidden md:flex flex-wrap gap-1.5 mb-3 text-[11px]"></div>
        <details class="md:hidden mb-3">
          <summary class="text-xs font-semibold text-slate-500 cursor-pointer select-none">Colour key</summary>
          <div id="guests-legend-mobile" class="flex flex-wrap gap-1.5 mt-2 text-[11px]"></div>
        </details>
        <!-- A card per person on a phone; the table from tablet up. -->
        <div id="guests-cards" class="md:hidden space-y-3"></div>
        <div class="hidden md:block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
          <table class="w-full text-sm min-w-[72rem]">
            <thead id="guests-thead" class="bg-slate-50 text-[11px] text-slate-500 uppercase tracking-wide"></thead>
            <tbody id="guests-tbody" class="divide-y divide-slate-100"></tbody>
          </table>
        </div>
        <p id="guests-count" class="text-xs text-slate-500 mt-2"></p>
      </div>

      <div id="guests-view-dashboard" class="guest-view hidden"></div>
      <div id="guests-view-pickups" class="guest-view hidden"></div>
      <div id="guests-view-drops" class="guest-view hidden"></div>
      <div id="guests-view-vehicles" class="guest-view hidden"></div>
      <div id="guests-view-rooms" class="guest-view hidden"></div>
      <div id="guests-view-settings" class="guest-view hidden"></div>
    </section>
