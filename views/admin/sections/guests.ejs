    <!-- GUEST COORDINATION: faculty guests' travel, pickup, drop and stay.
         Opens for guests.view (the two coordinator roles and Super Admin).
         Everything here is drawn by renderGuests() from GET /api/guests;
         flags, schedules and tallies are worked out server-side in guests.js. -->
    <section id="section-faculty" class="hidden space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-slate-800">Faculty Coordination</h2>
          <p class="text-xs text-slate-500">Faculty travel, pickups, drops and stay. Figures leave out Cancelled faculty unless they say otherwise.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="guests-add-btn" onclick="openAddFaculty()" class="hidden px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl shadow-md">Add Faculty</button>
          <a href="/api/guests/export.csv" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-sm rounded-xl">Export CSV</a>
        </div>
      </div>

      <div id="guests-subnav" role="tablist" class="flex flex-wrap gap-1.5 border-b border-slate-200 pb-2">
        <button type="button" data-guest-view="list" onclick="switchGuestView('list')" class="guest-subtab px-3 py-1.5 text-sm font-semibold rounded-lg">Faculty</button>
        <button type="button" data-guest-view="dashboard" onclick="switchGuestView('dashboard')" class="guest-subtab px-3 py-1.5 text-sm font-semibold rounded-lg">Dashboard</button>
        <button type="button" data-guest-view="pickups" onclick="switchGuestView('pickups')" class="guest-subtab px-3 py-1.5 text-sm font-semibold rounded-lg">Pickups</button>
        <button type="button" data-guest-view="drops" onclick="switchGuestView('drops')" class="guest-subtab px-3 py-1.5 text-sm font-semibold rounded-lg">Drops</button>
        <button type="button" data-guest-view="vehicles" onclick="switchGuestView('vehicles')" class="guest-subtab px-3 py-1.5 text-sm font-semibold rounded-lg">Vehicles</button>
        <button type="button" data-guest-view="rooms" onclick="switchGuestView('rooms')" class="guest-subtab px-3 py-1.5 text-sm font-semibold rounded-lg">Rooms</button>
        <button type="button" data-guest-view="settings" onclick="switchGuestView('settings')" id="guests-settings-tab" class="guest-subtab hidden px-3 py-1.5 text-sm font-semibold rounded-lg">Lists &amp; Settings</button>
      </div>

      <div id="guests-view-list" class="guest-view">
        <div class="flex flex-wrap items-end gap-2 mb-3">
          <input id="guests-search" oninput="renderGuestList()" placeholder="Search name, phone, flight/train, vehicle, room…" class="flex-1 min-w-[12rem] h-9 px-3 border border-slate-300 rounded-lg text-sm bg-white outline-none">
          <select id="guests-filter-status" onchange="renderGuestList()" class="h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
          <select id="guests-filter-flag" onchange="renderGuestList()" class="h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white">
            <option value="">Any flag</option>
            <option value="mine">Assigned to me</option>
            <option value="attention">Needs attention (orange or red)</option>
            <option value="pickupAlert">Arriving soon, no pickup vehicle</option>
            <option value="noAccommodation">No accommodation</option>
            <option value="sharedRoom">Sharing a room</option>
            <option value="vehicleClash">Vehicle clash</option>
            <option value="notRegistered">Not registered</option>
            <option value="notSignedUp">Not signed up (no account linked)</option>
            <option value="ownStay">Arranging their own stay</option>
          </select>
          <select id="guests-filter-acc" onchange="renderGuestList()" class="h-9 px-2 border border-slate-300 rounded-lg text-sm bg-white"></select>
        </div>
        <div id="guests-legend" class="flex flex-wrap gap-1.5 mb-3 text-[11px]"></div>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
          <table class="w-full text-sm min-w-[72rem]">
            <thead id="guests-thead" class="bg-slate-50 text-[11px] text-slate-500 uppercase tracking-wide"></thead>
            <tbody id="guests-tbody" class="divide-y divide-slate-100"></tbody>
          </table>
        </div>
        <p id="guests-count" class="text-xs text-slate-500 mt-2"></p>
      </div>

      <div id="guests-view-dashboard" class="guest-view hidden"></div>
      <div id="guests-view-pickups" class="guest-view hidden"></div>
      <div id="guests-view-drops" class="guest-view hidden"></div>
      <div id="guests-view-vehicles" class="guest-view hidden"></div>
      <div id="guests-view-rooms" class="guest-view hidden"></div>
      <div id="guests-view-settings" class="guest-view hidden"></div>
    </section>
