    <!-- CONFERENCE SETUP › CERTIFICATES (certificates.manage): the MMC
         details, who earns points, the hours, the signatories, each
         certificate's wording, and the design. Shown and filled by
         loadCertificateSettingsCard() in app.js. -->
    <div id="gs-card-certificates" class="hidden space-y-5">
      <h3 class="text-lg font-bold text-slate-800">Certificate settings</h3>
      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm space-y-3">
        <h3 class="text-sm font-bold text-slate-800">MMC credit points</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div><label for="cs-mmc-no" class="block text-xs font-semibold text-slate-600 mb-1">Accreditation number</label>
            <input id="cs-mmc-no" maxlength="80" class="w-full h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none"></div>
          <div><label for="cs-mmc-points" class="block text-xs font-semibold text-slate-600 mb-1">Credit points</label>
            <input id="cs-mmc-points" maxlength="20" class="w-full h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none"></div>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-600 mb-1">Categories that earn MMC points (with a council number given)</p>
          <div id="cs-categories" class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm"></div>
        </div>
        <h3 class="text-sm font-bold text-slate-800 pt-2">Attendance</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div><label for="cs-lunch" class="block text-xs font-semibold text-slate-600 mb-1">Lunch starts</label><input id="cs-lunch" type="time" class="w-full h-10 px-2 border border-slate-300 rounded-lg text-sm"></div>
          <div><label for="cs-early" class="block text-xs font-semibold text-slate-600 mb-1">Marking opens (min before)</label><input id="cs-early" type="number" min="0" max="60" class="w-full h-10 px-2 border border-slate-300 rounded-lg text-sm"></div>
          <div class="col-span-2"><label for="cs-show-from" class="block text-xs font-semibold text-slate-600 mb-1">Delegates see their attendance from</label><input id="cs-show-from" type="date" class="w-full h-10 px-2 border border-slate-300 rounded-lg text-sm">
            <p id="cs-show-from-note" class="text-[11px] text-slate-500 mt-1"></p></div>
        </div>
        <p class="text-[11px] text-slate-500">The conference certificate needs a session before lunch and one after, on each conference day that has sessions on both sides.</p>
        <button type="button" onclick="saveCertificateSettings()" class="px-4 py-2 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Save</button>
      </div>

      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800">Signatories</h3>
        <p class="text-xs text-slate-500 mb-3">A signature is a PNG (transparent background is best) or JPEG, about 600 × 200 pixels.</p>
        <div id="cs-signatories" class="space-y-3"></div>
        <form onsubmit="addSignatory(event)" class="mt-4 pt-4 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-2">
          <input id="cs-new-sig-name" placeholder="Name, e.g. Dr A. B. Sharma" maxlength="120" class="h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none">
          <input id="cs-new-sig-designation" placeholder="Designation" maxlength="160" class="h-10 px-3 border border-slate-300 rounded-lg text-sm outline-none">
          <button type="submit" class="h-10 px-4 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg">Add signatory</button>
        </form>
      </div>

      <div id="cs-templates" class="space-y-5"></div>

      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800">Design</h3>
        <p id="cs-background-state" class="text-xs text-slate-500 mt-1"></p>
        <div class="flex flex-wrap items-center gap-2 mt-3">
          <label class="px-4 py-2 bg-navy hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg cursor-pointer">Upload the designer's background
            <input type="file" accept="image/png,image/jpeg" class="hidden" onchange="uploadCertificateBackground(this)"></label>
          <button type="button" id="cs-background-remove" onclick="removeCertificateBackground()" class="hidden px-4 py-2 border border-slate-300 text-slate-700 font-semibold text-sm rounded-lg">Use the generated design</button>
        </div>
      </div>
    </div>
