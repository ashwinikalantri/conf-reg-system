    <!-- CONFERENCE SETUP › CERTIFICATES (certificates.manage), redesigned
         20 Nov 2026: a "Ready to issue?" line; on the left the parts every
         certificate shares and each certificate with its state (a dropdown
         on a narrower screen); on the right one at a time -- a certificate's
         wording beside the certificate as it will print. Drawn by
         renderCertificateSettings() in app.js. -->
    <div id="gs-card-certificates" class="hidden space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-lg font-bold text-slate-800">Certificates</h3>
          <p class="text-sm text-slate-600">What each certificate says, who signs it, and how it looks. Issuing is on the Certificates list.</p>
        </div>
        <button type="button" onclick="selectSettingsTab('certificates')" class="h-10 px-4 rounded-lg border border-slate-300 bg-white text-sm font-semibold text-navy hover:bg-slate-50">Go to the Certificates list →</button>
      </div>

      <!-- Ready to issue? Each check opens its part. -->
      <section id="cs-ready" class="bg-white rounded-2xl border border-slate-200 p-3 sm:p-4 flex flex-wrap items-center gap-x-2.5 gap-y-2"></section>

      <div class="grid grid-cols-1 xl:grid-cols-[15rem_minmax(0,1fr)] gap-4 items-start">
        <nav id="cs-rail" aria-label="Certificate settings" class="hidden xl:block bg-white rounded-2xl border border-slate-200 p-2 xl:sticky xl:top-4"></nav>
        <label class="xl:hidden block">
          <span class="block text-xs font-semibold text-slate-600 mb-1">Showing</span>
          <select id="cs-rail-select" onchange="setCsView(this.value)" class="w-full h-11 px-3 border border-slate-300 rounded-xl text-[15px] bg-white"></select>
        </label>
        <div id="cs-pane" class="min-w-0"></div>
      </div>
    </div>
