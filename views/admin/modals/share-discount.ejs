  <!-- MODAL: SHARE DISCOUNT CODE -->
  <div id="modal-share-discount" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-md w-full rounded-2xl p-6 shadow-card relative">
      <button onclick="closeModal('modal-share-discount')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Share Discount Code</h3>
      <p id="share-discount-code" class="text-xs text-slate-500 mb-4 font-mono font-bold"></p>

      <label class="block text-xs font-semibold text-slate-700 mb-1">WhatsApp message</label>
      <textarea id="share-whatsapp-text" readonly rows="8" class="w-full p-2.5 border rounded-lg text-sm outline-none font-mono bg-slate-50"></textarea>
      <div class="flex gap-2 mt-2">
        <button type="button" onclick="copyShareWhatsappText()" class="flex-1 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-lg shadow-md">📋 Copy Message</button>
        <a id="share-whatsapp-link" href="#" target="_blank" rel="noopener" class="flex-1 text-center px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-sm rounded-lg shadow-md">Open in WhatsApp</a>
      </div>

      <div class="border-t mt-4 pt-4">
        <a id="share-pdf-link" href="#" target="_blank" rel="noopener" class="block text-center w-full px-4 py-2 border border-indigo-300 text-indigo-700 hover:bg-indigo-50 font-semibold text-sm rounded-lg">📄 Open Printable Voucher (Save as PDF)</a>
      </div>

      <div class="border-t mt-4 pt-4">
        <label class="block text-xs font-semibold text-slate-700 mb-1">Email this code</label>
        <form onsubmit="handleEmailShareDiscount(event)" class="flex gap-2">
          <input id="share-email-address" type="email" required placeholder="name@example.com" class="flex-1 p-2.5 border rounded-lg text-sm outline-none">
          <button type="submit" id="share-email-btn" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md whitespace-nowrap">✉️ Send</button>
        </form>
      </div>
    </div>
  </div>
