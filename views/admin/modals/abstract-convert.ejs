  <!-- MODAL: CONVERT PDF ABSTRACT TO STRUCTURED FORMAT -->
  <!-- One-time migration tool for the abstracts submitted before structured
       fields existed. The auto-split (server-side, best-effort -- see
       splitAbstractText) pre-fills the five sections below from the raw PDF
       text shown alongside for comparison; nothing is written to the
       database until Commit is clicked, so a wrong guess costs nothing. -->
  <div id="modal-abstract-convert" class="hidden fixed inset-0 bg-slate-900/70 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-5xl w-full rounded-2xl p-5 shadow-2xl relative h-[90vh] flex flex-col">
      <button onclick="closeModal('modal-abstract-convert')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 id="abstract-convert-title" class="text-lg font-bold text-slate-800 mb-1 pr-8">Convert Abstract</h3>
      <p class="text-xs text-slate-500 mb-3">Auto-split from the PDF text on the left -- a best-effort guess, not a parser. Check each section against the raw text and correct anything wrong before committing.</p>

      <div id="abstract-convert-body" class="flex-1 min-h-0 grid grid-cols-1 lg:grid-cols-2 gap-4 overflow-hidden">
        <div class="min-h-0 flex flex-col">
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wide mb-1">Raw PDF text</p>
          <pre id="abstract-convert-rawtext" class="flex-1 min-h-0 overflow-y-auto p-3 bg-slate-50 border border-slate-200 rounded-lg text-[11px] text-slate-600 whitespace-pre-wrap"></pre>
        </div>

        <div class="min-h-0 overflow-y-auto pr-1 space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700">Background</label>
            <textarea id="abstract-convert-background" rows="3" oninput="updateAbstractConvertWordCount()" class="w-full mt-1 p-2 border rounded-lg outline-none text-sm"></textarea>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">Aim</label>
            <textarea id="abstract-convert-aim" rows="2" oninput="updateAbstractConvertWordCount()" class="w-full mt-1 p-2 border rounded-lg outline-none text-sm"></textarea>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">Methods</label>
            <textarea id="abstract-convert-methods" rows="3" oninput="updateAbstractConvertWordCount()" class="w-full mt-1 p-2 border rounded-lg outline-none text-sm"></textarea>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">Results</label>
            <textarea id="abstract-convert-results" rows="3" oninput="updateAbstractConvertWordCount()" class="w-full mt-1 p-2 border rounded-lg outline-none text-sm"></textarea>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">Conclusion</label>
            <textarea id="abstract-convert-conclusion" rows="2" oninput="updateAbstractConvertWordCount()" class="w-full mt-1 p-2 border rounded-lg outline-none text-sm"></textarea>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700">Keywords <span class="text-[10px] text-slate-400">(comma-separated)</span></label>
            <input type="text" id="abstract-convert-keywords" class="w-full mt-1 p-2 border rounded-lg outline-none text-sm">
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100 shrink-0">
        <span id="abstract-convert-wordcount" class="text-xs font-semibold text-slate-500">0 / 400 words</span>
        <button type="button" id="abstract-convert-commit-btn" onclick="submitAbstractConvert()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg text-sm disabled:opacity-50 disabled:cursor-not-allowed">Commit to Database</button>
      </div>
    </div>
  </div>
