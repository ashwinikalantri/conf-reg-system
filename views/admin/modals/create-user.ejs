  <!-- MODAL: CREATE USER -->
  <div id="modal-create-user" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-md w-full rounded-2xl p-6 shadow-card relative">
      <button onclick="closeModal('modal-create-user')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Create Staff User & Assign Role</h3>

      <form onsubmit="handleCreateUserSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Full Name</label>
          <input type="text" id="new-user-name" required class="w-full p-2.5 border rounded-lg text-sm outline-none">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Mobile Number (+91)</label>
          <input type="tel" id="new-user-phone" maxlength="10" required class="w-full p-2.5 border rounded-lg text-sm font-mono outline-none">
        </div>
        <div>
          <!-- Required on every account-creating path: it's how receipts and
               notifications reach them. Recorded unverified -- an admin
               typing it in isn't proof, so they still verify it themselves
               before it can receive a login code. -->
          <label class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
          <input type="email" id="new-user-email" required placeholder="them@example.com" class="w-full p-2.5 border rounded-lg text-sm outline-none">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Designation</label>
            <input type="text" id="new-user-designation" placeholder="e.g. Finance Officer" required class="w-full p-2.5 border rounded-lg text-sm outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Institution</label>
            <input type="text" id="new-user-institute" placeholder="e.g. Host Institution" required class="w-full p-2.5 border rounded-lg text-sm outline-none">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Password <span class="text-slate-400 font-normal">(optional, at least 8 characters)</span></label>
          <input type="password" id="new-user-password" autocomplete="new-password" placeholder="Leave blank -- they can sign in by OTP, or set one themselves later" class="w-full p-2.5 border rounded-lg text-sm outline-none">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Assign Administrative Role</label>
          <select id="new-user-role" required class="w-full p-2.5 border rounded-lg text-sm bg-white outline-none">
            <option value="FINANCE_ADMIN">Finance Admin (Payment Reconciliation Only)</option>
            <option value="ACADEMIC_REVIEWER">Academic Reviewer (Abstract Desk Only)</option>
            <option value="FINANCE_ACADEMIC">Finance &amp; Academic Reviewer (Payments + Abstracts)</option>
            <option value="OPERATIONS">Operations (Reports + User & Role Management)</option>
            <option value="SUPER_ADMIN">Super Admin (Full Backend Access & User Management)</option>
            <option value="DELEGATE">Delegate (Standard Attendee Access)</option>
          </select>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeModal('modal-create-user')" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold shadow-md">Create User</button>
        </div>
      </form>
    </div>
  </div>
