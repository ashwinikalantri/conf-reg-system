  <!-- MODAL: ONE-TIME PASSWORD
       Shown after a staff-initiated password reset, from either the Front
       Desk or Users & Roles. The value exists only in this response: it is
       stored as a scrypt hash and never logged, so there is no way to look it
       up again. That is why this is a panel that waits to be dismissed rather
       than a toast -- somebody is reading it out or writing it down. -->
  <div id="modal-temp-password" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white rounded-2xl shadow-card w-full max-w-md p-6">
      <h3 class="text-lg font-bold text-slate-800">One-time password</h3>
      <p id="temp-password-who" class="text-xs text-slate-500 mb-4"></p>

      <div id="temp-password-box" class="rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-5 text-center">
        <p id="temp-password-value" class="font-mono text-2xl font-bold tracking-[0.2em] text-indigo-800 select-all break-all"></p>
      </div>

      <p class="text-[11px] text-slate-500 mt-3">
        Read this out or write it down now — it cannot be shown again. The delegate
        signs in with it once and must then choose their own password; this one stops
        working as soon as they do.
      </p>

      <div class="flex justify-end mt-5">
        <button type="button" onclick="closeTempPassword()"
                class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold">Done</button>
      </div>
    </div>
  </div>
