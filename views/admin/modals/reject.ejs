  <!-- MODAL: REJECT WITH REASON (opened from within the payment review modal,
       which stays open underneath -- so it needs a z-index above modal-review's
       z-50, or it renders behind it since it appears earlier in the DOM). -->
  <div id="modal-reject" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-[60]">
    <div class="bg-white max-w-sm w-full rounded-2xl p-6 shadow-card relative">
      <button onclick="closeModal('modal-reject')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 class="text-lg font-bold text-slate-800 mb-3">Reject Submission</h3>
      <label class="block text-xs font-semibold text-slate-700 mb-1">Reason</label>
      <select id="reject-reason" onchange="toggleRejectNote()" class="w-full p-2.5 border rounded-lg text-sm bg-white outline-none">
        <option value="WRONG_DETAILS">Wrong payment details entered</option>
        <option value="WRONG_SCREENSHOT">Wrong screenshot attached</option>
        <option value="WRONG_CATEGORY">Wrong category selected</option>
        <option value="ID_DISCREPANCY">Student ID discrepancy</option>
        <option value="OTHER">Other</option>
      </select>

      <div id="reject-note-wrap" class="hidden mt-3">
        <label class="block text-xs font-semibold text-slate-700 mb-1">Details</label>
        <textarea id="reject-note" rows="3" class="w-full p-2.5 border rounded-lg text-sm outline-none" placeholder="Describe the reason…"></textarea>
      </div>
      <div class="flex justify-end gap-2 pt-5">
        <button type="button" onclick="closeModal('modal-reject')" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Cancel</button>
        <button type="button" id="reject-submit-btn" onclick="submitReject()" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-semibold shadow-md">Reject</button>
      </div>
    </div>
  </div>
