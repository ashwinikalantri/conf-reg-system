  <!-- MODAL: REVIEW ABSTRACT (redesigned 19 Nov 2026). The abstract's text
       first; its authors, registration and history in a strip beside it;
       Previous / Next through the list it was opened from; and the decision
       fixed at the foot -- Approve & next first, Reject only under More, and
       asking first. openAbstractReview() fills it; the actions read the
       abstract's id from #abstract-review-modal-actions' data-id. Full screen
       on a phone. -->
  <div id="modal-abstract-review" class="hidden fixed inset-0 bg-slate-900/70 flex justify-center items-stretch sm:items-center sm:p-4 z-50">
    <div class="bg-white w-full max-w-5xl sm:rounded-2xl shadow-card flex flex-col h-full sm:h-[90vh] overflow-hidden">
      <div class="flex items-center gap-2 px-4 sm:px-6 py-2.5 border-b border-slate-200">
        <button type="button" id="abstract-review-prev" onclick="stepAbstractReview(-1)" class="h-10 px-3 rounded-lg border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40" aria-label="Previous abstract">← <span class="hidden sm:inline">Previous</span></button>
        <span id="abstract-review-position" class="text-sm text-slate-600 tabular-nums"></span>
        <button type="button" id="abstract-review-next" onclick="stepAbstractReview(1)" class="h-10 px-3 rounded-lg border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40" aria-label="Next abstract"><span class="hidden sm:inline">Next</span> →</button>
        <button type="button" onclick="closeModal('modal-abstract-review')" aria-label="Close" class="ml-auto w-10 h-10 rounded-lg text-slate-500 hover:bg-slate-100 text-xl font-bold">✕</button>
      </div>

      <div class="flex-1 overflow-y-auto lg:grid lg:grid-cols-[minmax(0,1fr)_17rem]">
        <article class="px-4 sm:px-8 py-5 sm:py-6 lg:border-r lg:border-slate-100 min-w-0">
          <p id="abstract-review-meta" class="text-[13px] text-slate-500 tabular-nums"></p>
          <h3 id="abstract-review-modal-title" class="text-xl sm:text-2xl font-bold text-navy leading-tight mt-1 break-words">Abstract</h3>
          <div id="abstract-review-modal-body" class="mt-4"></div>
        </article>
        <aside id="abstract-review-side" class="px-4 sm:px-6 py-5 sm:py-6 bg-slate-50 space-y-5 border-t lg:border-t-0 border-slate-100"></aside>
      </div>

      <!-- Note is required server-side (see PUT /api/abstracts/:id/status) --
           the delegate has no idea what to fix without it. -->
      <div id="abstract-revision-box" class="hidden px-4 sm:px-6 py-3 border-t border-slate-200 bg-orange-50/60">
        <label class="block text-sm font-semibold text-slate-800 mb-1">What needs to be corrected? <span class="font-normal text-slate-500">(sent to the delegate by email)</span></label>
        <textarea id="abstract-revision-note" rows="3" placeholder="e.g. Please clarify the sample size in Methods, and shorten Background to fit the word limit." class="w-full p-2.5 border border-slate-300 rounded-lg outline-none text-sm resize-none bg-white"></textarea>
        <div class="flex flex-wrap items-end gap-2 mt-2">
          <label class="block text-sm font-semibold text-slate-800">Last date to send the corrections
            <input id="abstract-revision-until" type="date" class="mt-1 block h-10 px-2.5 border border-slate-300 rounded-lg text-sm outline-none bg-white"></label>
          <button type="button" onclick="toggleAbstractRevisionBox()" class="ml-auto h-10 px-3 border border-slate-300 text-slate-700 hover:bg-white font-semibold rounded-lg text-sm">Cancel</button>
          <button type="button" onclick="submitAbstractRevisionRequest()" class="h-10 px-4 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-lg text-sm">Send &amp; notify the delegate</button>
        </div>
      </div>

      <!-- Ask to complete: the author fills in what is missing (results
           awaited, say) by a date; the status stays as it is -- an accepted
           abstract stays accepted. PUT /api/abstracts/:id/completion. -->
      <div id="abstract-complete-box" class="hidden px-4 sm:px-6 py-3 border-t border-slate-200 bg-indigo-50/60">
        <label class="block text-sm font-semibold text-slate-800 mb-1">What should the author complete? <span class="font-normal text-slate-500">(sent to the delegate by email; the abstract keeps its status)</span></label>
        <textarea id="abstract-complete-note" rows="3" placeholder="e.g. Your Results say the data are awaited. Please add your results and update the Conclusion." class="w-full p-2.5 border border-slate-300 rounded-lg outline-none text-sm resize-none bg-white"></textarea>
        <div class="flex flex-wrap items-end gap-2 mt-2">
          <label class="block text-sm font-semibold text-slate-800">Last date to complete it
            <input id="abstract-complete-until" type="date" class="mt-1 block h-10 px-2.5 border border-slate-300 rounded-lg text-sm outline-none bg-white"></label>
          <button type="button" onclick="toggleAbstractCompleteBox()" class="ml-auto h-10 px-3 border border-slate-300 text-slate-700 hover:bg-white font-semibold rounded-lg text-sm">Cancel</button>
          <button type="button" onclick="submitAbstractCompleteRequest()" class="h-10 px-4 bg-navy hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm">Send &amp; notify the delegate</button>
        </div>
      </div>

      <!-- The decision, always in reach: drawn by drawAbstractReviewActions()
           for the abstract's status and the viewer's permissions. -->
      <div id="abstract-review-modal-actions" class="flex flex-wrap items-center gap-2 px-4 sm:px-6 py-3 border-t border-slate-200 bg-white"></div>
    </div>
  </div>
