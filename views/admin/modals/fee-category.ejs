  <!-- MODAL: EDIT A FEE CATEGORY
       Everything about a category is edited here rather than inline in the
       table. The row used to carry live text and number inputs, which made a
       stray keystroke enough to change a fee -- or, once labels became
       editable, to rename every registration in the category on the next
       Save. The table is now read-only and this is the one way in. -->
  <div id="modal-fee-category" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-lg w-full rounded-2xl p-6 shadow-card relative max-h-[90vh] overflow-y-auto">
      <button onclick="closeModal('modal-fee-category')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Edit category</h3>
      <!-- The key is identity, not presentation: registrations,
           group_discount_rules and promo-code scopes all join on it. -->
      <p class="text-xs text-slate-500 mb-4">Key <span id="fc-key" class="font-mono text-slate-600"></span> — fixed, because registrations and discount rules refer to it.</p>

      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Label</label>
          <input id="fc-label" type="text" class="w-full p-2.5 border rounded-lg text-sm outline-none">
          <p id="fc-rename-note" class="hidden text-[11px] text-amber-800 mt-1"></p>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Subtitle <span class="text-slate-400 font-normal">(optional)</span></label>
          <input id="fc-subtitle" type="text" class="w-full p-2.5 border rounded-lg text-sm outline-none">
        </div>

        <div>
          <p class="block text-xs font-semibold text-slate-700 mb-1">Fees by pricing phase</p>
          <div class="grid grid-cols-4 gap-2">
            <div>
              <label class="block text-[10px] text-slate-500 mb-0.5">Early ₹</label>
              <input id="fc-early" type="number" min="0" class="w-full p-2 border rounded-lg text-sm outline-none">
            </div>
            <div>
              <label class="block text-[10px] text-slate-500 mb-0.5">Regular ₹</label>
              <input id="fc-regular" type="number" min="0" class="w-full p-2 border rounded-lg text-sm outline-none">
            </div>
            <div>
              <label class="block text-[10px] text-slate-500 mb-0.5">Late ₹</label>
              <input id="fc-late" type="number" min="0" class="w-full p-2 border rounded-lg text-sm outline-none">
            </div>
            <div>
              <label class="block text-[10px] text-slate-500 mb-0.5">Spot ₹</label>
              <input id="fc-spot" type="number" min="0" class="w-full p-2 border rounded-lg text-sm outline-none">
            </div>
          </div>
        </div>

        <label class="flex items-center gap-2 text-sm text-slate-700">
          <input id="fc-studentid" type="checkbox" class="rounded">
          Requires a student ID card
        </label>

        <label class="flex items-center gap-2 text-sm text-slate-700">
          <input id="fc-active" type="checkbox" class="rounded">
          Active — delegates can choose this category
        </label>

        <!-- Only when registrations still carry an older name for this
             category. Applies the SAVED label, so it is offered separately
             from the rename above rather than folded into Save. -->
        <div id="fc-drift" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-3">
          <p id="fc-drift-msg" class="text-xs text-amber-900"></p>
          <button type="button" id="fc-realign-btn" class="mt-1.5 text-[11px] text-indigo-700 hover:underline font-semibold">Realign them to the saved label</button>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-5">
        <button type="button" onclick="closeModal('modal-fee-category')" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Cancel</button>
        <button type="button" id="fc-save-btn" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white rounded-xl text-xs font-semibold shadow-md">Save changes</button>
      </div>

      <!-- Deleting is refused server-side once anything references the
           category (409, see the DELETE route). The button says so up front
           instead of letting the press fail. -->
      <div class="mt-5 pt-4 border-t border-slate-200">
        <div class="flex items-center justify-between gap-3">
          <p id="fc-delete-note" class="text-[11px] text-slate-500"></p>
          <button type="button" id="fc-delete-btn" class="shrink-0 px-3 py-1.5 bg-rose-600 hover:bg-rose-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white text-xs font-semibold rounded-lg">Delete</button>
        </div>
      </div>
    </div>
  </div>
