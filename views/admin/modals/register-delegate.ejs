  <!-- MODAL: REGISTER DELEGATE (admin-initiated, at the desk) -->
  <!-- See POST /api/admin/registrations. Two states in one modal: the form
       (#register-delegate-form) and a success panel
       (#register-delegate-result) showing the registration number and, if
       one was issued, a temporary password -- shown once, never persisted
       in plaintext anywhere, so this is the only place an admin can read it
       back to hand to the delegate. -->
  <div id="modal-register-delegate" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-2 sm:p-4 z-50">
    <div class="bg-white max-w-lg w-full rounded-2xl shadow-card relative max-h-[95vh] flex flex-col">
      <button onclick="closeModal('modal-register-delegate')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold z-10">✕</button>

      <div class="p-6 pb-0 shrink-0">
        <h3 class="text-lg font-bold text-slate-800 mb-1">Register Delegate</h3>
        <p id="register-delegate-subtitle" class="text-xs text-slate-500">For a delegate registering in person at the desk — payment is recorded as already received, not left pending review.</p>
      </div>

      <form id="register-delegate-form" onsubmit="handleRegisterDelegateSubmit(event)" class="flex-1 min-h-0 overflow-y-auto p-6 pt-4 space-y-4">
        <!-- Registering on behalf of someone who already signed up: pick their
             account so the registration joins it, instead of retyping details
             that could only ever match by mobile number (and never matched a
             delegate who signed up by email). See GET /api/desk/signups. -->
        <div id="rd-link-wrap" class="bg-indigo-50/60 border border-indigo-100 rounded-xl p-3">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Already signed up? <span class="text-slate-400 font-normal">(find their account)</span></label>
          <div id="rd-link-search-wrap" class="relative">
            <input type="text" id="rd-link-search" autocomplete="off" oninput="searchRegisterDelegateSignups(this.value)" placeholder="Their name, mobile or email" class="w-full p-2.5 border rounded-lg text-sm bg-white outline-none">
            <div id="rd-link-results" class="hidden absolute z-20 left-0 right-0 mt-1 bg-white border border-slate-200 rounded-lg shadow-lg max-h-56 overflow-y-auto divide-y divide-slate-100"></div>
          </div>
          <div id="rd-linked" class="hidden flex items-center justify-between gap-2">
            <div class="min-w-0">
              <p class="text-[11px] text-indigo-700 font-semibold uppercase tracking-wide">Registering for their existing account</p>
              <p class="text-sm font-bold text-slate-800 truncate" id="rd-linked-name"></p>
              <p class="text-[11px] text-slate-500 truncate" id="rd-linked-contact"></p>
            </div>
            <button type="button" onclick="unlinkRegisterDelegateAccount()" class="shrink-0 px-3 py-1.5 border border-slate-300 hover:bg-white text-slate-700 text-xs font-semibold rounded-lg">Change</button>
          </div>
          <p id="rd-link-hint" class="text-[11px] text-slate-500 mt-1">Leave blank for someone new — a new account is created from the details below.</p>
        </div>

        <div id="rd-phone-wrap">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Mobile Number (+91)</label>
          <input type="tel" id="rd-phone" maxlength="10" required autocomplete="off" class="w-full p-2.5 border rounded-lg text-sm font-mono outline-none">
        </div>

        <div id="rd-name-fields">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Full Name</label>
            <input type="text" id="rd-name" required class="w-full p-2.5 border rounded-lg text-sm outline-none">
            <p class="text-[11px] text-slate-400 mt-1">If this number already has an account, its existing name is used instead — this is only for a brand-new delegate.</p>
          </div>
          <div class="mt-3">
            <!-- Required for a new account: a walk-in is confirmed on the
                 spot and their receipt has nowhere to go without one. An
                 existing account's address is reused, so this can be left
                 blank for someone already on file. -->
            <label class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
            <input type="email" id="rd-email" placeholder="them@example.com" class="w-full p-2.5 border rounded-lg text-sm outline-none">
            <p class="text-[11px] text-slate-400 mt-1">Leave blank only if this number already has an account with an email on file.</p>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Designation <span class="text-slate-400 font-normal">(optional)</span></label>
              <input type="text" id="rd-designation" class="w-full p-2.5 border rounded-lg text-sm outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Institution <span class="text-slate-400 font-normal">(optional)</span></label>
              <input type="text" id="rd-institute" class="w-full p-2.5 border rounded-lg text-sm outline-none">
            </div>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Delegate Category</label>
          <select id="rd-category" required onchange="onRegisterDelegateCategoryChange()" class="w-full p-2.5 border rounded-lg text-sm bg-white outline-none">
            <option value="">-- Select Category --</option>
          </select>
        </div>

        <!-- Student ID: eyes-on-the-physical-card at the desk, instead of the
             photo upload the self-service form asks for. Either way an
             approver confirms the card by eye -- see
             categoryRequiresStudentId/needsId in POST /api/admin/registrations. -->
        <div id="rd-idverify-wrap" class="hidden bg-amber-50 border border-amber-200 rounded-lg p-3">
          <label class="flex items-start gap-2 text-xs text-slate-700 cursor-pointer">
            <input type="checkbox" id="rd-idverify-checkbox" class="mt-0.5 shrink-0">
            <span>I have checked this delegate's physical student ID card and confirm it matches the selected category.</span>
          </label>
        </div>

        <div id="rd-program-groups" class="space-y-3"></div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Promo Code <span class="text-slate-400 font-normal">(optional)</span></label>
          <input type="text" id="rd-discount-code" placeholder="Leave blank if none" class="w-full p-2.5 border rounded-lg text-sm outline-none uppercase font-mono">
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wide">Fee Due</span>
            <span id="rd-fee-display" class="text-xl font-extrabold text-indigo-600">₹0</span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Payment Method</label>
            <div class="flex gap-1.5 bg-slate-100 rounded-lg p-1 text-xs font-semibold">
              <button type="button" id="rd-mode-cash-btn" onclick="setRegisterDelegateMode('CASH')" class="flex-1 py-2 rounded-md bg-white text-indigo-700 shadow-sm">Cash / At Desk</button>
              <button type="button" id="rd-mode-bank-btn" onclick="setRegisterDelegateMode('BANK_TRANSFER')" class="flex-1 py-2 rounded-md text-slate-500">Existing Bank Transfer</button>
            </div>
          </div>

          <div id="rd-mode-cash" class="space-y-2">
            <label class="block text-xs font-semibold text-slate-700 mb-1">Amount Received (₹)</label>
            <input type="number" id="rd-cash-amount" min="0" step="0.01" oninput="onRegisterDelegateCashInput()" class="w-full p-2.5 border rounded-lg text-sm outline-none">
            <!-- Who physically took the notes, which is not necessarily whose
                 login is open: one desk laptop is worked by several people in
                 a shift, and the float is handed over by a named person at
                 the end of it. Required by the server for CASH, not just
                 asked for here -- see resolveCashCollector. -->
            <label class="block text-xs font-semibold text-slate-700 mb-1 pt-1">Cash Collected By</label>
            <select id="rd-cash-collected-by" class="w-full p-2.5 border rounded-lg text-sm outline-none"></select>
          </div>

          <div id="rd-mode-bank" class="hidden space-y-2">
            <div class="flex items-center justify-between">
              <p class="text-[11px] text-slate-500">Pick the credit this delegate already paid — nearest to the fee due is listed first.</p>
              <button type="button" id="rd-bank-linklater-toggle" onclick="setRegisterDelegateBankLinkLater(true)" class="shrink-0 text-[11px] font-semibold text-indigo-600 hover:underline">Can't find it? Link later</button>
            </div>
            <div id="rd-bank-linknow-section">
              <div id="rd-bank-candidates" class="divide-y divide-slate-100 border border-slate-200 rounded-lg max-h-40 overflow-y-auto bg-white"></div>
              <div id="rd-bank-selected" class="hidden bg-emerald-50 border border-emerald-200 rounded-lg p-2 text-xs text-emerald-800 mt-2"></div>
            </div>
            <!-- Deferred link: the delegate says they've paid, but the credit
                 isn't in the imported statement yet. The registration still
                 goes through today (bank_status PENDING); an admin links the
                 real transaction later via the normal Review flow once it
                 shows up -- see POST /api/admin/registrations' linkLater. -->
            <div id="rd-bank-linklater-section" class="hidden space-y-2 bg-amber-50 border border-amber-200 rounded-lg p-3">
              <p class="text-[11px] text-amber-800">The registration will be created now; the payment will show as <b>pending</b> until an admin links it to the actual bank transaction once it's imported.</p>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Amount Claimed (₹)</label>
                <input type="number" id="rd-bank-linklater-amount" min="0" step="0.01" class="w-full p-2.5 border rounded-lg text-sm outline-none">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">UTR / Reference Number <span class="text-slate-400 font-normal">(optional, helps auto-link later)</span></label>
                <input type="text" id="rd-bank-linklater-ref" class="w-full p-2.5 border rounded-lg text-sm outline-none font-mono">
              </div>
              <button type="button" onclick="setRegisterDelegateBankLinkLater(false)" class="text-[11px] font-semibold text-indigo-600 hover:underline">← Back to picking a credit now</button>
            </div>
          </div>

          <p id="rd-partial-note" class="hidden text-[11px] text-orange-700 font-semibold">Amount is less than the fee due — this will be recorded as a partial payment, with the balance still owed.</p>
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" onclick="closeModal('modal-register-delegate')" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Cancel</button>
          <button type="submit" id="rd-submit-btn" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed text-white rounded-xl text-xs font-semibold shadow-md">Register &amp; Record Payment</button>
        </div>
      </form>

      <div id="register-delegate-result" class="hidden flex-1 min-h-0 overflow-y-auto p-6 space-y-4">
        <div id="rd-result-banner" class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
          <p id="rd-result-icon" class="flex justify-center text-emerald-600"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-9 h-9"><circle cx="12" cy="12" r="9"/><path d="M8 12.5 L11 15.5 L16 9"/></svg></p>
          <p id="rd-result-heading" class="font-bold text-emerald-800 mt-1">Registration confirmed</p>
          <p class="text-xs font-mono text-slate-600 mt-1" id="rd-result-regno"></p>
          <p class="text-xs text-slate-600 mt-2" id="rd-result-amount"></p>
        </div>
        <div id="rd-result-password-box" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-4">
          <p class="text-xs font-bold text-amber-800 uppercase tracking-wide">Temporary Password</p>
          <p class="text-[11px] text-amber-700 mt-0.5">Share this with the delegate now — it won't be shown again. They should change it via Set Password after logging in.</p>
          <p id="rd-result-password" class="text-2xl font-mono font-black text-amber-900 tracking-widest text-center mt-2 select-all"></p>
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" onclick="closeModal('modal-register-delegate')" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Close</button>
          <button type="button" onclick="resetRegisterDelegateForm()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold shadow-md">Register Another</button>
        </div>
      </div>
    </div>
  </div>
