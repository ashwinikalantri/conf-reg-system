  <!-- MODAL: CHANGE A DISCOUNT CODE'S VALIDITY. Usually to extend it -- a code
       is valid through its last date (IST), and an expired one can be given
       a new date here rather than re-issued under a new code. Saved through
       PUT /api/admin/discount-codes/:id, which refuses a date already gone
       (Deactivate stops a code now). See openDiscountValidityModal(). -->
  <div id="modal-discount-validity" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-md w-full rounded-2xl p-6 shadow-card relative">
      <button onclick="closeModal('modal-discount-validity')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Change Validity</h3>
      <p id="validity-code" class="text-xs text-slate-500 mb-1 font-mono font-bold"></p>
      <p id="validity-current" class="text-xs text-slate-500 mb-4"></p>

      <form onsubmit="saveDiscountValidity(event)" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Valid through</label>
          <input id="validity-date" type="date" class="w-full p-2.5 border rounded-lg text-sm outline-none">
          <div class="flex flex-wrap gap-2 mt-2">
            <button type="button" onclick="extendDiscountValidityBy(7)" class="px-3 py-1.5 border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg">+1 week</button>
            <button type="button" onclick="extendDiscountValidityBy(30)" class="px-3 py-1.5 border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg">+1 month</button>
            <button type="button" id="validity-until-conference" onclick="extendDiscountValidityToConference()" class="hidden px-3 py-1.5 border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg">Until the conference starts</button>
          </div>
          <p class="text-[11px] text-slate-400 mt-1">The code works through the end of this day (IST).</p>
        </div>
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <input type="checkbox" id="validity-no-expiry" onchange="onDiscountNoExpiryChange()"> No expiry date
        </label>
        <div class="flex gap-2 pt-1">
          <button type="button" onclick="closeModal('modal-discount-validity')" class="flex-1 px-4 py-2 border border-slate-300 text-slate-700 font-semibold text-sm rounded-lg">Cancel</button>
          <button type="submit" id="validity-save-btn" class="flex-1 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg shadow-md">Save</button>
        </div>
      </form>
    </div>
  </div>
