  <!-- MODAL: CONFIRM (replaces native confirm(), which browsers can suppress) -->
  <div id="modal-confirm" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-[60]">
    <div class="bg-white max-w-sm w-full rounded-2xl p-6 shadow-2xl">
      <p id="confirm-message" class="text-sm text-slate-700 whitespace-pre-line"></p>
      <div class="flex justify-end gap-2 pt-5">
        <button id="confirm-cancel" type="button" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Cancel</button>
        <button id="confirm-ok" type="button" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold shadow-md">Confirm</button>
      </div>
    </div>
  </div>
