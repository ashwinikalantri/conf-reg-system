  <!-- MODAL: CHANGE PROGRAM-GROUP ENROLLMENT (any group, not just Workshops/QI) -->
  <div id="modal-program-change" class="hidden fixed inset-0 bg-slate-900/60 flex justify-center items-center p-4 z-50">
    <div class="bg-white max-w-sm w-full rounded-2xl p-6 shadow-2xl relative">
      <button onclick="closeModal('modal-program-change')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
      <h3 id="program-change-title" class="text-lg font-bold text-slate-800 mb-1">Change Option</h3>
      <p id="program-change-subtitle" class="text-xs text-slate-500 mb-4"></p>

      <label class="block text-xs font-semibold text-slate-700 mb-1">Select option</label>
      <select id="program-change-select" class="w-full p-2.5 border rounded-lg text-sm bg-white outline-none">
        <option value="">— None —</option>
      </select>

      <div class="flex justify-end gap-2 pt-5">
        <button type="button" onclick="closeModal('modal-program-change')" class="px-4 py-2 border rounded-xl text-xs font-semibold text-slate-600">Cancel</button>
        <button type="button" id="program-change-save-btn" onclick="saveProgramChange()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white rounded-xl text-xs font-semibold shadow-md">Save</button>
      </div>
    </div>
  </div>
