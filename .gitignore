# Dependencies
node_modules/

# Database — contains delegate PII (phone numbers, UTRs, payment screenshots).
# Never commit. Keep backups outside the repo.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.bak-*
*.bak

# Uploaded payment screenshots (once moved off base64-in-DB)
uploads/

# Bank statement files (sensitive financial data) — uploaded copies and any
# statement the user drops in for reconciliation.
docs/
bank-statements/

# OCR language model cache (downloaded at runtime by tesseract.js)
.ocr-cache/
*.traineddata

# Secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS junk
.DS_Store
.Rhistory
.Rapp.history
.vscode/
.idea/
*.swp

# Local DB snapshots taken before risky migrations (PII; see note above)
backups/
